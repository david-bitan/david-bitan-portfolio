---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import { allProjects } from '../../data/allProjects';
import { cld, LANDSCAPE, FIT_TALL, isMobileShot } from '../../lib/cloudinary';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — David Bitan`}>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-20 sm:pt-20" data-reveal>
		<a href="/#work" class="text-sm font-semibold text-accent hover:underline">← Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.shortDesc}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Client</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		<div class="mt-6 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-pill bg-card px-3 py-1 text-xs font-medium text-muted">{tag}</span>
				))
			}
		</div>

		<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed text-ink">{project.fullDesc}</p>
	</article>

	<section class="mx-auto max-w-[1200px] px-6 pb-24" data-reveal>
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				project.gallery.map((url, i) =>
					isMobileShot(url) ? (
						// Tall phone screenshots: fit whole shot, never crop or upscale it
						// into a landscape frame — that's what pixelates them.
						<button
							type="button"
							data-lightbox-trigger={i}
							class="flex items-center justify-center overflow-hidden rounded-md bg-card p-4"
						>
							<img
								src={cld(url, FIT_TALL)}
								alt={project.title}
								loading="lazy"
								class="max-h-[640px] w-auto max-w-full object-contain"
							/>
						</button>
					) : (
						<button
							type="button"
							data-lightbox-trigger={i}
							class="aspect-[4/3] overflow-hidden rounded-md bg-card"
						>
							<img
								src={cld(url, LANDSCAPE)}
								alt={project.title}
								loading="lazy"
								class="h-full w-full object-cover object-top"
							/>
						</button>
					)
				)
			}
		</div>
	</section>

	<Lightbox images={project.gallery} title={project.title} />
	<Footer />
</Layout>
