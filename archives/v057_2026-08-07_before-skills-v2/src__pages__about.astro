---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Sourced from ../../CV_David_Bitan_2026_v3.docx and ../../portfolio-cms-v2.xlsx (Timeline sheet).
const timeline = [
	{
		range: '2019 — 2026',
		role: 'Product UI/AI/UX Designer',
		company: 'Ryze Beyond (formerly TrafficPoint)',
		highlights: [
			'Scaled design impact as the company grew 32 → 110 employees',
			'Consolidated a 3-designer team into a single senior role via AI-augmented workflows',
			'AI-augmented workflow: Claude, Midjourney, Figma AI',
			'Built and maintained WCAG-compliant design systems',
			'Launched the Sonary product line',
		],
	},
	{
		range: '2018 — 2019',
		role: 'Senior UI/UX Designer',
		company: 'Smart.bid (LoanMax Team)',
		highlights: [
			'Rebranded LoanMax across all platforms',
			'Built a financial portal from scratch',
			'Payment application design',
		],
	},
	{
		range: '2017 — 2018',
		role: 'UI/UX Designer',
		company: 'Wochat',
		highlights: [
			'Instant-translation messaging app',
			'Full mobile + desktop design',
			'HTML5/CSS3 implementation',
			'Owned the brand',
		],
	},
	{
		range: '2015 — 2017',
		role: 'UI/UX Designer',
		company: 'Gamingtech',
		highlights: ['10Bet, Real Deal Bet, Bet Rally', 'Casino & sport betting design', 'HTML5 interactive banners'],
	},
	{
		range: '2013 — 2015',
		role: 'Interactive Art Designer',
		company: 'Mench - Qdigital',
		highlights: ['Digital campaigns and interactive experiences'],
	},
	{
		range: '2011 — 2013',
		role: 'Interactive Art Designer',
		company: 'IGMD Affeurope - Tradologic',
		highlights: ['Casino gaming & binary options interfaces'],
	},
	{
		range: '2006 — 2011',
		role: 'Interactive Art Designer',
		company: 'Arc Interactive (Publicis Group)',
		highlights: ['Team contributor on 12+ Cactus-awarded campaigns (Or, Argent, Bronze)', 'Digital advertising campaigns'],
	},
	{
		range: '2003 — 2005',
		role: 'Department Manager & Print Designer',
		company: 'Gestimo',
		highlights: ['Print and digital advertising'],
	},
];

const skillGroups = [
	{
		title: 'UX methods & design',
		items: [
			'User Research',
			'Usability Testing',
			'A/B Testing',
			'Personas',
			'Journey Mapping',
			'Competitive Analysis',
			'Wireframing',
			'Prototyping',
			'Information Architecture',
			'Interaction Design',
			'Responsive & Mobile-First Design',
			'Accessibility (WCAG)',
			'Design Systems',
		],
	},
	{
		title: 'Design tools',
		items: ['Figma (primary)', 'Photoshop', 'Illustrator', 'Sketch', 'After Effects', 'Cinema 4D', 'ZBrush'],
	},
	{
		title: 'AI tools',
		items: [
			'Claude (Code, Artifacts, Skills, Cowork)',
			'Claude ↔ VS Code integration',
			'AI Agents',
			'ChatGPT',
			'Gemini',
			'Midjourney',
			'Leonardo AI',
			'Figma AI',
			'Adobe AI (Illustrator, Photoshop, After Effects)',
		],
	},
	{
		title: 'Visual & motion',
		items: [
			'Iconography',
			'Vector Illustration',
			'SVG micro-interactions (SVGator)',
			'Adobe Animate (formerly Flash)',
		],
	},
	{
		title: 'Code',
		items: [
			'HTML5',
			'CSS3 (Flexbox & Grid)',
			'JavaScript (learning)',
			'Python (learning)',
		],
	},
];

const languages = [
	{ lang: 'French', level: 'Native' },
	{ lang: 'Hebrew', level: 'Fluent' },
	{ lang: 'English', level: 'Professional working proficiency' },
];
---

<Layout title="About — David Bitan">
	<Nav />

	<section class="mx-auto max-w-[1200px] px-6 pt-16 pb-10 sm:pt-20" data-reveal>
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">About</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			20 years of product design craft, now AI-native.
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted">
			Senior Product Designer with 20+ years across fintech, gaming, and AI-first startups.
			Sole designer at Ryze Beyond through two multi-year stretches — the AI-augmented
			workflow lets a single senior handle what used to take a full team.
		</p>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<div class="rounded-lg border border-ink/10 bg-card p-8 sm:p-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent">How this site was built</p>
			<p class="mt-4 max-w-2xl text-lg">
				This portfolio was designed and shipped in about two weeks of evening sessions,
				in pair with Claude — Anthropic's AI. Design decisions, copy, and code all came
				out of the same conversation. A live demonstration of the workflow the rest of
				this site is about.
			</p>
			<a
				href="/colophon"
				class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
			>
				Read the full colophon
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.4"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
				>
					<path d="M5 12h14" />
					<path d="M13 5l7 7-7 7" />
				</svg>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Experience</h2>
		<div class="mt-10 flex flex-col">
			{
				timeline.map((entry) => (
					<div class="grid grid-cols-1 gap-2 border-t border-ink/5 py-8 sm:grid-cols-[160px_1fr] sm:gap-8">
						<p class="font-semibold text-muted">{entry.range}</p>
						<div>
							<p class="text-lg font-semibold">
								{entry.role} <span class="font-normal text-muted">· {entry.company}</span>
							</p>
							<ul class="mt-3 flex flex-col gap-1.5">
								{entry.highlights.map((highlight) => (
									<li class="flex items-start gap-3 text-muted">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
										<span>{highlight}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Skills</h2>
		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div class="rounded-md bg-card p-6">
						<p class="font-semibold">{group.title}</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="rounded-pill bg-bg px-3 py-1 text-xs font-medium text-muted">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<div class="grid grid-cols-1 gap-12 sm:grid-cols-2">
			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Languages</h2>
				<ul class="mt-6 flex flex-col gap-3">
					{
						languages.map((l) => (
							<li class="flex items-baseline justify-between border-b border-ink/5 pb-3">
								<span class="font-semibold">{l.lang}</span>
								<span class="text-muted">{l.level}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Awards & education</h2>
				<div class="mt-6 flex flex-col gap-6">
					<div>
						<p class="font-semibold">
							<span class="text-accent">🏆</span> Cactus d'Or, d'Argent & de Bronze
						</p>
						<p class="mt-1 text-muted">
							French advertising industry awards. Team contributor on 12+ Cactus wins (Or, Argent,
							Bronze) over 5 years at Arc Interactive (Publicis Group), 2006–2011.
						</p>
					</div>
					<div>
						<p class="font-semibold">ORT Strasbourg (France)</p>
						<p class="mt-1 text-muted">
							Software Engineering School, 1994–1997 · Specification, design & programming of web
							applications
						</p>
					</div>
					<div>
						<p class="font-semibold">UI/UX Design Certification</p>
						<p class="mt-1 text-muted">Tal Florentin (Israel)</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
