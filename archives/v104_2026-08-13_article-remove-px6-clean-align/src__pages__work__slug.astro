---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import { allProjects } from '../../data/allProjects';
import { cld, FULL, MOBILE, landscapeSrcset, mobileSrcset } from '../../lib/cloudinary';
import { groupImagesByZone, zoneDescription } from '../../lib/zones';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
// Phase D — Behance-style layout: each project page is split into responsive
// "zones" (Desktop·Light / Desktop·Dark / Mobile·Light / Mobile·Dark for
// Sonary Dashboard; Desktop / Mobile for simpler projects; a single Gallery
// for legacy Wix imports). See src/lib/zones.ts for the classifier.
// No in-page lightbox — clicking an image opens the full Cloudinary URL in a
// new tab so the visitor gets the browser's native zoom / download UI.
const zones = groupImagesByZone(project.gallery, project.imageDeviceOverrides);
---

<Layout title={`${project.title} — David Bitan`}>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/#work" class="text-sm font-semibold text-accent hover:underline">← Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.shortDesc}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Client</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		<div class="mt-6 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-pill bg-card px-3 py-1 text-xs font-medium text-muted">{tag}</span>
				))
			}
		</div>

		{
			/* Rich case study: kept collapsed by default so mockup images can
			   sit above the fold. A "Read the full case study" toggle expands
			   the sections and switches to "Show less". Falls back to the
			   legacy fullDesc paragraph when sections are absent. */
			project.sections ? (
				<div class="mt-8 max-w-3xl pb-4">
					<div
						id="case-study-body"
						class="case-study-body"
						aria-hidden="true"
					>
						{project.sections.map((section) => (
							<section class="mt-10 first:mt-0">
								<h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">{section.heading}</h2>
								<div class="mt-4 space-y-4 leading-relaxed text-ink">
									{section.body
										.split(/\n\s*\n/)
										.map((para) => (
											<p>{para.trim()}</p>
										))}
								</div>
							</section>
						))}
						{project.liveUrl && (
							<a
								href={project.liveUrl}
								target="_blank"
								rel="noopener"
								class="mt-10 inline-flex items-center gap-2 rounded-pill bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-colors hover:bg-ink"
							>
								Visit live site
								<svg
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="M5 12h14" />
									<path d="M13 5l7 7-7 7" />
								</svg>
							</a>
						)}
					</div>

					<button
						type="button"
						id="case-study-toggle"
						aria-controls="case-study-body"
						aria-expanded="false"
						class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
					>
						<span data-toggle-label>Read the full case study</span>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4 transition-transform"
							data-toggle-chevron
						>
							<path d="M6 9l6 6 6-6" />
						</svg>
					</button>
				</div>
			) : (
				<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed text-ink">{project.fullDesc}</p>
			)
		}
	</article>

	<style>
		/* Accordion body: animate expand/collapse using measured scrollHeight
		   set inline by the toggle script. Fallback to auto so the layout
		   still works without JS. */
		.case-study-body {
			overflow: hidden;
			max-height: 0;
			opacity: 0;
			transition:
				max-height 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
				opacity 350ms ease-out;
		}
		.case-study-body[aria-hidden='false'] {
			opacity: 1;
		}
		@media (prefers-reduced-motion: reduce) {
			.case-study-body {
				transition: none;
			}
		}
	</style>

	<script is:inline>
		// Case-study accordion: keep the detailed sections collapsed by default
		// so the mockups (ZoneFilters + galleries below) sit above the fold.
		// Uses measured scrollHeight (in px) rather than a magic max-height
		// value so any content length animates smoothly.
		(() => {
			const btn = document.getElementById('case-study-toggle');
			const body = document.getElementById('case-study-body');
			if (!btn || !body) return;

			const labelEl = btn.querySelector('[data-toggle-label]');
			const chevron = btn.querySelector('[data-toggle-chevron]');

			function setExpanded(next) {
				btn.setAttribute('aria-expanded', String(next));
				body.setAttribute('aria-hidden', String(!next));

				if (next) {
					// Open: measured height, then release to `none` after
					// the transition so late-loaded images can't get clipped.
					body.style.maxHeight = body.scrollHeight + 'px';
					const clear = () => {
						body.style.maxHeight = 'none';
						body.removeEventListener('transitionend', clear);
					};
					body.addEventListener('transitionend', clear);
				} else {
					// Close: pin the current height, force reflow, drop to 0.
					body.style.maxHeight = body.scrollHeight + 'px';
					void body.offsetHeight;
					body.style.maxHeight = '0px';
				}

				if (labelEl) {
					labelEl.textContent = next ? 'Show less' : 'Read the full case study';
				}
				if (chevron) {
					chevron.style.transform = next ? 'rotate(180deg)' : '';
				}
			}

			btn.addEventListener('click', () => {
				const expanded = btn.getAttribute('aria-expanded') === 'true';
				setExpanded(!expanded);
			});
		})();
	</script>

	{/* Wrap ZoneFilters + zones together so the sticky bar has a tall
	    scrollable parent to pin against. A wrapper that hugged just
	    ZoneFilters (height = 58px) killed the sticky as soon as you
	    scrolled past that height. mt-8 keeps the 32px gap below the
	    "Read the full case study" toggle. */}
	<div class="mt-8">
		<ZoneFilters zones={zones} />

		{
			zones.map((zone) => {
			// Dark mockups already have a distinct dark background of their
			// own, so they don't need the wrapper border/shadow/bg treatment
			// that light mockups need to stand out from the near-white body.
			// Zones without a theme token (just "Desktop" / "Mobile" /
			// "Other") default to the "needs border" behaviour (safer for
			// unclassified content).
			const isDarkZone = /dark/i.test(zone.label);
			return (
				<section
					data-zone-label={zone.label}
					class="mx-auto mt-12 max-w-[1200px] scroll-mt-32"
					data-reveal
				>
					<header class="-mx-6 grid grid-cols-12 gap-8">
						<h2 class="col-span-12 text-3xl font-extrabold tracking-tight text-ink sm:col-span-4 sm:text-4xl">
							{zone.label}
						</h2>
						{
							/* Zone description is optional — some zones (e.g. "Other")
							   intentionally return an empty string. Skip rendering the
							   <p> entirely when empty so the header doesn't collapse
							   with dead whitespace. */
							zoneDescription(zone.label, zone.images.length) && (
								<p class="col-span-12 text-lg leading-relaxed text-muted sm:col-span-6 sm:col-start-7">
									{zoneDescription(zone.label, zone.images.length)}
								</p>
							)
						}
					</header>

					{
						zone.isMobile ? (
							// Mobile shots at native 375px. 3-col grid on ≥lg,
							// 2-col tablet, 1-col mobile. Dark mockups render on
							// a naked slot (their own dark bg is enough); light
							// mockups get the card treatment so their white edges
							// stay visible against the near-white body.
							// Client script (see bottom of file) reads each image's
							// naturalWidth/naturalHeight after load:
							//   - Wide (W/H > 1) = multi-screen composition/planche →
							//     moved to the full-width stack below the grid,
							//     src/srcset swapped to landscape presets for sharpness.
							//   - Portrait = real mobile capture → sorted by height DESC
							//     (via CSS order = -height) so similar heights sit
							//     side-by-side and the grid packs cleanly.
							<div class="mt-12 -mx-6" data-mobile-zone>
								{/* v093: switched from fixed 1/2/3 col grid to
								    auto-fit cells of exactly 375px (the mobile
								    design width). Cells never grow past 375, so
								    images never get stretched by the layout.
								    Rows center-align, so no wasted "gray strip"
								    between image and cell edge — the cell IS
								    the image slot. Gap tightened 24→12. */}
								<div
									class="flex flex-wrap items-start justify-start gap-[37.5px]"
									data-mobile-grid
								>
									{zone.images.map(({ url }) =>
										isDarkZone ? (
											// Dark mobile: image fills the 375-wide cell exactly
											// (cell = image slot). No border — dark mockup provides
											// its own contrast against the near-white body.
											<img
												src={cld(url, MOBILE)}
												srcset={mobileSrcset(url)}
												sizes="375px"
												alt={project.title}
												loading="lazy"
												width="375"
												class="block h-auto w-[375px] max-w-full rounded-xl"
												data-mobile-item
												data-full-src={cld(url, FULL)}
												data-full-srcset={landscapeSrcset(url)}
												data-is-dark="1"
											/>
										) : (
											// Light mobile: image fills its 375-wide cell exactly.
											// Border + shadow directly on <img> — the visible frame
											// is the image's edge, no padded gray strip anywhere.
											<img
												src={cld(url, MOBILE)}
												srcset={mobileSrcset(url)}
												sizes="375px"
												alt={project.title}
												loading="lazy"
												width="375"
												class="block h-auto w-[375px] max-w-full rounded-xl border border-ink/15 shadow-md"
												data-mobile-item
												data-full-src={cld(url, FULL)}
												data-full-srcset={landscapeSrcset(url)}
											/>
										),
									)}
								</div>
								<div class="mt-10 space-y-10" data-mobile-wide-stack></div>
							</div>
						) : zone.label === 'Other' ? (
							// Fallback for unclassified images. No bg wrapper
							// (avoids the gap issue when object-contain shows
							// a smaller image than the card). Ring + shadow
							// live on the <img> itself.
							<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
								{zone.images.map(({ url }) => (
									<img
										src={cld(url, FULL)}
										srcset={landscapeSrcset(url)}
										sizes="(min-width: 1024px) 560px, 100vw"
										alt={project.title}
										loading="lazy"
										class="mx-auto block h-auto max-h-[720px] w-auto max-w-full rounded-lg object-contain shadow-md ring-1 ring-ink/15"
									/>
								))}
							</div>
						) : (
							// Desktop shots: stacked full-width. srcset covers 2K/4K.
							// NO rounded (would clip mockup edges). Border+shadow
							// only for LIGHT (or theme-less) zones so light mockups
							// don't bleed into the near-white body. Dark mockups
							// render border-less — they already stand out.
							// Client script (see bottom of file) reads each image's
							// naturalWidth after load:
							//   - Narrow (natW < 900) = email template / narrow
							//     screenshot → moved to a 2-col grid below the stack,
							//     capped to natural width so it never upscales.
							//   - Wide (natW ≥ 900) = normal desktop mockup → stays
							//     full-width in the stack.
							<div class="mt-12 -mx-6" data-desktop-zone data-dark-zone={isDarkZone ? '1' : '0'}>
								<div class="space-y-10" data-desktop-stack>
									{zone.images.map(({ url }) => (
										<div
											class={isDarkZone ? 'w-full' : 'w-full border border-ink/15 shadow-md'}
											data-desktop-item
										>
											<img
												src={cld(url, FULL)}
												srcset={landscapeSrcset(url)}
												sizes="(min-width: 1280px) 1200px, 100vw"
												alt={project.title}
												loading="lazy"
												class="block h-auto w-full"
											/>
										</div>
									))}
								</div>
								{/* Narrow items land here at native width. Auto-fit means
								    the grid packs as many columns as fit (min col = 380px)
								    and centers whatever it can't fill — so a single 800px
								    item sits centered at 800, and four 400px items pack
								    2-3 per row. Inline style expresses what Tailwind's
								    arbitrary-value scanner can't (repeat + minmax with
								    max-content). */}
								<div
									class="mt-10 grid items-start justify-center gap-8"
									style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), max-content));"
									data-desktop-narrow-grid
								></div>
							</div>
						)
					}
				</section>
			);
		})
	}
	</div>

	<div class="pb-24"></div>

	<style is:global>
		/* Wide (multi-screen composition) items moved out of the mobile grid
		   into the full-width stack. v092: no more forced width:100% — the
		   mobile script probes each composition's TRUE source width and sets
		   `max-width: <sourceW>px` inline. That means the browser NEVER
		   upscales past source pixels; a 900-wide composition displays at
		   900 CSS max, centered. Border/shadow/rounded stripped so planches
		   (which usually come with their own designed background) render
		   cleanly edge-to-edge. */
		[data-mobile-wide-stack] > img[data-mobile-item] {
			display: block;
			width: 100%;
			height: auto;
			margin-left: auto;
			margin-right: auto;
			border: 0;
			border-radius: 0;
			box-shadow: none;
		}

		/* Narrow desktop items (e.g. email templates 400px wide) moved out
		   of the full-width stack into a 2-col grid, capped at their natural
		   width so the browser never upscales. Wrapper drops the full-width
		   stretch but keeps its border + shadow (light) or naked (dark). */
		[data-desktop-narrow-grid] > [data-desktop-item] {
			width: auto;
			max-width: 100%;
		}
		[data-desktop-narrow-grid] > [data-desktop-item] > img {
			width: auto;
			max-width: 100%;
			height: auto;
		}
	</style>

	<script is:inline>
		// Mobile zone layout: detect wide compositions vs portrait captures,
		// AND cap CSS width to the TRUE source width so the browser never
		// upscales past source pixels (David's rule: no upscale ever).
		//
		//   - Aspect ratio > 1 → composition/planche → moved to full-width
		//     wide stack; src/srcset swapped to the FULL/landscape presets;
		//     inline `max-width: <sourceW>px` caps the render to source width.
		//   - Portrait (ratio < 1) → stays in the grid; sorted by height
		//     DESC via CSS `order = -Math.round(naturalHeight)` so tallest
		//     items sit adjacent; if the probed source width is below 375,
		//     inline max-width caps the item so the grid slot never stretches
		//     the image past its native pixel count.
		//
		// Why the probe: `img.naturalWidth` reflects the served srcset variant,
		// not the Cloudinary source. `c_limit,w_9999` returns the true source
		// width (never upscales, never downscales below source).
		(() => {
			const zones = document.querySelectorAll('[data-mobile-zone]');
			if (!zones.length) return;

			// Probe true source width (same pattern as the desktop narrow-grid
			// script). Cached per-URL so re-probes across zones are free.
			const probeCache = new Map();
			function probeSourceWidth(imgSrc) {
				const probeSrc = imgSrc.replace(
					/\/upload\/(c_[^/]+\/)?/,
					'/upload/c_limit,w_9999,q_100,f_auto/'
				);
				if (probeCache.has(probeSrc)) return probeCache.get(probeSrc);
				const p = new Promise((resolve) => {
					const probe = new Image();
					probe.onload = () => resolve(probe.naturalWidth || 0);
					probe.onerror = () => resolve(0);
					probe.src = probeSrc;
				});
				probeCache.set(probeSrc, p);
				return p;
			}

			zones.forEach((zone) => {
				const grid = zone.querySelector('[data-mobile-grid]');
				const wideStack = zone.querySelector('[data-mobile-wide-stack]');
				if (!grid || !wideStack) return;

				const items = Array.from(grid.querySelectorAll('[data-mobile-item]'));

				items.forEach((item) => {
					const img = item.tagName === 'IMG' ? item : item.querySelector('img');
					if (!img) return;

					const handle = async () => {
						const w = img.naturalWidth;
						const h = img.naturalHeight;
						if (!w || !h) return;

						const ratio = w / h;

						if (ratio > 1) {
							// Wide composition: swap to landscape srcset for sharpness,
							// move item to wide stack, then probe true source width
							// and cap max-width so we never upscale past source.
							const fullSrc = img.dataset.fullSrc;
							const fullSrcset = img.dataset.fullSrcset;
							if (fullSrc) img.src = fullSrc;
							if (fullSrcset) {
								img.srcset = fullSrcset;
								img.sizes = '(min-width: 1280px) 1200px, 100vw';
							}
							img.removeAttribute('width');
							wideStack.appendChild(item);

							const trueW = await probeSourceWidth(img.src);
							if (trueW > 0) {
								const target = item.tagName === 'IMG' ? item : img;
								target.style.maxWidth = trueW + 'px';
							}
						} else {
							// Portrait: sort by height DESC via CSS order.
							// Negative value → CSS treats as smaller → renders first.
							item.style.order = String(-Math.round(h));

							// If the true source is narrower than 375, cap CSS
							// max-width to source width so the 375-column slot
							// doesn't stretch the image past its native pixels.
							// (Sources ≥ 375 need no cap — grid already tops at 375.)
							const trueW = await probeSourceWidth(img.src);
							if (trueW > 0 && trueW < 375) {
								const target = item.tagName === 'IMG' ? item : img;
								target.style.maxWidth = trueW + 'px';
							}
						}
					};

					if (img.complete && img.naturalWidth) {
						handle();
					} else {
						img.addEventListener('load', handle, { once: true });
						img.addEventListener('error', () => {}, { once: true });
					}
				});
			});
		})();
	</script>

	<script is:inline>
		// Desktop zone: split narrow images (e.g. Sonary Email Templates, 400px
		// wide) out of the full-width stack into an auto-fit grid. Cap each
		// moved item's inline max-width to the SOURCE width (not the served
		// variant width — see probe below). Wide images (≥900px source) stay
		// in the full-width stack.
		//
		// Why the probe: `img.naturalWidth` reflects the srcset variant the
		// browser actually served, not the Cloudinary source. On a small slot
		// with `sizes="(min-width:1280px) 1200px, 100vw"`, the browser may
		// serve a 639px or 800px variant of a 1200px source — my old detector
		// then classified 1200px sources as "narrow" (false positive) and moved
		// them into the narrow grid, where they got clamped even smaller.
		// The probe fetches `c_limit,w_9999` which returns exactly the source
		// width (Cloudinary caps at source), so we see the truth.
		(() => {
			const NARROW_THRESHOLD = 900;
			const zones = document.querySelectorAll('[data-desktop-zone]');
			if (!zones.length) return;

			// Probe true source width via a Cloudinary transform that always
			// returns the source's own width (never upscales, never downscales
			// below source). Cached across probes for the same URL.
			const probeCache = new Map();
			function probeSourceWidth(imgSrc) {
				const probeSrc = imgSrc.replace(
					/\/upload\/(c_[^/]+\/)?/,
					'/upload/c_limit,w_9999,q_100,f_auto/'
				);
				if (probeCache.has(probeSrc)) return probeCache.get(probeSrc);
				const p = new Promise((resolve) => {
					const probe = new Image();
					probe.onload = () => resolve(probe.naturalWidth || 0);
					probe.onerror = () => resolve(0);
					probe.src = probeSrc;
				});
				probeCache.set(probeSrc, p);
				return p;
			}

			zones.forEach((zone) => {
				const stack = zone.querySelector('[data-desktop-stack]');
				const narrowGrid = zone.querySelector('[data-desktop-narrow-grid]');
				if (!stack || !narrowGrid) return;

				const items = Array.from(stack.querySelectorAll('[data-desktop-item]'));

				items.forEach((item) => {
					const img = item.querySelector('img');
					if (!img) return;

					const handle = async () => {
						const servedW = img.naturalWidth;
						if (!servedW) return;

						// Only probe if the served variant looks like a narrow
						// candidate. Skip the probe (0 fetches) when the served
						// width is already ≥ threshold — the source is definitely
						// wide enough.
						if (servedW >= NARROW_THRESHOLD) return;

						const trueW = await probeSourceWidth(img.src);
						if (!trueW || trueW >= NARROW_THRESHOLD) return;

						// Genuinely narrow source: cap the item's inline
						// max-width to the true source width so the auto-fit
						// grid centers it at native size — never upscaled,
						// never squeezed.
						item.style.maxWidth = trueW + 'px';
						narrowGrid.appendChild(item);
					};

					if (img.complete && img.naturalWidth) {
						handle();
					} else {
						img.addEventListener('load', handle, { once: true });
						img.addEventListener('error', () => {}, { once: true });
					}
				});
			});
		})();
	</script>

	<Footer />
</Layout>
