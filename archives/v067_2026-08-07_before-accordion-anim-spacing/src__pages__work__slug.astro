---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import { allProjects } from '../../data/allProjects';
import { cld, FULL, MOBILE, landscapeSrcset, mobileSrcset } from '../../lib/cloudinary';
import { groupImagesByZone, zoneDescription } from '../../lib/zones';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
// Phase D — Behance-style layout: each project page is split into responsive
// "zones" (Desktop·Light / Desktop·Dark / Mobile·Light / Mobile·Dark for
// Sonary Dashboard; Desktop / Mobile for simpler projects; a single Gallery
// for legacy Wix imports). See src/lib/zones.ts for the classifier.
// No in-page lightbox — clicking an image opens the full Cloudinary URL in a
// new tab so the visitor gets the browser's native zoom / download UI.
const zones = groupImagesByZone(project.gallery);
---

<Layout title={`${project.title} — David Bitan`}>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/#work" class="text-sm font-semibold text-accent hover:underline">← Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.shortDesc}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Client</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		<div class="mt-6 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-pill bg-card px-3 py-1 text-xs font-medium text-muted">{tag}</span>
				))
			}
		</div>

		{
			/* Rich case study: kept collapsed by default so mockup images can
			   sit above the fold. A "Read the full case study" toggle expands
			   the sections and switches to "Show less". Falls back to the
			   legacy fullDesc paragraph when sections are absent. */
			project.sections ? (
				<div class="mt-8 max-w-3xl">
					<div
						id="case-study-body"
						class="hidden"
						aria-hidden="true"
					>
						{project.sections.map((section) => (
							<section class="mt-10 first:mt-0">
								<h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">{section.heading}</h2>
								<div class="mt-4 space-y-4 leading-relaxed text-ink">
									{section.body
										.split(/\n\s*\n/)
										.map((para) => (
											<p>{para.trim()}</p>
										))}
								</div>
							</section>
						))}
						{project.liveUrl && (
							<a
								href={project.liveUrl}
								target="_blank"
								rel="noopener"
								class="mt-10 inline-flex items-center gap-2 rounded-pill bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-colors hover:bg-ink"
							>
								Visit live site
								<svg
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4"
								>
									<path d="M5 12h14" />
									<path d="M13 5l7 7-7 7" />
								</svg>
							</a>
						)}
					</div>

					<button
						type="button"
						id="case-study-toggle"
						aria-controls="case-study-body"
						aria-expanded="false"
						class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
					>
						<span data-toggle-label>Read the full case study</span>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4 transition-transform"
							data-toggle-chevron
						>
							<path d="M6 9l6 6 6-6" />
						</svg>
					</button>
				</div>
			) : (
				<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed text-ink">{project.fullDesc}</p>
			)
		}
	</article>

	<script is:inline>
		// Case-study accordion: keep the detailed sections collapsed by default
		// so the mockups (ZoneFilters + galleries below) sit above the fold.
		// Toggle expands the body and swaps the button label + chevron.
		(() => {
			const btn = document.getElementById('case-study-toggle');
			const body = document.getElementById('case-study-body');
			if (!btn || !body) return;

			const labelEl = btn.querySelector('[data-toggle-label]');
			const chevron = btn.querySelector('[data-toggle-chevron]');

			btn.addEventListener('click', () => {
				const expanded = btn.getAttribute('aria-expanded') === 'true';
				const next = !expanded;
				btn.setAttribute('aria-expanded', String(next));
				body.classList.toggle('hidden', !next);
				body.setAttribute('aria-hidden', String(!next));
				if (labelEl) {
					labelEl.textContent = next ? 'Show less' : 'Read the full case study';
				}
				if (chevron) {
					chevron.style.transform = next ? 'rotate(180deg)' : '';
				}
			});
		})();
	</script>

	<ZoneFilters zones={zones} />

	{
		zones.map((zone) => {
			// Dark mockups already have a distinct dark background of their
			// own, so they don't need the wrapper border/shadow/bg treatment
			// that light mockups need to stand out from the near-white body.
			// Zones without a theme token (just "Desktop" / "Mobile" /
			// "Other") default to the "needs border" behaviour (safer for
			// unclassified content).
			const isDarkZone = /dark/i.test(zone.label);
			return (
				<section
					data-zone-label={zone.label}
					class="mx-auto mt-12 max-w-[1200px] scroll-mt-32 px-6"
					data-reveal
				>
					<header class="grid grid-cols-12 gap-8">
						<h2 class="col-span-12 text-3xl font-extrabold tracking-tight text-ink sm:col-span-4 sm:text-4xl">
							{zone.label}
						</h2>
						<p class="col-span-12 text-lg leading-relaxed text-muted sm:col-span-6 sm:col-start-7">
							{zoneDescription(zone.label, zone.images.length)}
						</p>
					</header>

					{
						zone.isMobile ? (
							// Mobile shots at native 375px. 3-col grid on ≥lg,
							// 2-col tablet, 1-col mobile. Dark mockups render on
							// a naked slot (their own dark bg is enough); light
							// mockups get the card treatment so their white edges
							// stay visible against the near-white body.
							<div class="mt-12 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
								{zone.images.map(({ url }) =>
									isDarkZone ? (
										<img
											src={cld(url, MOBILE)}
											srcset={mobileSrcset(url)}
											sizes="375px"
											alt={project.title}
											loading="lazy"
											width="375"
											class="mx-auto block h-auto w-[375px] max-w-full rounded-xl"
										/>
									) : (
										<div class="flex items-start justify-center overflow-hidden rounded-lg border border-ink/15 bg-card p-5 shadow-md sm:p-6">
											<img
												src={cld(url, MOBILE)}
												srcset={mobileSrcset(url)}
												sizes="375px"
												alt={project.title}
												loading="lazy"
												width="375"
												class="mx-auto h-auto w-[375px] max-w-full rounded-xl ring-1 ring-ink/15"
											/>
										</div>
									),
								)}
							</div>
						) : zone.label === 'Other' ? (
							// Fallback for unclassified images. No bg wrapper
							// (avoids the gap issue when object-contain shows
							// a smaller image than the card). Ring + shadow
							// live on the <img> itself.
							<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
								{zone.images.map(({ url }) => (
									<img
										src={cld(url, FULL)}
										srcset={landscapeSrcset(url)}
										sizes="(min-width: 1024px) 560px, 100vw"
										alt={project.title}
										loading="lazy"
										class="mx-auto block h-auto max-h-[720px] w-auto max-w-full rounded-lg object-contain shadow-md ring-1 ring-ink/15"
									/>
								))}
							</div>
						) : (
							// Desktop shots: stacked full-width. srcset covers 2K/4K.
							// NO rounded (would clip mockup edges). Border+shadow
							// only for LIGHT (or theme-less) zones so light mockups
							// don't bleed into the near-white body. Dark mockups
							// render border-less — they already stand out.
							<div class="mt-12 space-y-10">
								{zone.images.map(({ url }) => (
									<div class={isDarkZone ? 'w-full' : 'w-full border border-ink/15 shadow-md'}>
										<img
											src={cld(url, FULL)}
											srcset={landscapeSrcset(url)}
											sizes="(min-width: 1280px) 1200px, 100vw"
											alt={project.title}
											loading="lazy"
											class="block h-auto w-full"
										/>
									</div>
								))}
							</div>
						)
					}
				</section>
			);
		})
	}

	<div class="pb-24"></div>

	<Footer />
</Layout>
