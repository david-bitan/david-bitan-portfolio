---
import { cld, LANDSCAPE } from '../lib/cloudinary';
import type { FullProject } from '../data/allProjects';

interface Props {
	project: FullProject;
}

const { project } = Astro.props;
// Space-separated list of pill categories this card belongs to. HomeFilters
// splits on whitespace and checks membership. Falls back to the single
// primary category when no explicit `categories` field is present.
const cardCategories = (project.categories ?? [project.category]).join(' ');
---

<a
	href={`/work/${project.slug}`}
	data-categories={cardCategories}
	class="group block overflow-hidden rounded-md bg-card"
>
	<div class="aspect-[4/3] overflow-hidden">
		<img
			src={cld(project.thumbnail, LANDSCAPE)}
			alt={project.title}
			loading="lazy"
			class="thumb-hover-zoom h-full w-full object-cover object-top"
		/>
	</div>
	<div class="p-4">
		<h3 class="text-base font-bold tracking-tight">{project.title}</h3>
		<p class="mt-1.5 line-clamp-2 text-sm text-muted">{project.shortDesc}</p>
	</div>
</a>
