---
// Sticky pill filter bar for the /craft page.
// - `All` is always present and active by default.
// - Categories are passed in from the caller (built from craftItems), so
//   adding a new category to the data source (Digital Painting, 3D, Drawing,
//   Icons, ...) automatically adds a new pill here — no code change needed.
// - Filtering is client-side: toggles `.hidden` on `<figure data-category="...">`.

interface Props {
	categories: string[];
}
const { categories } = Astro.props;
---

<div
	id="craft-filters"
	class="sticky top-[68px] z-30 border-y border-ink/10 bg-bg/95 backdrop-blur"
>
	<div class="mx-auto max-w-[1200px] px-6 py-4">
		<div class="flex flex-wrap items-center gap-2">
			<button
				type="button"
				data-craft-filter="__all__"
				class="craft-filter-btn cursor-pointer rounded-pill border border-ink/15 bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors"
				aria-pressed="true"
			>
				All
			</button>
			{
				categories.map((cat) => (
					<button
						type="button"
						data-craft-filter={cat}
						class="craft-filter-btn cursor-pointer rounded-pill border border-ink/15 bg-transparent px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
						aria-pressed="false"
					>
						{cat}
					</button>
				))
			}
		</div>
	</div>
</div>

<script>
	// Craft filters: wire up click handlers once the DOM is ready. Uses
	// `type="module"` (Astro default when no `is:inline`) which is
	// automatically deferred — runs after the whole HTML is parsed, so
	// `.craft-figure` selectors below the filter bar are already in the DOM.
	//
	// Previous bug: `<script is:inline>` in this component ran in-place,
	// BEFORE the figures rendered further down in craft.astro. `figures`
	// was empty and the early return killed all click handlers, giving
	// the impression the filter did nothing.
	const buttons = document.querySelectorAll<HTMLButtonElement>('.craft-filter-btn');
	const figures = document.querySelectorAll<HTMLElement>('.craft-figure');

	if (buttons.length && figures.length) {
		const ACTIVE_ADD = ['bg-accent', 'text-accent-ink'];
		const ACTIVE_REMOVE = ['bg-transparent', 'text-ink', 'hover:border-accent', 'hover:text-accent'];

		function apply(filter: string) {
			figures.forEach((f) => {
				const cat = f.dataset.category;
				const show = filter === '__all__' || cat === filter;
				f.classList.toggle('hidden', !show);
			});
			buttons.forEach((b) => {
				const active = b.dataset.craftFilter === filter;
				b.setAttribute('aria-pressed', String(active));
				if (active) {
					b.classList.add(...ACTIVE_ADD);
					b.classList.remove(...ACTIVE_REMOVE);
				} else {
					b.classList.remove(...ACTIVE_ADD);
					b.classList.add(...ACTIVE_REMOVE);
				}
			});
		}

		buttons.forEach((b) => {
			b.addEventListener('click', () => {
				const key = b.dataset.craftFilter;
				if (key) apply(key);
			});
		});
	}
</script>
