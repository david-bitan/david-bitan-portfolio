---
import { craftItems } from '../data/craftItems';
import { cld, LANDSCAPE } from '../lib/cloudinary';

// Number of thumbnails shown by default. The full list is always rendered to
// the HTML (SEO-friendly, and gracefully degrades if JS is disabled — the
// visitor just sees all items). Client-side script shuffles the order and
// hides everything past this cap until the user clicks "Load more".
const INITIAL_COUNT = 12;
---

<div class="mx-auto max-w-[1200px] px-6">
	<hr class="border-t border-ink/10" />
</div>

<section id="craft" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 py-20 sm:py-28" data-reveal>
	<div class="mb-12">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Craft</p>
		<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Personal work</h2>
		<p class="mt-4 max-w-2xl text-muted">3D renders and digital painting — outside the product work.</p>
	</div>

	<div
		id="craft-grid"
		class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
		data-initial-count={INITIAL_COUNT}
	>
		{
			craftItems.map((item) => (
				<a
					href={`/craft#${item.slug}`}
					data-category={item.category}
					class="craft-item group block overflow-hidden rounded-md bg-card"
				>
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src={cld(item.image, LANDSCAPE)}
							alt={item.title}
							loading="lazy"
							class="thumb-hover-zoom h-full w-full object-cover object-top"
						/>
					</div>
					<div class="p-4">
						<h3 class="text-base font-bold tracking-tight">{item.title}</h3>
						<p class="mt-1.5 line-clamp-2 text-sm text-muted">{item.description}</p>
					</div>
				</a>
			))
		}
	</div>

	<div class="mt-12 flex justify-center" id="craft-load-more-wrapper">
		<button
			id="craft-load-more"
			type="button"
			aria-label="Load more"
			class="group inline-flex flex-col items-center gap-4"
		>
			{/* Pill = the actual visible button (orange bg, white text). Full
				click surface is the wrapping <button>, so clicking the arrow
				below also triggers the reveal. */}
			<span class="rounded-pill bg-accent px-8 py-3 text-sm font-semibold text-white shadow-sm transition group-hover:bg-accent/90">
				Load more
			</span>
			{/* External chevron: sits below the pill, orange, gently bouncing
				top→bottom in a continuous loop to invite interaction. */}
			<svg
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="craft-arrow-bounce h-7 w-7 text-accent"
			>
				<path d="M6 9l6 6 6-6" />
			</svg>
		</button>
	</div>
</section>

<style>
	@keyframes craft-arrow-bounce {
		0%,
		100% {
			transform: translateY(0);
			opacity: 0.85;
		}
		50% {
			transform: translateY(8px);
			opacity: 1;
		}
	}
	.craft-arrow-bounce {
		animation: craft-arrow-bounce 1.6s ease-in-out infinite;
		will-change: transform, opacity;
	}

	/* Newly-revealed thumbnails after Load More: fade + slide up, staggered
	   via inline animation-delay set by the script. `both` keeps the item at
	   the final frame after the animation ends. */
	@keyframes craft-reveal {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.craft-revealing {
		animation: craft-reveal 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
		will-change: transform, opacity;
	}

	@media (prefers-reduced-motion: reduce) {
		.craft-arrow-bounce,
		.craft-revealing {
			animation: none;
		}
	}
</style>

<script is:inline>
	// Craft grid enhancement: shuffle client-side + reveal-on-click.
	// SSR renders ALL items so the page is complete without JS (SEO + no-JS
	// fallback). This script randomizes visual order via CSS `order` and
	// hides everything past `INITIAL_COUNT`. Refreshing the page reshuffles.
	(() => {
		const grid = document.getElementById('craft-grid');
		const wrap = document.getElementById('craft-load-more-wrapper');
		const btn = document.getElementById('craft-load-more');
		if (!grid || !wrap || !btn) return;

		const items = Array.from(grid.querySelectorAll('.craft-item'));
		const initial = parseInt(grid.dataset.initialCount || '12', 10);

		// Fisher-Yates shuffle on an index array (safer than sorting).
		const order = items.map((_, i) => i);
		for (let i = order.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[order[i], order[j]] = [order[j], order[i]];
		}

		// Assign CSS `order` so the grid renders in the shuffled sequence,
		// then hide anything past the initial cap. Using CSS order (rather
		// than reordering the DOM) keeps the source order stable for AT/SEO.
		order.forEach((originalIdx, position) => {
			const el = items[originalIdx];
			el.style.order = String(position);
			if (position >= initial) {
				el.classList.add('hidden');
				el.dataset.craftHidden = 'true';
			}
		});

		if (items.length <= initial) {
			wrap.classList.add('hidden');
			return;
		}

		btn.addEventListener('click', () => {
			// Reveal newly-shown items with a staggered fade-up so the batch
			// doesn't pop in abruptly. Delay is capped so long lists don't
			// linger too long before the last item shows.
			let revealIdx = 0;
			items.forEach((el) => {
				if (el.dataset.craftHidden === 'true') {
					el.classList.remove('hidden');
					delete el.dataset.craftHidden;
					el.style.animationDelay = Math.min(revealIdx * 60, 800) + 'ms';
					el.classList.add('craft-revealing');
					revealIdx++;
				}
			});
			wrap.classList.add('hidden');
		});
	})();
</script>
