---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
	title?: string;
}

const { title = 'David Bitan — Senior Product Designer' } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline>
			// Runs before body paint to avoid a light→dark flash. Light is the
			// default — only a saved "dark" preference switches it, never OS
			// detection.
			try {
				if (localStorage.getItem('theme') === 'dark') {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch {
				// localStorage unavailable (private mode, etc.) — default to light
			}
		</script>
	</head>
	<body>
		<slot />
		<BackToTop />
	</body>
</html>

<script>
	const targets = document.querySelectorAll('[data-reveal]');
	// threshold: 0 + a bottom rootMargin (not a % threshold) so this triggers
	// consistently regardless of section height — a percentage threshold like
	// 0.15 can never be satisfied by a section taller than ~6x the viewport
	// (e.g. a 96-image case-study gallery), leaving it permanently invisible.
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0, rootMargin: '0px 0px -10% 0px' }
	);
	targets.forEach((target) => observer.observe(target));
</script>
