---
import type { Zone } from '../lib/zones';

interface Props {
	zones: Zone[];
}

const { zones } = Astro.props;

// Two independent filter groups — a Device choice AND a Theme choice can be
// combined (e.g. Desktop + Dark → shows only the "Desktop · Dark" zone).
// Sonary Dashboard shows both groups. A 2-zone project without theme split
// shows only the Device group. A Gallery-only project shows nothing.
const labels = zones.map((z) => z.label);
const hasDesktop = labels.some((l) => /desktop/i.test(l));
const hasMobile = labels.some((l) => /mobile/i.test(l));
const hasLight = labels.some((l) => /light/i.test(l));
const hasDark = labels.some((l) => /dark/i.test(l));

type Filter = { key: string; label: string };

const deviceOptions: Filter[] = [];
if (hasDesktop || hasMobile) {
	deviceOptions.push({ key: 'all', label: 'All' });
	if (hasDesktop) deviceOptions.push({ key: 'desktop', label: 'Desktop' });
	if (hasMobile) deviceOptions.push({ key: 'mobile', label: 'Mobile' });
}

const themeOptions: Filter[] = [];
if (hasLight || hasDark) {
	themeOptions.push({ key: 'all', label: 'All' });
	if (hasLight) themeOptions.push({ key: 'light', label: 'Light' });
	if (hasDark) themeOptions.push({ key: 'dark', label: 'Dark' });
}

const showBar = deviceOptions.length > 1 || themeOptions.length > 1;
---

{
	showBar && (
		<div
			id="zone-filters-bar"
			class="sticky top-[68px] z-30 w-full border-y border-ink/10 bg-bg/95 backdrop-blur"
		>
			<div class="mx-auto max-w-[1200px] px-6 py-3 lg:px-0">
				{/* Single horizontal row — Back arrow (revealed on sticky) +
					Device label + pills + separator + Theme label + pills.
					flex-nowrap + overflow-x-auto → user swipes horizontally
					to reveal hidden pills on narrow viewports.
					`-mx-6 px-6 ... lg:mx-0 lg:px-0` extends the scroll area
					edge-to-edge viewport on mobile, aligns with 1200 on
					desktop. */}
				<div class="zone-filters-scroll -mx-6 flex flex-nowrap items-center gap-3 overflow-x-auto px-6 sm:gap-4 lg:mx-0 lg:px-0">
					{/* Back arrow — hidden by default (opacity 0, no space
						taken via negative margin trick). When the bar becomes
						sticky (user scrolls past its natural position), fades
						in + slides from -6px, and the following content shifts
						right via margin-left to make room. During horizontal
						pill scroll, the arrow is `position: sticky; left: 6`
						so it stays glued to the left edge of the visible
						scroll area while other content passes behind. bg-bg
						opaque so the arrow visually hides content behind it. */}
					<a
						href="/#work"
						aria-label="Back to projects"
						class="zone-filters-back sticky left-6 z-10 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/15 bg-bg text-muted hover:border-accent hover:text-accent lg:left-0"
					>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4"
						>
							<path d="M15 18l-6-6 6-6" />
						</svg>
					</a>

					{deviceOptions.length > 1 && (
						<>
							<span class="zone-filters-first-item shrink-0 text-[11px] font-semibold uppercase tracking-widest text-muted">Device</span>
							{deviceOptions.map((f, i) => (
								<button
									type="button"
									data-filter-group="device"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn shrink-0 rounded-pill border border-ink/15 px-4 py-1.5 text-sm font-medium text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink"
								>
									{f.label}
								</button>
							))}
						</>
					)}

					{/* Vertical separator between Device and Theme groups —
						only rendered when both groups are present. */}
					{deviceOptions.length > 1 && themeOptions.length > 1 && (
						<div class="h-6 w-px shrink-0 bg-ink/15" aria-hidden="true" />
					)}

					{themeOptions.length > 1 && (
						<>
							{deviceOptions.length <= 1 && (
								<span class="zone-filters-first-item shrink-0 text-[11px] font-semibold uppercase tracking-widest text-muted">Theme</span>
							)}
							{deviceOptions.length > 1 && (
								<span class="shrink-0 text-[11px] font-semibold uppercase tracking-widest text-muted">Theme</span>
							)}
							{themeOptions.map((f, i) => (
								<button
									type="button"
									data-filter-group="theme"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn shrink-0 rounded-pill border border-ink/15 px-4 py-1.5 text-sm font-medium text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink"
								>
									{f.label}
								</button>
							))}
						</>
					)}
				</div>
			</div>
		</div>
	)
}

<script>
	const deviceBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="device"]'),
	);
	const themeBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="theme"]'),
	);
	const sections = Array.from(
		document.querySelectorAll<HTMLElement>('section[data-zone-label]'),
	);

	let selectedDevice = 'all';
	let selectedTheme = 'all';

	function apply() {
		deviceBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedDevice ? 'true' : 'false';
		});
		themeBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedTheme ? 'true' : 'false';
		});
		sections.forEach((sec) => {
			const label = (sec.dataset.zoneLabel || '').toLowerCase();
			const matchDevice = selectedDevice === 'all' || label.includes(selectedDevice);
			const matchTheme = selectedTheme === 'all' || label.includes(selectedTheme);
			sec.classList.toggle('hidden', !(matchDevice && matchTheme));
		});
	}

	deviceBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedDevice = b.dataset.filterKey || 'all';
			apply();
		}),
	);
	themeBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedTheme = b.dataset.filterKey || 'all';
			apply();
		}),
	);

	// Sticky detection — toggle `.is-stuck` on the bar when it pins to
	// top-[68px]. IntersectionObserver with a shrunk root (rootMargin
	// -69px top) fires when the bar's top edge crosses the 68px line under
	// the nav. threshold [1] triggers as soon as any pixel of the bar
	// starts being clipped by that virtual top edge.
	const bar = document.getElementById('zone-filters-bar');
	if (bar && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			([entry]) => {
				bar.classList.toggle('is-stuck', entry.intersectionRatio < 1);
			},
			{ rootMargin: '-69px 0px 0px 0px', threshold: [1] },
		);
		io.observe(bar);
	}
</script>

<style is:global>
	/* Hide the horizontal scrollbar on the pills row while keeping scroll
	   functional (touch swipe / trackpad / scroll wheel). Cleaner look on
	   both mobile and desktop for the short pill list. */
	.zone-filters-scroll {
		scrollbar-width: none;
	}
	.zone-filters-scroll::-webkit-scrollbar {
		display: none;
	}

	/* Back arrow reveal animation — hidden by default (opacity 0 +
	   translateX(-6px)), fades in + slides right when the bar gets
	   .is-stuck. Simultaneously, the first content item (Device or Theme
	   label) shifts right via margin-left to make room, syncing the
	   entrance. `is:global` so runtime class .is-stuck (added by JS) can
	   match. Transitions defined here (not via Tailwind arbitrary classes)
	   because comma-in-arbitrary-value breaks the JIT scanner. */
	.zone-filters-back {
		opacity: 0;
		transform: translateX(-6px);
		pointer-events: none;
		transition:
			opacity 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			border-color 200ms ease,
			color 200ms ease;
		will-change: opacity, transform;
	}
	.zone-filters-first-item {
		margin-left: -40px;
		transition: margin-left 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: margin-left;
	}
	#zone-filters-bar.is-stuck .zone-filters-back {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
	}
	#zone-filters-bar.is-stuck .zone-filters-first-item {
		margin-left: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.zone-filters-back,
		.zone-filters-first-item {
			transition: none !important;
		}
	}
</style>
