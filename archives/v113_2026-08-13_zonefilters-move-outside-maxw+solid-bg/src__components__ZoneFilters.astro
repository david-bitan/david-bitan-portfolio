---
import type { Zone } from '../lib/zones';

interface Props {
	zones: Zone[];
}

const { zones } = Astro.props;

// Two independent filter groups — a Device choice AND a Theme choice can be
// combined (e.g. Desktop + Dark → shows only the "Desktop · Dark" zone).
// Sonary Dashboard shows both groups. A 2-zone project without theme split
// shows only the Device group. A Gallery-only project shows nothing.
const labels = zones.map((z) => z.label);
const hasDesktop = labels.some((l) => /desktop/i.test(l));
const hasMobile = labels.some((l) => /mobile/i.test(l));
const hasLight = labels.some((l) => /light/i.test(l));
const hasDark = labels.some((l) => /dark/i.test(l));

type Filter = { key: string; label: string };

const deviceOptions: Filter[] = [];
if (hasDesktop || hasMobile) {
	deviceOptions.push({ key: 'all', label: 'All' });
	if (hasDesktop) deviceOptions.push({ key: 'desktop', label: 'Desktop' });
	if (hasMobile) deviceOptions.push({ key: 'mobile', label: 'Mobile' });
}

const themeOptions: Filter[] = [];
if (hasLight || hasDark) {
	themeOptions.push({ key: 'all', label: 'All' });
	if (hasLight) themeOptions.push({ key: 'light', label: 'Light' });
	if (hasDark) themeOptions.push({ key: 'dark', label: 'Dark' });
}

const showBar = deviceOptions.length > 1 || themeOptions.length > 1;
---

{
	showBar && (
		<div
			id="zone-filters-bar"
			class="sticky top-[68px] z-30 w-full border-y border-ink/10 bg-bg/95 backdrop-blur"
		>
			{/* Flex container is the scroll surface.
				  - Mobile/tablet (<lg) : FULL VIEWPORT WIDTH edge-to-edge,
				    matching the bar background (David : "je veux que le filtre
				    aille jusqu'au bout des bordures du téléphone").
				  - Desktop (lg+) : aligned to 1200 pile (mx-auto max-w) —
				    desktop layout is fine as-is per David. */}
			<div class="zone-filters-scroll flex w-full items-center overflow-x-auto py-3 lg:mx-auto lg:max-w-[1200px]">
				{/* Back arrow = wide "shield" element, sticky-left within the
					flex scroll. Wider than the visible round button (pl-6 pr-3
					on mobile = 24+32+12 = 68 wide of solid bg) so pills passing
					behind it during horizontal scroll are FULLY HIDDEN by the
					opaque bg-bg. On lg+, the shield's left padding shrinks to
					0 (aligned pile 1200). Animated: opacity 0 → 1 + translateX
					when the bar becomes sticky. */}
				<a
					href="/#work"
					aria-label="Back to projects"
					class="zone-filters-back sticky left-0 z-20 flex shrink-0 items-center bg-bg/95 py-1 pl-6 pr-3 backdrop-blur lg:pl-0"
				>
					<span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/15 text-muted transition-colors hover:border-accent hover:text-accent">
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4"
						>
							<path d="M15 18l-6-6 6-6" />
						</svg>
					</span>
				</a>

				{/* First content item — has negative margin-left equal to the
					back arrow shield's width on non-sticky, so content starts
					flush at viewport-left (edge-to-edge). On sticky, margin
					animates to 0, revealing the shield + back arrow. */}
				{deviceOptions.length > 1 && (
					<>
						<span class="zone-filters-first-item shrink-0 pl-6 text-[11px] font-semibold uppercase tracking-widest text-muted lg:pl-0">
							Device
						</span>
						{deviceOptions.map((f, i) => (
							<button
								type="button"
								data-filter-group="device"
								data-filter-key={f.key}
								data-active={i === 0 ? 'true' : 'false'}
								class="zone-filter-btn ml-2 shrink-0 rounded-pill border border-ink/15 px-4 py-1.5 text-sm font-medium text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink sm:ml-3"
							>
								{f.label}
							</button>
						))}
					</>
				)}

				{deviceOptions.length > 1 && themeOptions.length > 1 && (
					<div class="ml-3 h-6 w-px shrink-0 bg-ink/15 sm:ml-4" aria-hidden="true" />
				)}

				{themeOptions.length > 1 && (
					<>
						<span
							class:list={[
								'shrink-0 text-[11px] font-semibold uppercase tracking-widest text-muted',
								deviceOptions.length > 1 ? 'ml-3 sm:ml-4' : 'zone-filters-first-item pl-6 lg:pl-0',
							]}
						>
							Theme
						</span>
						{themeOptions.map((f, i) => (
							<button
								type="button"
								data-filter-group="theme"
								data-filter-key={f.key}
								data-active={i === 0 ? 'true' : 'false'}
								class="zone-filter-btn ml-2 shrink-0 rounded-pill border border-ink/15 px-4 py-1.5 text-sm font-medium text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink sm:ml-3"
							>
								{f.label}
							</button>
						))}
					</>
				)}

				{/* Trailing spacer so the last pill has a bit of air on the
					right when scrolled to the end. */}
				<div class="w-6 shrink-0 lg:w-0" aria-hidden="true" />
			</div>
		</div>
	)
}

<script>
	const deviceBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="device"]'),
	);
	const themeBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="theme"]'),
	);
	const sections = Array.from(
		document.querySelectorAll<HTMLElement>('section[data-zone-label]'),
	);

	let selectedDevice = 'all';
	let selectedTheme = 'all';

	function apply() {
		deviceBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedDevice ? 'true' : 'false';
		});
		themeBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedTheme ? 'true' : 'false';
		});
		sections.forEach((sec) => {
			const label = (sec.dataset.zoneLabel || '').toLowerCase();
			const matchDevice = selectedDevice === 'all' || label.includes(selectedDevice);
			const matchTheme = selectedTheme === 'all' || label.includes(selectedTheme);
			sec.classList.toggle('hidden', !(matchDevice && matchTheme));
		});
	}

	deviceBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedDevice = b.dataset.filterKey || 'all';
			apply();
		}),
	);
	themeBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedTheme = b.dataset.filterKey || 'all';
			apply();
		}),
	);

	// Sticky detection — toggle `.is-stuck` on the bar when it pins to
	// top-[68px]. IntersectionObserver with rootMargin -69px top fires when
	// the bar's top edge crosses the 68px line under the nav.
	const bar = document.getElementById('zone-filters-bar');
	if (bar && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			([entry]) => {
				bar.classList.toggle('is-stuck', entry.intersectionRatio < 1);
			},
			{ rootMargin: '-69px 0px 0px 0px', threshold: [1] },
		);
		io.observe(bar);
	}
</script>

<style is:global>
	/* Hide the horizontal scrollbar on the filter row while keeping scroll
	   functional (touch swipe / trackpad / scroll wheel). */
	.zone-filters-scroll {
		scrollbar-width: none;
	}
	.zone-filters-scroll::-webkit-scrollbar {
		display: none;
	}

	/* Back arrow reveal + first-item shift animation.

	   Non-sticky (default) : back arrow opacity 0 + translated left, shield
	     still takes flex space but is invisible. First content item has a
	     negative margin-left that absorbs the shield's width → content
	     appears flush at container-left (edge-to-edge viewport on mobile).

	   Sticky (`.is-stuck` added by JS) : back arrow fades in + slides to
	     natural position. First-item margin-left animates to 0 → content
	     shifts right, revealing the visible back arrow.

	   During horizontal scroll (mobile) : back arrow shield is `position:
	     sticky; left: 0` with opaque `bg-bg`, so pills passing behind it are
	     visually hidden by the solid bg strip (68 px wide on mobile). */
	.zone-filters-back {
		opacity: 0;
		transform: translateX(-6px);
		pointer-events: none;
		transition:
			opacity 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: opacity, transform;
	}
	.zone-filters-first-item {
		/* Mobile shield width: 24 pl-6 + 32 button + 12 pr-3 = 68. First item
		   also has pl-6 (24) that overlaps → total negative offset = -68 to
		   land content at container-left (x=0) on non-sticky. Plus its own
		   pl-6 the effective shift = -92 so text lands at x=24 (comfortable
		   inset from viewport edge without touching it). */
		margin-left: -92px;
		transition: margin-left 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: margin-left;
	}
	@media (min-width: 1024px) {
		.zone-filters-first-item {
			/* lg: shield pl-0, so button 32 + pr-3 12 = 44. First item pl-0
			   too. Negative offset = -44 to overlap shield exactly. */
			margin-left: -44px;
		}
	}
	#zone-filters-bar.is-stuck .zone-filters-back {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
	}
	#zone-filters-bar.is-stuck .zone-filters-first-item {
		margin-left: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.zone-filters-back,
		.zone-filters-first-item {
			transition: none !important;
		}
	}
</style>
