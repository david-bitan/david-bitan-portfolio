---
/**
 * Top nav.
 * Five items: Work, AI Lab, Craft (home anchors), About, Contact (pages).
 *
 * Active state:
 *  - /about and /contact → server-side, rendered as <span aria-current="page">
 *  - Home hash links (#work, #ai-lab, #craft) → client-side scroll spy on
 *    the home page: whichever section the user is currently reading gets
 *    `.nav-link-active` promoted onto its <a>. Same look as the server
 *    active state (orange text + underline + not clickable).
 */
const links = [
	{ href: '/#work', label: 'Work', spy: 'work' },
	{ href: '/#ai-lab', label: 'AI Lab', spy: 'ai-lab' },
	{ href: '/#craft', label: 'Craft', spy: 'craft' },
	{ href: '/about', label: 'About', spy: null },
	{ href: '/contact', label: 'Contact', spy: null },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// Server-side active for /about and /contact only. Home hash links get
// their active state from the scroll spy on the client.
function isActive(href: string) {
	if (href === '/about') return pathname === '/about';
	if (href === '/contact') return pathname === '/contact';
	return false;
}
---

<header class="sticky top-0 z-50 border-b border-ink/5 bg-bg">
	<nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-5 lg:px-0">
		<a href="/" class="text-lg font-extrabold tracking-tight">David Bitan</a>

		<div class="hidden items-center gap-8 lg:flex">
			{
				links.map((link) => {
					const active = isActive(link.href);
					const cls = active
						? 'nav-link nav-link-active text-sm font-semibold text-accent'
						: 'nav-link text-sm font-medium text-muted hover:text-ink transition-colors';
					const dataSpy = link.spy ? { 'data-spy': link.spy } : {};
					return active ? (
						<span aria-current="page" class={cls} {...dataSpy}>
							{link.label}
						</span>
					) : (
						<a href={link.href} class={cls} {...dataSpy}>
							{link.label}
						</a>
					);
				})
			}
		</div>

		<div class="flex items-center gap-3">
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle dark mode"
				class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink hover:border-ink/40 transition-colors"
			>
				<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
				</svg>
				<svg id="theme-icon-sun" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
			</button>

			<button
				id="nav-toggle"
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="flex flex-col gap-1.5 p-2 lg:hidden"
		>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
		</button>
		</div>
	</nav>
</header>

<div
	id="mobile-nav"
	class="fixed inset-0 z-[60] flex translate-x-full flex-col items-center justify-center gap-8 bg-bg transition-transform duration-300 ease-out lg:hidden"
>
	<button id="nav-close" type="button" aria-label="Close menu" class="absolute right-6 top-5 p-2">
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>
	{
		links.map((link) => {
			const active = isActive(link.href);
			const cls = active
				? 'mobile-nav-link nav-link-active text-3xl font-semibold text-accent'
				: 'mobile-nav-link text-3xl font-semibold';
			const dataSpy = link.spy ? { 'data-spy-mobile': link.spy } : {};
			return active ? (
				<span aria-current="page" class={cls} {...dataSpy}>
					{link.label}
				</span>
			) : (
				<a href={link.href} class={cls} {...dataSpy}>
					{link.label}
				</a>
			);
		})
	}
</div>

<style>
	/* Active nav item — orange text + underline bar + non-clickable.
	   Applies to both <span aria-current> (server-rendered for /about,
	   /contact) and <a> promoted by the scroll spy on the home page. */
	.nav-link-active {
		position: relative;
		color: var(--color-accent) !important;
		cursor: default;
		pointer-events: none;
	}
	.nav-link-active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
	}
</style>

<script>
	// --- Mobile menu open/close ---
	const toggle = document.getElementById('nav-toggle');
	const close = document.getElementById('nav-close');
	const overlay = document.getElementById('mobile-nav');

	function openMenu() {
		overlay?.classList.remove('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}
	function closeMenu() {
		overlay?.classList.add('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}
	toggle?.addEventListener('click', openMenu);
	close?.addEventListener('click', closeMenu);
	overlay?.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));

	// --- Theme toggle ---
	const themeToggle = document.getElementById('theme-toggle');
	const moonIcon = document.getElementById('theme-icon-moon');
	const sunIcon = document.getElementById('theme-icon-sun');

	function syncThemeIcon() {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		moonIcon?.classList.toggle('hidden', isDark);
		sunIcon?.classList.toggle('hidden', !isDark);
	}
	syncThemeIcon();

	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		if (isDark) {
			document.documentElement.removeAttribute('data-theme');
			localStorage.setItem('theme', 'light');
		} else {
			document.documentElement.setAttribute('data-theme', 'dark');
			localStorage.setItem('theme', 'dark');
		}
		syncThemeIcon();
	});

	// --- Scroll spy (home only) ---
	// Not IntersectionObserver — plain scroll listener with a small rAF
	// throttle. We compute which section top is closest above an activation
	// line placed ~120px under the nav (so the flip happens as the section
	// heading crosses under the nav). Simpler and more predictable than
	// IO rootMargin tuning at page top/bottom edges.
	(function initScrollSpy() {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		if (path !== '/') return;

		const spyLinks = new Map();
		document.querySelectorAll('[data-spy]').forEach((el) => {
			spyLinks.set(el.getAttribute('data-spy'), el);
		});
		document.querySelectorAll('[data-spy-mobile]').forEach((el) => {
			// Store mobile counterparts under a distinct key so setActive
			// can find both together.
			const id = el.getAttribute('data-spy-mobile');
			const bucket = spyLinks.get(id + ':all') || [spyLinks.get(id)].filter(Boolean);
			bucket.push(el);
			spyLinks.set(id + ':all', bucket);
		});

		const sectionIds = ['work', 'ai-lab', 'craft'];
		const sections = sectionIds
			.map((id) => ({ id, el: document.getElementById(id) }))
			.filter((s) => s.el);
		if (!sections.length) return;

		let currentId = null;

		function applyActive(el, active) {
			if (!el) return;
			if (active) {
				el.classList.add('nav-link-active', 'text-accent', 'font-semibold');
				el.classList.remove('text-muted', 'hover:text-ink', 'transition-colors', 'font-medium');
			} else {
				el.classList.remove('nav-link-active', 'text-accent');
				// Desktop-only default classes — mobile links stay font-semibold.
				if (el.classList.contains('nav-link')) {
					el.classList.add('text-muted', 'hover:text-ink', 'transition-colors', 'font-medium');
					el.classList.remove('font-semibold');
				}
			}
		}

		function setActive(id) {
			if (id === currentId) return;
			currentId = id;
			sectionIds.forEach((sid) => {
				const bucket = spyLinks.get(sid + ':all');
				if (bucket) {
					bucket.forEach((el) => applyActive(el, sid === id));
				} else {
					// Fallback if mobile counterpart is missing
					applyActive(spyLinks.get(sid), sid === id);
				}
			});
		}

		function pickActive() {
			// Activation line: 140px under the top of the viewport (~ nav
			// height + a small buffer). Section is "current" when its top
			// is at or above the line and next section's top is below.
			const line = 140;
			let picked = sections[0].id;
			for (let i = 0; i < sections.length; i++) {
				const top = sections[i].el.getBoundingClientRect().top;
				if (top <= line) {
					picked = sections[i].id;
				} else {
					break;
				}
			}
			setActive(picked);
		}

		let ticking = false;
		function onScroll() {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(() => {
				pickActive();
				ticking = false;
			});
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		// Run once on load so the initial paint has an active item.
		pickActive();
	})();
</script>
