---
// Sticky pill filter bar for the /craft page.
// - `All` is always present and active by default.
// - Categories are passed in from the caller (built from craftItems), so
//   adding a new category to the data source (Digital Painting, 3D, Drawing,
//   Icons, ...) automatically adds a new pill here — no code change needed.
// - Filtering is client-side: toggles `.hidden` on `<figure data-category="...">`.

interface Props {
	categories: string[];
}
const { categories } = Astro.props;
---

<div
	id="craft-filters"
	class="sticky top-[68px] z-30 border-y border-ink/10 bg-bg/95 backdrop-blur"
>
	<div class="relative mx-auto max-w-[1200px] px-6 py-4">
		{/* Back-to-home link — appears only when the bar becomes sticky
			(user scrolled past its natural position). Slides in from the
			left with a fade, and pushes the pill row to the right via
			padding-left transition. */}
		<a
			href="/#craft"
			aria-label="Back to home"
			class="craft-filters-back absolute left-6 top-1/2 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/15 text-muted hover:border-accent hover:text-accent"
		>
			<svg
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="h-4 w-4"
			>
				<path d="M15 18l-6-6 6-6" />
			</svg>
		</a>
		<div class="craft-filters-content flex flex-wrap items-center gap-2">
			<button
				type="button"
				data-craft-filter="__all__"
				class="craft-filter-btn cursor-pointer rounded-pill border border-ink/15 bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors"
				aria-pressed="true"
			>
				All
			</button>
			{
				categories.map((cat) => (
					<button
						type="button"
						data-craft-filter={cat}
						class="craft-filter-btn cursor-pointer rounded-pill border border-ink/15 bg-transparent px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
						aria-pressed="false"
					>
						{cat}
					</button>
				))
			}
		</div>
	</div>
</div>

<script>
	// Craft filters: wire up click handlers once the DOM is ready. Uses
	// `type="module"` (Astro default when no `is:inline`) which is
	// automatically deferred — runs after the whole HTML is parsed, so
	// `.craft-figure` selectors below the filter bar are already in the DOM.
	//
	// Previous bug: `<script is:inline>` in this component ran in-place,
	// BEFORE the figures rendered further down in craft.astro. `figures`
	// was empty and the early return killed all click handlers, giving
	// the impression the filter did nothing.
	const buttons = document.querySelectorAll<HTMLButtonElement>('.craft-filter-btn');
	const figures = document.querySelectorAll<HTMLElement>('.craft-figure');

	if (buttons.length && figures.length) {
		const ACTIVE_ADD = ['bg-accent', 'text-accent-ink'];
		const ACTIVE_REMOVE = ['bg-transparent', 'text-ink', 'hover:border-accent', 'hover:text-accent'];

		function apply(filter: string) {
			figures.forEach((f) => {
				const cat = f.dataset.category;
				const show = filter === '__all__' || cat === filter;
				f.classList.toggle('hidden', !show);
			});
			buttons.forEach((b) => {
				const active = b.dataset.craftFilter === filter;
				b.setAttribute('aria-pressed', String(active));
				if (active) {
					b.classList.add(...ACTIVE_ADD);
					b.classList.remove(...ACTIVE_REMOVE);
				} else {
					b.classList.remove(...ACTIVE_ADD);
					b.classList.add(...ACTIVE_REMOVE);
				}
			});
		}

		buttons.forEach((b) => {
			b.addEventListener('click', () => {
				const key = b.dataset.craftFilter;
				if (key) apply(key);
			});
		});
	}

	// Sticky detection — same pattern as ZoneFilters. Toggle .is-stuck
	// on the bar when it pins under the nav. The back arrow + content
	// padding animate off that class (see <style is:global> below).
	const bar = document.getElementById('craft-filters');
	if (bar && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			([entry]) => {
				bar.classList.toggle('is-stuck', entry.intersectionRatio < 1);
			},
			{ rootMargin: '-69px 0px 0px 0px', threshold: [1] },
		);
		io.observe(bar);
	}
</script>

<style is:global>
	/* Transitions defined here (not via Tailwind arbitrary classes)
	   because arbitrary values with commas — ease-[cubic-bezier(...)] —
	   get dropped by the JIT scanner. */
	.craft-filters-back {
		opacity: 0;
		transform: translateY(-50%) translateX(-6px);
		pointer-events: none;
		transition:
			opacity 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			border-color 200ms ease,
			color 200ms ease;
		will-change: opacity, transform;
	}
	.craft-filters-content {
		padding-left: 0;
		transition: padding-left 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: padding-left;
	}
	#craft-filters.is-stuck .craft-filters-back {
		opacity: 1;
		transform: translateY(-50%) translateX(0);
		pointer-events: auto;
	}
	#craft-filters.is-stuck .craft-filters-content {
		padding-left: 48px;
	}
	@media (prefers-reduced-motion: reduce) {
		.craft-filters-back,
		.craft-filters-content {
			transition: none !important;
		}
	}
</style>
