---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — David Bitan">
	<Nav />

	<section class="mx-auto flex min-h-[70vh] max-w-[1200px] flex-col items-center justify-center px-6 text-center">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">404</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">
			This page doesn't exist<span class="text-accent">.</span>
		</h1>
		<p class="mt-6 max-w-md text-lg text-muted">
			The link might be broken, or the page moved. Let's get you back on track.
		</p>

		<div class="mt-10 flex flex-col gap-4 sm:flex-row">
			<a
				href="/"
				class="rounded-pill bg-accent px-7 py-3.5 text-center text-sm font-semibold text-accent-ink hover:bg-ink transition-colors"
			>
				Back home
			</a>
			<a
				href="/contact"
				class="rounded-pill border border-ink/15 px-7 py-3.5 text-center text-sm font-semibold hover:border-ink/40 transition-colors"
			>
				Get in touch
			</a>
		</div>
	</section>

	<Footer />
</Layout>
