---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Dedicated page for the "how this site was built" story. Linked from the
// /about AI section + the footer micro-mention. Kept medium-length (2-3
// screens): stack + role split + build stats + brief case study.

const stack = [
	{ label: 'Framework', value: 'Astro 7', why: 'Static-first, zero JS by default, content-focused. Ships lightweight HTML.' },
	{ label: 'Styling', value: 'Tailwind CSS 4', why: 'Design tokens in CSS, no config file, tree-shaken to a tiny bundle.' },
	{ label: 'Images', value: 'Cloudinary', why: '260+ WebP assets, on-the-fly transforms, DPR-aware srcsets for retina.' },
	{ label: 'Hosting', value: 'Cloudflare Pages', why: 'Free tier, global CDN, HTTPS out of the box, auto-deploys from GitHub.' },
	{ label: 'Source', value: 'GitHub', why: 'Version control + trigger for Cloudflare Pages builds.' },
	{ label: 'Editor', value: 'VS Code + Cowork (Claude)', why: 'Local editing plus a Claude session with file + shell access.' },
];

const claudeDid = [
	'Wrote most of the Astro + Tailwind code, refactored as the design evolved.',
	'Debugged obscure CSS + build issues (rolldown native bindings, corner-shape support, srcset breakpoints).',
	'Kept a versioned archive of every edit for one-click rollback (46+ snapshots).',
	'Suggested UX improvements: pill filters, Load More coordination, dark-first ordering.',
	'Maintained the session memory file so a fresh chat resumes exactly where we left off.',
];

const davidDid = [
	'Set the direction: audience, tone, project selection, editorial angle.',
	'Reviewed every visual change in the browser, called out what didn\'t work.',
	'Managed the Figma exports, Cloudinary uploads, and the Google Sheet CMS.',
	'Held the taste line: rejected the phone-mockup bezel experiment, kept the Behance grid.',
	'Ran every git push from PowerShell (Cowork sandbox blocks HTTPS to GitHub).',
];

// `sub` shown below the label for context. Kept optional so short stats
// stay clean.
type BuildStat = { n: string; label: string; sub?: string };

const buildStats: BuildStat[] = [
	{ n: '~2 weeks', label: 'From empty repo to live site', sub: 'Real elapsed time — capped by daily Claude session + token limits' },
	{ n: '75+', label: 'Iteration checkpoints tracked locally' },
	{ n: '17', label: 'Pages designed + coded' },
	{ n: 'Solo', label: 'Designer + AI-assisted dev' },
];

// Design tokens actually shipped — kept in sync with src/styles/global.css.
// Split into two blocks so the layout reads as "colors first, then shape".
const palette = [
	{ swatch: '#F3F4F6', name: 'Background', role: 'Near-white canvas — launchnow.design-inspired, easy on the eyes' },
	{ swatch: '#0A0A0A', name: 'Ink', role: 'Body copy + headlines, high contrast on the light bg' },
	{ swatch: '#4B5563', name: 'Muted', role: 'Secondary text, metadata, captions' },
	{ swatch: '#F25C24', name: 'Accent', role: 'CTAs, links, active states — preserved in both light + dark' },
	{ swatch: '#1C1B1A', name: 'Footer / Dark bg', role: 'Warm charcoal (Claude-interface family), not navy or pure black' },
];

const shape = [
	{ label: 'Typeface', value: 'Manrope 400 / 500 / 700 / 800', why: 'Geometric sans with tight tracking on headlines — modern without being sterile.' },
	{ label: 'Radius', value: '8px · 12px · pill', why: 'Buttons 8, cards 12, CTAs full-round. Kept small tokens; no random values.' },
	{ label: 'Corners', value: 'Squircle (superellipse 3)', why: 'iOS-style corner-shape on rounded cards where supported — quiet upgrade, falls back to normal radius elsewhere.' },
	{ label: 'Dark mode', value: 'Warm charcoal, orange kept', why: 'Same family as the footer — never navy. Accent orange is identical in both modes, so the brand reads the same.' },
];

const method = [
	{
		title: 'Pair with Claude via Cowork',
		body: 'Claude has direct file + shell access to the repo. I keep the taste line and review every change in-browser; Claude writes the code, debugs, and proposes UX improvements.',
	},
	{
		title: 'Versioned local archives before every edit',
		body: 'Each substantive change gets a numbered snapshot in `/archives/vNNN_.../` with a README and the exact rollback command. 75+ checkpoints so far — one-click revert whenever an experiment does not land.',
	},
	{
		title: 'Session memory file',
		body: 'A `contexte-portfolio.md` living outside the repo carries decisions, patterns, and next steps across chat sessions. Every new session starts by re-reading it; no restart cost.',
	},
	{
		title: 'Content in Google Sheets, code in Astro',
		body: 'Projects, craft items, timeline and metadata live in a five-tab spreadsheet, parsed by a TypeScript layer at build time. Edit the sheet, rebuild, ship — no CMS to host.',
	},
	{
		title: 'Behance-informed layout, own tokens',
		body: 'Grid + case-study format inspired by Behance; visual tokens come from launchnow.design as a starting point, then narrowed down to what this site actually needs.',
	},
	{
		title: 'Ship in phases, review live',
		body: 'Work sequenced as focused phases (nav → layout → interactions → SEO/backend). Each phase is built, pushed, reviewed on the live URL, then the next phase starts.',
	},
];
---

<Layout title="Colophon — How this site was built">
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/about" class="text-sm font-semibold text-accent hover:underline">← Back to About</a>
		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">Colophon</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			How this site was built.
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted">
			A short, honest breakdown of the stack, the workflow, and who did what.
			The AI-augmented workflow this portfolio talks about is the same one that shipped it.
		</p>
	</article>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">The stack</h2>
		<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				stack.map((s) => (
					<div class="rounded-lg border border-ink/10 bg-card p-6">
						<p class="text-xs font-semibold uppercase tracking-widest text-muted">{s.label}</p>
						<p class="mt-2 text-lg font-bold">{s.value}</p>
						<p class="mt-2 text-sm text-muted">{s.why}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Design system</h2>
		<p class="mt-4 max-w-2xl text-muted">
			A small, opinionated set of tokens shared across every page — the same values
			live in <code class="rounded bg-ink/5 px-1.5 py-0.5 text-sm">global.css</code>.
		</p>

		<h3 class="mt-10 text-sm font-semibold uppercase tracking-widest text-muted">Palette</h3>
		<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
			{
				palette.map((c) => (
					<div class="rounded-lg border border-ink/10 bg-card p-4">
						<div
							class="h-16 w-full rounded-md ring-1 ring-ink/10"
							style={`background-color: ${c.swatch};`}
							aria-hidden="true"
						/>
						<p class="mt-3 text-sm font-bold">{c.name}</p>
						<p class="mt-1 font-mono text-xs uppercase text-muted">{c.swatch}</p>
						<p class="mt-2 text-xs text-muted/90">{c.role}</p>
					</div>
				))
			}
		</div>

		<h3 class="mt-12 text-sm font-semibold uppercase tracking-widest text-muted">Type, shape, mode</h3>
		<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				shape.map((s) => (
					<div class="rounded-lg border border-ink/10 bg-card p-6">
						<p class="text-xs font-semibold uppercase tracking-widest text-muted">{s.label}</p>
						<p class="mt-2 text-lg font-bold">{s.value}</p>
						<p class="mt-2 text-sm text-muted">{s.why}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Method</h2>
		<p class="mt-4 max-w-2xl text-muted">
			How the work actually got done — the process behind the pixels.
		</p>
		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				method.map((m) => (
					<div class="rounded-lg border border-ink/10 bg-card p-6">
						<p class="text-base font-bold text-ink">{m.title}</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">{m.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Who did what</h2>
		<p class="mt-4 max-w-2xl text-muted">
			Pair-designing with an AI isn't magic — it's a division of labor. Here's how the
			work actually split.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
			<div class="rounded-lg border border-ink/10 bg-card p-8">
				<p class="text-sm font-semibold uppercase tracking-widest text-accent">Claude did</p>
				<ul class="mt-5 flex flex-col gap-3">
					{
						claudeDid.map((line) => (
							<li class="flex items-start gap-3 text-muted">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
								<span>{line}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="rounded-lg border border-ink/10 bg-card p-8">
				<p class="text-sm font-semibold uppercase tracking-widest text-accent">I did</p>
				<ul class="mt-5 flex flex-col gap-3">
					{
						davidDid.map((line) => (
							<li class="flex items-start gap-3 text-muted">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
								<span>{line}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Build stats</h2>
		<div class="mt-10 grid grid-cols-2 gap-8 sm:grid-cols-4">
			{
				buildStats.map((s) => (
					<div>
						<p class="text-3xl font-extrabold tracking-tight sm:text-4xl">{s.n}</p>
						<p class="mt-2 text-sm text-muted">{s.label}</p>
						{s.sub && <p class="mt-1 text-xs text-muted/80">{s.sub}</p>}
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">A note on honesty</h2>
		<div class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
			<p>
				Every project shown here was designed by hand — Figma today, Adobe XD before that,
				Photoshop and Illustrator in the earlier years — plus Cinema 4D, ZBrush,
				After Effects and Spline for motion and 3D.
			</p>
			<p>
				What changed in 2025-2026 is <em>how</em> I ship the surface around the work —
				this portfolio, its filters, its case-study pages — not the design craft itself.
			</p>
			<p>
				If you want to see the same workflow applied to your product, that's exactly what
				the <a href="/#work" class="text-accent hover:underline">Selected work</a> section
				is about.
			</p>
		</div>
	</section>

	<Footer />
</Layout>
