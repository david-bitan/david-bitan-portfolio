---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CraftFilters from '../components/CraftFilters.astro';
import { craftItems } from '../data/craftItems';
import { cld, FULL, landscapeSrcset } from '../lib/cloudinary';

// Distinct categories in first-appearance order — auto-updates when the data
// source gets new categories (Drawings, Icons, etc.).
const categories = Array.from(new Set(craftItems.map((i) => i.category)));
---

<Layout title="Personal work — David Bitan">
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/#craft" class="text-sm font-semibold text-accent hover:underline">← Back</a>
		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">Craft</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			Personal work
		</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">
			3D renders and digital painting — outside the product work. Use the filters
			to focus on a single medium.
		</p>
	</article>

	<CraftFilters categories={categories} />

	<div class="mx-auto max-w-[1200px] px-6">
		<div class="mt-16 space-y-16">
			{
				craftItems.map((item) => (
					<figure
						id={item.slug}
						data-category={item.category}
						class="craft-figure scroll-mt-32"
					>
						<img
							src={cld(item.image, FULL)}
							srcset={landscapeSrcset(item.image)}
							sizes="(min-width: 1280px) 1200px, 100vw"
							alt={item.title}
							loading="lazy"
							class="block h-auto w-full rounded-md"
						/>
						<figcaption class="mt-4 flex flex-wrap items-baseline gap-x-4">
							<h2 class="text-lg font-bold tracking-tight text-ink">{item.title}</h2>
							<span class="text-sm text-muted">
								{item.category} · {item.year}
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>

	<div class="pb-24"></div>
	<Footer />
</Layout>
