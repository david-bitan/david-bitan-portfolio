---
// `sub` is optional — shown below the label when present. Used for the
// Cactus stat to make the team-contributor context explicit (honesty pass
// 2026-08-06 — a Cactus is a team award, not a solo one).
type Metric = { value: string; label: string; sub?: string };

const metrics: Metric[] = [
	{ value: '20+', label: 'Years experience' },
	{ value: '6', label: 'Industries' },
	{ value: '12+', label: 'Cactus awards in 5 years', sub: 'Publicis Group · team contributor' },
	{ value: '100+', label: 'Shipped features' },
];
---

<section class="border-y border-ink/5" data-reveal>
	<div class="mx-auto grid max-w-[1200px] grid-cols-2 gap-y-10 px-6 py-14 sm:grid-cols-4">
		{
			metrics.map((metric) => (
				<div class="px-3 text-center sm:border-l sm:border-ink/5 sm:first:border-l-0">
					<p class="text-4xl font-extrabold tracking-tight sm:text-5xl">{metric.value}</p>
					<p class="mt-2 text-sm text-muted">{metric.label}</p>
					{metric.sub && (
						<p class="mt-1 text-xs text-muted/80">{metric.sub}</p>
					)}
				</div>
			))
		}
	</div>
</section>
