---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import { allProjects } from '../../data/allProjects';
import { cld, FULL, MOBILE, landscapeSrcset, mobileSrcset } from '../../lib/cloudinary';
import { groupImagesByZone, zoneDescription } from '../../lib/zones';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
// Phase D — Behance-style layout: each project page is split into responsive
// "zones" (Desktop·Light / Desktop·Dark / Mobile·Light / Mobile·Dark for
// Sonary Dashboard; Desktop / Mobile for simpler projects; a single Gallery
// for legacy Wix imports). See src/lib/zones.ts for the classifier.
// No in-page lightbox — clicking an image opens the full Cloudinary URL in a
// new tab so the visitor gets the browser's native zoom / download UI.
const zones = groupImagesByZone(project.gallery);
---

<Layout title={`${project.title} — David Bitan`}>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/#work" class="text-sm font-semibold text-accent hover:underline">← Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.shortDesc}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Client</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		<div class="mt-6 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-pill bg-card px-3 py-1 text-xs font-medium text-muted">{tag}</span>
				))
			}
		</div>

		<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed text-ink">{project.fullDesc}</p>
	</article>

	<ZoneFilters zones={zones} />

	{
		zones.map((zone) => (
			<section
				data-zone-label={zone.label}
				class="mx-auto mt-24 max-w-[1200px] scroll-mt-32 border-t border-ink/10 px-6 pt-24"
				data-reveal
			>
				<header class="grid grid-cols-12 gap-8">
					<h2 class="col-span-12 text-3xl font-extrabold tracking-tight text-ink sm:col-span-4 sm:text-4xl">
						{zone.label}
					</h2>
					<p class="col-span-12 text-lg leading-relaxed text-muted sm:col-span-6 sm:col-start-7">
						{zoneDescription(zone.label, zone.images.length)}
					</p>
				</header>

				{
					zone.isMobile ? (
						// Mobile shots at their true native width (375px CSS). A 2-col
						// grid on ≥sm gives each phone shot a generous card around it
						// (bg-card + p-8). Images are NOT clickable — David's rule:
						// clicking opened a new tab with the source URL, but on mobile
						// designs the browser upscaled the 375px source to fill the
						// window, which looked awful and also broke the "stay on site"
						// UX. In-page is the final render.
						<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
							{zone.images.map(({ url }) => (
								// bg-card (#fff in light) sits on top of a gray-100 body,
								// which is a barely-there contrast; and mockups with
								// white-page designs (Sonary Website light-mode reviews,
								// article pages, etc.) melt into the card. `shadow-md +
								// border-ink/10` lifts the card off the page, and the
								// `ring-1 ring-ink/10` on the image itself draws a
								// hairline outline around the mockup so its own edges are
								// legible regardless of its inner colors.
								<div class="flex items-start justify-center overflow-hidden rounded-lg border border-ink/10 bg-card p-6 shadow-md sm:p-8">
									<img
										src={cld(url, MOBILE)}
										srcset={mobileSrcset(url)}
										sizes="375px"
										alt={project.title}
										loading="lazy"
										width="375"
										class="mx-auto h-auto w-[375px] max-w-full rounded-md ring-1 ring-ink/10"
									/>
								</div>
							))}
						</div>
					) : (
						// Desktop shots: stacked full-width, one per row. srcset covers
						// 2K/4K/retina without upscaling a 1200px asset.
						// NO rounded corners and NO bg on the wrapper — corners would
						// clip whatever pixels are at the mockup's actual edges and
						// leak the site background through (dark strip in dark mode).
						// Straight edges let each mockup's own native shape (rounded
						// or not) show through unmodified. Not clickable (same reason
						// as mobile — no source-upscale in a new tab).
						<div class="mt-12 space-y-10">
							{zone.images.map(({ url }) => (
								<div class="w-full">
									<img
										src={cld(url, FULL)}
										srcset={landscapeSrcset(url)}
										sizes="(min-width: 1280px) 1200px, 100vw"
										alt={project.title}
										loading="lazy"
										class="block h-auto w-full"
									/>
								</div>
							))}
						</div>
					)
				}
			</section>
		))
	}

	<div class="pb-24"></div>

	<Footer />
</Layout>
