---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import { allProjects } from '../../data/allProjects';
import { cld, FULL, NATIVE, landscapeSrcset } from '../../lib/cloudinary';
import { groupImagesByZone, zoneDescription } from '../../lib/zones';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
// Phase D — Behance-style layout: each project page is split into responsive
// "zones" (Desktop·Light / Desktop·Dark / Mobile·Light / Mobile·Dark for
// Sonary Dashboard; Desktop / Mobile for simpler projects; a single Gallery
// for legacy Wix imports). See src/lib/zones.ts for the classifier.
const zones = groupImagesByZone(project.gallery);
---

<Layout title={`${project.title} — David Bitan`}>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20" data-reveal>
		<a href="/#work" class="text-sm font-semibold text-accent hover:underline">← Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.shortDesc}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Client</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		<div class="mt-6 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-pill bg-card px-3 py-1 text-xs font-medium text-muted">{tag}</span>
				))
			}
		</div>

		<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed text-ink">{project.fullDesc}</p>
	</article>

	<div class="mx-auto max-w-[1200px] px-6">
		<ZoneFilters zones={zones} />
	</div>

	{
		zones.map((zone) => (
			<section
				data-zone-label={zone.label}
				class="mx-auto mt-24 max-w-[1200px] scroll-mt-32 border-t border-ink/10 px-6 pt-24"
				data-reveal
			>
				<header class="grid grid-cols-12 gap-8">
					<h2 class="col-span-12 text-3xl font-extrabold tracking-tight text-ink sm:col-span-4 sm:text-4xl">
						{zone.label}
					</h2>
					<p class="col-span-12 text-lg leading-relaxed text-muted sm:col-span-6 sm:col-start-7">
						{zoneDescription(zone.label, zone.images.length)}
					</p>
				</header>

				{
					zone.isMobile ? (
						// Mobile shots at their native size. Each tile is a padded card
						// (bg-card) with the phone screenshot centered at max-w-[280px].
						// NATIVE preset uses c_limit,w_800 so Cloudinary never upscales
						// past the source (typically 375px wide) — zero interpolation,
						// crisp on every DPR. The tile gets breathing room instead of
						// being stretched full-width, which is what caused the previous
						// "pixellated / soft" look.
						<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
							{zone.images.map(({ url, globalIndex }) => (
								<button
									type="button"
									data-lightbox-trigger={globalIndex}
									class="group flex items-start justify-center overflow-hidden rounded-lg bg-card p-6 transition-transform hover:scale-[1.01] sm:p-8"
								>
									<img
										src={cld(url, NATIVE)}
										alt={project.title}
										loading="lazy"
										class="h-auto w-full max-w-[280px]"
									/>
								</button>
							))}
						</div>
					) : (
						// Desktop shots: stacked full-width, one per row. Uses the same
						// srcset the lightbox uses so 2K/4K/retina all get a matching
						// resolution instead of upscaling a 1200px asset.
						<div class="mt-12 space-y-10">
							{zone.images.map(({ url, globalIndex }) => (
								<button
									type="button"
									data-lightbox-trigger={globalIndex}
									class="block w-full overflow-hidden rounded-lg bg-card"
								>
									<img
										src={cld(url, FULL)}
										srcset={landscapeSrcset(url)}
										sizes="(min-width: 1280px) 1200px, 100vw"
										alt={project.title}
										loading="lazy"
										class="h-auto w-full"
									/>
								</button>
							))}
						</div>
					)
				}
			</section>
		))
	}

	<div class="pb-24"></div>

	<Lightbox images={project.gallery} title={project.title} />
	<Footer />
</Layout>
