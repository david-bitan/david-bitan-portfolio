---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import { imageSizes } from '../../data/imageSizes';
import { allProjects } from '../../data/allProjects';
import { cld, FULL, LANDSCAPE, landscapeSrcset, sizeOf, fullSrcset } from '../../lib/cloudinary';
import { groupImagesByZone, zoneDescription } from '../../lib/zones';
import { caseLines, nextOf, WORK_ORDER } from '../../data/caseLines';
import CaseLines from '../../components/CaseLines.astro';

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const lines = caseLines[project.slug];
const nextSlug = nextOf(project.slug, WORK_ORDER);
const next = nextSlug ? allProjects.find((p) => p.slug === nextSlug) : null;
// Étape 14, ajout 1 (S33): the page text comes from pageIntro when there is
// one (it already spells out UKGC on Playright); shortDesc stays for the cards.
const intro = project.pageIntro ?? project.shortDesc;
// Phase D — Behance-style layout: each project page is split into responsive
// "zones" (Desktop·Light / Desktop·Dark / Mobile·Light / Mobile·Dark for
// Sonary Dashboard; Desktop / Mobile for simpler projects; a single Gallery
// for legacy Wix imports). See src/lib/zones.ts for the classifier.
// No in-page lightbox — clicking an image opens the full Cloudinary URL in a
// new tab so the visitor gets the browser’s native zoom / download UI.
const zones = groupImagesByZone(project.gallery, project.imageDeviceOverrides);
// Desktop items narrower than 900px whose size is known (email templates)
// go to the masonry gallery under the full-width stack (CL2, 13/11).
const isNarrow = (url: string) => {
	const s = sizeOf(url, imageSizes);
	return !!s && s[0] < 900;
};

// SEO — per-project meta. Description falls back to shortDesc; OG image is
// the same landscape thumbnail crop used on the Selected Work grid so social
// previews match what the visitor already saw in the referring context.
const seoDescription = project.shortDesc;
const seoOgImage = cld(project.thumbnail, LANDSCAPE);

// Schema.org CreativeWork — surfaces the case study to search engines as a
// discrete piece of work with a creator, image and year. `about` reflects the
// primary category; `keywords` reuses the visible tag list so the JSON-LD and
// the on-page pill row can’t drift out of sync.
const projectJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.shortDesc,
	creator: {
		'@type': 'Person',
		name: 'David Bitan',
	},
	about: project.category,
	keywords: project.tags.join(', '),
	image: seoOgImage,
	dateCreated: project.year,
	...(project.client ? { publisher: { '@type': 'Organization', name: project.client } } : {}),
	...(project.liveUrl ? { url: project.liveUrl } : {}),
};
import ProjectTopVisual from '../../components/ProjectTopVisual.astro';
import { topLayouts } from '../../data/topVisuals';
const visual = topLayouts[project.slug];
---

<Layout
	title={`${project.title} · David Bitan`}
	description={seoDescription}
	ogImage={seoOgImage}
	structuredData={projectJsonLd}
>
	<Nav />
	<main id="main" tabindex="-1">

	<article class="mx-auto max-w-[1200px] px-6 pt-4 sm:pt-5 min-[1248px]:px-0" data-reveal>
		<a href="/#work" data-top-back class="text-sm font-semibold text-accent-text hover:underline"><span class="arr-back" aria-hidden="true">→</span>Back to work</a>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">{project.category}</p>
		{/* Étape 14, ajout 1: the text on the left, the composition over the
		    right part (desktop); phones: the composition under the text. */}
		<div class="ptv-hero mt-4" data-ptv-hero={visual ? '' : undefined}>
		<div class="ptv-text">
		<h1 class="max-w-3xl text-[1.85rem] font-extrabold tracking-tight min-[374px]:text-4xl sm:text-5xl">{project.title}</h1>
		<p class="mt-4 max-w-2xl proj-intro">{intro}</p>

		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
			<span><span class="font-semibold text-ink">Company</span> · {project.client}</span>
			<span><span class="font-semibold text-ink">Year</span> · {project.year}</span>
		</div>

		{/* Tags as plain text with separators: they aren’t clickable, so they
		    must not look like pills or buttons (David’s rule). */}
		<p class="mt-4 text-sm text-muted">{project.tags.join(' · ')}</p>
		</div>

		{visual && <ProjectTopVisual slug={project.slug} />}
		</div>

		{/* Étape 14, ajout 1 (S33): Challenge · What I did · Result · Role, full width */}
		{lines && <div class="mt-sec"><CaseLines lines={lines} /></div>}

		{project.scope && (
			<>
			{/* Étape 15, S46: a thin rule between the 4 columns and Scope. */}
			{lines && <hr class="sec-rule" />}
			<section class:list={['scope-block', { 'mt-sec': !lines }]} aria-labelledby="scope-heading">
				<h2 id="scope-heading" class="text-sm font-semibold uppercase tracking-widest text-muted">Scope</h2>
				{/* Plain text with markers, never pills: these are facts to read,
				    not filters to click. */}
				{/* Étape 15, S47: the same 4-column grid as Challenge · What I did ·
				    Result · Role (2 × 2 on tablets, stacked on phones). */}
				<ul class="scope-grid mt-title">
					{project.scope.map((item) => (
						<li class="flex items-start gap-3 proj-long">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
							<span>{item}</span>
						</li>
					))}
				</ul>
			</section>
			</>
		)}

		{
			/* Rich case study: kept collapsed by default so mockup images can
			   sit above the fold. A "Read the full case study" toggle expands
			   the sections and switches to "Show less". Falls back to the
			   legacy fullDesc paragraph when sections are absent. */
			project.sections ? (
				<div class="mt-btn max-w-3xl">
					{/* Étape 11, 6: once open, a "Show less" sits where "Read the full
					    case study" was; the one under the text stays as it was. */}
					<button
						type="button"
						id="case-study-toggle-top"
						aria-controls="case-study-body"
						aria-expanded="true"
						hidden
						class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent-text hover:underline sm:mb-8"
					>
						<span>Show less</span>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4"
							style="transform: rotate(180deg)"
						>
							<path d="M6 9l6 6 6-6" />
						</svg>
					</button>
					<div
						id="case-study-body"
						class="case-study-body"
						aria-hidden="true"
						inert
					>
						{project.sections.map((section) => (
							<section class="mt-10 first:mt-0">
								<h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">{section.heading}</h2>
								<div class="mt-4 space-y-4 leading-relaxed proj-long">
									{section.body
										.split(/\n\s*\n/)
										.map((para) => (
											<p>{para.trim()}</p>
										))}
								</div>
							</section>
						))}
						{project.liveUrl && (
							<div class="mt-10">
								{project.liveUrlNote && (
									<p class="mb-3 text-sm text-muted">{project.liveUrlNote}</p>
								)}
								<a
									href={project.liveUrl}
									target="_blank"
									rel="noopener"
									class="inline-flex items-center gap-2 rounded-pill bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-colors hover:bg-ink hover:text-bg"
								>
									Visit live site
									<svg
										aria-hidden="true"
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.4"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="h-4 w-4"
									>
										<path d="M5 12h14" />
										<path d="M13 5l7 7-7 7" />
									</svg>
								</a>
							</div>
						)}
					</div>

					<button
						type="button"
						id="case-study-toggle"
						aria-controls="case-study-body"
						aria-expanded="false"
						class="mt-0 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent-text hover:underline aria-expanded:mt-6 sm:aria-expanded:mt-8"
					>
						<span data-toggle-label>Read the full case study</span>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4 transition-transform"
							data-toggle-chevron
						>
							<path d="M6 9l6 6 6-6" />
						</svg>
					</button>
				</div>
			) : project.fullDesc ? (
				<p class="mt-10 max-w-3xl whitespace-pre-line leading-relaxed proj-long">{project.fullDesc}</p>
			) : null
		}
	</article>

	<style>
		/* Accordion body: animate expand/collapse using measured scrollHeight
		   set inline by the toggle script. Fallback to auto so the layout
		   still works without JS. Étape 12, 8 (David’s law): it opens AND
		   closes smoothly, height + fade, same duration and curve both ways. */
		.case-study-body {
			overflow: hidden;
			max-height: 0;
			opacity: 0;
			/* closing: a touch quicker than opening */
			transition:
				max-height 350ms cubic-bezier(0.22, 0.61, 0.36, 1),
				opacity 250ms ease-out;
		}
		.case-study-body[aria-hidden='false'] {
			opacity: 1;
			transition:
				max-height 450ms cubic-bezier(0.22, 0.61, 0.36, 1),
				opacity 300ms ease-out 100ms;
		}
		@media (prefers-reduced-motion: reduce) {
			.case-study-body,
			.case-study-body[aria-hidden='false'] {
				transition: none;
			}
		}
	</style>

	<script is:inline>
		// Case-study accordion: keep the detailed sections collapsed by default
		// so the mockups (ZoneFilters + galleries below) sit above the fold.
		// Uses measured scrollHeight (in px) rather than a magic max-height
		// value so any content length animates smoothly.
		// Étape 12, 8: closing is animated too (height + fade), from either
		// "Show less"; under reduced motion everything is instant.
		(() => {
			const btn = document.getElementById('case-study-toggle');
			const body = document.getElementById('case-study-body');
			if (!btn || !body) return;

			const topBtn = document.getElementById('case-study-toggle-top');
			const labelEl = btn.querySelector('[data-toggle-label]');
			const chevron = btn.querySelector('[data-toggle-chevron]');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
			const D_OPEN = 450;
			const D = 350; // closing
			const EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
			let topAnim = null;
			// After opening, release the height so late images are never cut;
			// ignored if the block was closed again in the meantime.
			const clear = (e) => {
				if (e && e.propertyName !== 'max-height') return;
				body.removeEventListener('transitionend', clear);
				if (body.getAttribute('aria-hidden') === 'true') return;
				body.style.maxHeight = 'none';
			};

			function setExpanded(next) {
				const m0 = parseFloat(getComputedStyle(btn).marginTop) || 0;
				btn.setAttribute('aria-expanded', String(next));
				body.setAttribute('aria-hidden', String(!next));
				body.toggleAttribute('inert', !next);

				body.removeEventListener('transitionend', clear);
				if (next) {
					// Open: measured height, then released (see clear).
					body.style.maxHeight = body.scrollHeight + 'px';
					if (reduce.matches) clear();
					else body.addEventListener('transitionend', clear);
				} else {
					// Close: pin the current height, force reflow, drop to 0.
					body.style.maxHeight = body.getBoundingClientRect().height + 'px';
					void body.offsetHeight;
					body.style.maxHeight = '0px';
				}
				if (labelEl) {
					labelEl.textContent = next ? 'Show less' : 'Read the full case study';
				}
				if (chevron) {
					chevron.style.transform = next ? 'rotate(180deg)' : '';
				}
				if (topBtn && next) {
					topAnim?.cancel();
					topAnim = null;
					topBtn.hidden = false;
				}
				// Phones: the button’s top margin changes with its state; the new
				// margin applies at once and the button glides there with a
				// transform (no margin animation).
				const dm = (parseFloat(getComputedStyle(btn).marginTop) || 0) - m0;
				if (dm && !reduce.matches) {
					btn.animate([{ transform: `translateY(${-dm}px)` }, { transform: 'none' }], { duration: next ? D_OPEN : D, easing: EASE });
				}
			}

			// Étape 13, 13: the top "Show less" no longer folds (that jerked).
			// It stays exactly where it is and already reads "Read the full
			// case study" while the text folds under it; the bottom button is
			// hidden meanwhile. At the end the two swap: they are identical and
			// at the same place, so nothing moves.
			function foldTop() {
				if (!topBtn || topBtn.hidden) return;
				if (reduce.matches) { topBtn.hidden = true; return; }
				const lab = topBtn.querySelector('span');
				const chev = topBtn.querySelector('svg');
				if (lab) lab.textContent = 'Read the full case study';
				if (chev) chev.style.transform = '';
				btn.style.opacity = '0';
				const done = () => {
					body.removeEventListener('transitionend', onEnd);
					clearTimeout(timer);
					topAnim = null;
					if (btn.getAttribute('aria-expanded') === 'true') return; // reopened meanwhile
					const hadFocus = document.activeElement === topBtn;
					topBtn.hidden = true;
					if (lab) lab.textContent = 'Show less';
					if (chev) chev.style.transform = 'rotate(180deg)';
					btn.style.opacity = '';
					if (hadFocus) btn.focus({ preventScroll: true });
				};
				const onEnd = (e) => { if (e.propertyName === 'max-height') done(); };
				body.addEventListener('transitionend', onEnd);
				const timer = setTimeout(done, D + 120); // safety net
				topAnim = { cancel: () => {
					body.removeEventListener('transitionend', onEnd);
					clearTimeout(timer);
					if (lab) lab.textContent = 'Show less';
					if (chev) chev.style.transform = 'rotate(180deg)';
					btn.style.opacity = '';
				} };
			}

			// Bottom "Show less" (unchanged): the top one, out of view, folds away.
			function foldTopAway() {
				if (!topBtn || topBtn.hidden) return;
				if (reduce.matches) { topBtn.hidden = true; return; }
				const cs = getComputedStyle(topBtn);
				const anim = topBtn.animate(
					[
						{ height: topBtn.offsetHeight + 'px', minHeight: '0px', marginTop: cs.marginTop, marginBottom: cs.marginBottom, opacity: 1, overflow: 'hidden' },
						{ height: '0px', minHeight: '0px', marginTop: '0px', marginBottom: '0px', opacity: 0, overflow: 'hidden' },
					],
					{ duration: D, easing: EASE },
				);
				topAnim = anim;
				anim.onfinish = () => { topBtn.hidden = true; topAnim = null; };
			}

			// Top "Show less": the page does not scroll; the focus goes back to
			// the button, which ends where it was before opening.
			topBtn?.addEventListener('click', () => {
				if (btn.getAttribute('aria-expanded') !== 'true') return;
				foldTop();
				setExpanded(false);
				// the focus stays on this button while it folds, then moves to its twin
				if (reduce.matches) btn.focus({ preventScroll: true });
			});

			// Étape 9, J: "Show less" closes the case study and brings the page
			// back, softly, to the button, at the height where it was clicked to
			// open. Étape 12, 8: the text folds while the page follows the
			// button, which glides from under the finger to that height.
			let openedAt = null;
			let followRaf = 0;
			btn.addEventListener('click', () => {
				const expanded = btn.getAttribute('aria-expanded') === 'true';
				cancelAnimationFrame(followRaf); // reopened while the page was still gliding
				if (!expanded) {
					openedAt = btn.getBoundingClientRect().top;
					setExpanded(true);
					return;
				}
				const keep = openedAt ?? window.innerHeight * 0.4;
				const from = btn.getBoundingClientRect().top;
				setExpanded(false);
				foldTopAway();
				if (reduce.matches) {
					const top = btn.getBoundingClientRect().top + window.scrollY;
					window.scrollTo({ top: Math.max(0, top - keep), behavior: 'instant' });
					return;
				}
				const t0 = performance.now();
				const ease = (t) => 1 - Math.pow(1 - t, 3);
				const follow = (now) => {
					const t = Math.min(1, (now - t0) / (D + 50));
					const y = from + (keep - from) * ease(t);
					const top = btn.getBoundingClientRect().top + window.scrollY;
					window.scrollTo({ top: Math.max(0, top - y), behavior: 'instant' });
					if (t < 1) followRaf = requestAnimationFrame(follow);
				};
				followRaf = requestAnimationFrame(follow);
			});
		})();
	</script>

	{/* Wrap ZoneFilters + zones together so the sticky bar has a tall
	    scrollable parent to pin against. A wrapper that hugged just
	    ZoneFilters (height = 58px) killed the sticky as soon as you
	    scrolled past that height. mt-8 keeps the 32px gap below the
	    "Read the full case study" toggle. */}
	{/* mt-8 wrapper — spans full viewport (no max-w constraint) so
		ZoneFilters bar can extend edge-to-edge viewport (David’s ask).
		Zones are wrapped in an inner max-w-1200 container below. */}
	<div class="mt-sec">
		<ZoneFilters zones={zones} backHref="/#work" backLabel="Back to work" />
		<div class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0">

		{
			zones.map((zone, zoneIdx) => {
			// Dark mockups already have a distinct dark background of their
			// own, so they don’t need the wrapper border/shadow/bg treatment
			// that light mockups need to stand out from the near-white body.
			// Zones without a theme token (just "Desktop" / "Mobile" /
			// "Other") default to the "needs border" behaviour (safer for
			// unclassified content).
			const isDarkZone = /dark/i.test(zone.label);
			return (
				<section
					data-zone-label={zone.label}
					class:list={["zone-sec mx-auto max-w-[1200px] scroll-mt-32", { "zone-first": zoneIdx === 0 }]}
					data-reveal
				>
					<header class="grid grid-cols-12 gap-y-3 sm:gap-8">
						<h2 class="col-span-12 text-3xl font-extrabold tracking-tight text-ink sm:col-span-4 sm:text-4xl">
							{zone.label.replace(/ · /g, ' ')}
						</h2>
						{
							/* Zone description is optional — some zones (e.g. "Other")
							   intentionally return an empty string. Skip rendering the
							   <p> entirely when empty so the header doesn’t collapse
							   with dead whitespace. */
							zoneDescription(zone.label, zone.images.length) && (
								<p class="col-span-12 text-lg leading-relaxed text-muted sm:col-span-6 sm:col-start-7">
									{zoneDescription(zone.label, zone.images.length)}
								</p>
							)
						}
					</header>

					{
						zone.isMobile ? (
							// Phone captures: one masonry gallery for the whole site
							// (components/MasonryGallery.astro). Dark mockups have no frame.
							<div class="mt-title">
								{/* Sonary Mailer keeps its email layout (David, étape 5): masonry. */}
								<MasonryGallery urls={zone.images.map((i) => i.url)} alt={project.title} framed={!isDarkZone} priority={zoneIdx === 0} layout={project.slug === 'sonary-mailer' ? 'masonry' : 'phone'} />
							</div>
						) : zone.label === 'Other' ? (
							// Fallback for unclassified images. No bg wrapper
							// (avoids the gap issue when object-contain shows
							// a smaller image than the card). Ring + shadow
							// live on the <img> itself.
							<div class="mt-title gap-cards grid grid-cols-1 sm:grid-cols-2">
								{zone.images.map(({ url }, imgIdx) => (
									<div class="img-skeleton rounded-lg">
										<img
											src={cld(url, FULL)}
											srcset={landscapeSrcset(url)}
											sizes="(min-width: 1024px) 560px, 100vw"
											alt={project.title}
											loading="lazy"
											fetchpriority={zoneIdx === 0 && imgIdx < 2 ? "high" : undefined}
											class="mx-auto block h-auto max-h-[720px] w-auto max-w-full rounded-lg object-contain shadow-md ring-1 ring-ink/15"
											data-lb
											data-lb-kind="desktop"
											data-lb-src={cld(url, FULL)}
												data-lb-srcset={fullSrcset(url, sizeOf(url, imageSizes)?.[0])}
												data-lb-w={sizeOf(url, imageSizes)?.[0]}
											tabindex="0"
											role="button"
											aria-label={`${project.title}: open image full size`}
											onload="this.parentElement.classList.add('is-loaded')"
											onerror="this.parentElement.classList.add('is-loaded')"
										/>
									</div>
								))}
							</div>
						) : (
							// Desktop shots: stacked full-width. srcset covers 2K/4K.
							// NO rounded (would clip mockup edges). Border+shadow
							// only for LIGHT (or theme-less) zones so light mockups
							// don’t bleed into the near-white body. Dark mockups
							// render border-less — they already stand out.
							// Client script (see bottom of file) reads each image’s
							// naturalWidth after load:
							//   - Narrow (natW < 900) = email template / narrow
							//     screenshot → moved to a 2-col grid below the stack,
							//     capped to natural width so it never upscales.
							//   - Wide (natW ≥ 900) = normal desktop mockup → stays
							//     full-width in the stack.
							<div class="mt-title" data-desktop-zone data-dark-zone={isDarkZone ? '1' : '0'}>
								<div class="space-y-10" data-desktop-stack>
									{zone.images.filter(({ url }) => !isNarrow(url)).map(({ url }, imgIdx) => (
										<div
											class="w-full max-w-full img-skeleton"
											data-desktop-item
										>
											<img
												src={cld(url, FULL)}
												srcset={fullSrcset(url, sizeOf(url, imageSizes)?.[0]) ?? landscapeSrcset(url)}
												sizes="(min-width: 1280px) 1200px, 100vw"
												alt={project.title}
												loading="lazy"
												fetchpriority={zoneIdx === 0 && imgIdx < 2 ? "high" : undefined}
												class={'block h-auto w-full' + (isDarkZone ? '' : ' border border-ink/15 shadow-md')}
												data-lb
												data-lb-kind="desktop"
												data-lb-src={cld(url, FULL)}
												data-lb-srcset={fullSrcset(url, sizeOf(url, imageSizes)?.[0])}
												data-lb-w={sizeOf(url, imageSizes)?.[0]}
												tabindex="0"
												role="button"
												aria-label={`${project.title}: open image full size`}
												onload="this.parentElement.classList.add('is-loaded')"
												onerror="this.parentElement.classList.add('is-loaded')"
											/>
										</div>
									))}
								</div>
								{/* Narrow items land here. The track max used to be `max-content`,
								    which is the image’s own natural width — so a 600px-wide email
								    template made a 600px column no matter how little room there
								    was. Two of them on a 900px tablet asked for 1232px and the
								    row simply overflowed; on a phone one column alone was 600
								    against a ~350 viewport. `1fr` shares the row instead: the
								    track never exceeds what is available, so the image fills the
								    width it is given and stops at its natural size (the inline
								    max-width the probe sets) rather than forcing the layout
								    wider. The track minimum is 560 rather than 380: at 380 a
								    tablet fitted two columns of 339px and shrank a 600px email
								    template to half its size for no reason. At 560 the tablet
								    gets one full-width row (the item centres at its native 600)
								    and the 1200px desktop still fits two. */}
								{/* 13/11 (CL1): narrow items (email templates, banners) now
								    stack in columns, masonry style: 3 columns on desktop, 2 on
								    tablets, 1 on phones. Each item sits right under the previous
								    one in its column, so templates of different heights leave
								    no holes. */}
								<div class:list={['narrow-masonry', { 'mt-10': zone.images.some(({ url }) => !isNarrow(url)) }]} data-desktop-narrow-grid></div>
								{zone.images.some(({ url }) => isNarrow(url)) && (
									<div class:list={{ 'mt-10': zone.images.some(({ url }) => !isNarrow(url)) }}>
										<MasonryGallery urls={zone.images.filter(({ url }) => isNarrow(url)).map((i) => i.url)} alt={project.title} framed={!isDarkZone} layout="masonry" kind="desktop" />
									</div>
								)}
							</div>
						)
					}
				</section>
			);
		})
	}
		</div>
	</div>

	<div class="sec-gap"></div>

	<style is:global>
		/* Skeleton shimmer for image containers. Wrapper shows a pulsing gradient
		   while the HD image loads underneath (opacity:0), then fades in on load.
		   Preserves 100% source quality — placeholder is purely visual. Applied on
		   desktop stack items + Other zone items. Mobile grid skipped (script
		   mutation interferes; parked for future LQIP blur-up if needed). */
		.img-skeleton {
			position: relative;
			background: linear-gradient(90deg,
				color-mix(in srgb, var(--color-ink) 4%, transparent) 0%,
				color-mix(in srgb, var(--color-ink) 9%, transparent) 50%,
				color-mix(in srgb, var(--color-ink) 4%, transparent) 100%);
			background-size: 200% 100%;
			animation: img-skeleton-shimmer 1.6s ease-in-out infinite;
			min-height: 200px;
		}
		.img-skeleton > img {
			opacity: 0;
			transition: opacity 0.4s ease-out;
			position: relative;
			z-index: 1;
		}
		.img-skeleton.is-loaded {
			animation: none;
			background: transparent;
			min-height: 0;
		}
		.img-skeleton.is-loaded > img {
			opacity: 1;
		}
		@keyframes img-skeleton-shimmer {
			0%   { background-position: 200% 0; }
			100% { background-position: -200% 0; }
		}
		@media (prefers-reduced-motion: reduce) {
			.img-skeleton { animation: none; }
			.img-skeleton > img { transition: none; }
		}

		.narrow-masonry { columns: 1; column-gap: 32px; }
		.narrow-masonry:empty { display: none; } /* étape 15, S46: no extra space when no narrow item */
		@media (min-width: 640px) { .narrow-masonry { columns: 2; } }
		@media (min-width: 1024px) { .narrow-masonry { columns: 3; } }
		.narrow-masonry > * { display: block; break-inside: avoid; margin-bottom: 32px; }
		/* Narrow desktop items (e.g. email templates 400px wide) moved out
		   of the full-width stack into a 2-col grid, capped at their natural
		   width so the browser never upscales. Wrapper drops the full-width
		   stretch but keeps its border + shadow (light) or naked (dark). */
		[data-desktop-narrow-grid] > [data-desktop-item] {
			width: auto;
			max-width: 100%;
		}
		[data-desktop-narrow-grid] > [data-desktop-item] > img {
			width: auto;
			max-width: 100%;
			height: auto;
		}
	</style>

	<script is:inline>
		// Desktop zone: split narrow images (e.g. Sonary Email Templates, 400px
		// wide) out of the full-width stack into an auto-fit grid. Cap each
		// moved item’s inline max-width to the SOURCE width (not the served
		// variant width — see probe below). Wide images (≥900px source) stay
		// in the full-width stack.
		//
		// Why the probe: `img.naturalWidth` reflects the srcset variant the
		// browser actually served, not the Cloudinary source. On a small slot
		// with `sizes="(min-width:1280px) 1200px, 100vw"`, the browser may
		// serve a 639px or 800px variant of a 1200px source — my old detector
		// then classified 1200px sources as "narrow" (false positive) and moved
		// them into the narrow grid, where they got clamped even smaller.
		// The probe fetches `c_limit,w_9999` which returns exactly the source
		// width (Cloudinary caps at source), so we see the truth.
		(() => {
			const NARROW_THRESHOLD = 900;
			const zones = document.querySelectorAll('[data-desktop-zone]');
			if (!zones.length) return;

			// Probe true source width via a Cloudinary transform that always
			// returns the source’s own width (never upscales, never downscales
			// below source). Cached across probes for the same URL.
			const probeCache = new Map();
			function probeSourceWidth(imgSrc) {
				const probeSrc = imgSrc.replace(
					/\/upload\/(c_[^/]+\/)?/,
					'/upload/c_limit,w_9999,q_100,f_auto/'
				);
				if (probeCache.has(probeSrc)) return probeCache.get(probeSrc);
				const p = new Promise((resolve) => {
					const probe = new Image();
					probe.onload = () => resolve(probe.naturalWidth || 0);
					probe.onerror = () => resolve(0);
					probe.src = probeSrc;
				});
				probeCache.set(probeSrc, p);
				return p;
			}

			zones.forEach((zone) => {
				const stack = zone.querySelector('[data-desktop-stack]');
				const narrowGrid = zone.querySelector('[data-desktop-narrow-grid]');
				if (!stack || !narrowGrid) return;

				const items = Array.from(stack.querySelectorAll('[data-desktop-item]'));

				items.forEach((item, idx) => {
					const img = item.querySelector('img');
					if (!img) return;

					const handle = async () => {
						const servedW = img.naturalWidth;
						if (!servedW) return;

						// Only probe if the served variant looks like a narrow
						// candidate. Skip the probe (0 fetches) when the served
						// width is already ≥ threshold — the source is definitely
						// wide enough.
						if (servedW >= NARROW_THRESHOLD) return;

						const trueW = await probeSourceWidth(img.src);
						if (!trueW || trueW >= NARROW_THRESHOLD) return;

						// Genuinely narrow source: cap the item’s inline
						// max-width to the true source width so the auto-fit
						// grid centers it at native size — never upscaled,
						// never squeezed.
						// Preserve gallery order in the narrow grid via
						// `style.order = idx` — items are appended in
						// probe-resolution order (async race), but CSS order
						// forces them back into the original DOM order.
						// min() with 100%: the cap is the source width, but never
						// wider than the track it sits in. Without the 100% term a
						// 600px email template overflowed a phone-width column.
						// width:100% is set explicitly, not left to the `w-full`
						// class. Inside an auto-fit track the item was resolving to
						// the served image’s intrinsic width (309px in one viewport,
						// 361px in another) instead of filling the track — a 600px
						// email template rendered at half size and moved when the
						// window did. With width:100% it fills the track and the
						// max-width below stops it at the source’s own size, so it is
						// never upscaled and never squeezed.
						item.style.width = '100%';
						item.style.maxWidth = 'min(100%, ' + trueW + 'px)';
						item.style.marginInline = 'auto';
						// Keep gallery order: probes resolve in any order, so insert
						// before the first item that comes later in the gallery.
						item.dataset.idx = String(idx);
						const after = Array.from(narrowGrid.children).find((c) => Number(c.dataset.idx) > idx);
						narrowGrid.insertBefore(item, after || null);
					};

					if (img.complete && img.naturalWidth) {
						handle();
					} else {
						img.addEventListener('load', handle, { once: true });
						img.addEventListener('error', () => {}, { once: true });
					}
				});
			});

			// Étape 15, S67: banner galleries (zones "Gallery": GamingTech,
			// Tradologic, UI/UX work, Wochat). An image is never shown wider than
			// its own pixels: one at least as wide as the column fills it (an image
			// at least twice the shown width is sharp on every screen); a narrower
			// one keeps its size and is centred. Narrow banners (the grid under the
			// stack) sit in rows that are centred (CSS below).
			document.querySelectorAll('section[data-zone-label="Gallery"] [data-desktop-stack] img').forEach((img) => {
				const fit = () => {
					const it = img.closest('[data-desktop-item]');
					if (!it || !img.naturalWidth || it.parentElement?.matches('[data-desktop-narrow-grid]')) return;
					it.style.maxWidth = 'min(100%, ' + img.naturalWidth + 'px)';
					it.style.marginInline = 'auto';
				};
				if (img.complete) fit();
				else img.addEventListener('load', fit, { once: true });
			});
		})();
	</script>

	</main>
	<Lightbox />
	<Footer />
</Layout>
