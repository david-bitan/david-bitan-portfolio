---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CraftFilters from '../components/CraftFilters.astro';
import { craftItems } from '../data/craftItems';
import { cld, FULL, landscapeSrcset, fullSrcset } from '../lib/cloudinary';
import Lightbox from '../components/Lightbox.astro';

// Distinct categories in first-appearance order — auto-updates when the data
// source gets new categories (Drawings, Icons, etc.).
const categories = Array.from(new Set(craftItems.map((i) => i.category)));
---

<Layout title="Personal work · David Bitan">
	<Nav />
	<main id="main" tabindex="-1">

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 sm:pt-20 min-[1248px]:px-0" data-reveal>
		<a href="/" class="text-sm font-semibold text-accent-text hover:underline">← Back</a>
		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">Craft</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			Personal work
		</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">
			3D renders and digital painting, outside the product work. Use the filters
			to focus on a single medium.
		</p>
	</article>

	<CraftFilters categories={categories} />

	<div class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0">
		<div class="mt-16 space-y-16">
			{
				craftItems.map((item) => (
					<figure
						id={item.slug}
						data-category={item.category}
						class="craft-figure scroll-mt-48"
					>
						<img
							src={cld(item.image, FULL)}
							srcset={landscapeSrcset(item.image)}
							sizes="(min-width: 1280px) 1200px, 100vw"
							alt={item.title}
							loading="lazy"
							data-lb
							tabindex="0"
							role="button"
							aria-label={`${item.title}: open full size`}
							data-lb-kind="desktop"
							data-lb-src={cld(item.image, FULL)}
							data-lb-srcset={fullSrcset(item.image)}
							class="craft-img mx-auto block h-auto w-full cursor-zoom-in rounded-md"
						/>
						<figcaption class="mt-4 flex flex-wrap items-baseline gap-x-4">
							<h2 class="text-lg font-bold tracking-tight text-ink">{item.title}</h2>
							<span class="text-sm text-muted">
								{item.category} · {item.year}
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>

	<div class="pb-24"></div>
	</main>
	<Lightbox />
	<Footer />

	<script>
		// Étape 9, B2: /craft#<piece> (from the home strip) opens the viewer on
		// that piece, the page scrolled to it underneath.
		window.addEventListener('load', () => {
			const id = decodeURIComponent(location.hash.slice(1));
			const img = id ? document.getElementById(id)?.querySelector<HTMLImageElement>('img[data-lb]') : null;
			if (!img) return;
			img.scrollIntoView({ block: 'center', behavior: 'instant' });
			img.click();
		});
	</script>

	<script>
		// Prevent CSS upscale of low-resolution sources — cap each image's
		// displayed max-width to its actual naturalWidth. Old-Wix imports
		// range from ~600px to ~1400px wide; without this cap the browser
		// stretches them to the ~1200px container and they look pixelated.
		// naturalWidth reflects the picked srcset variant (Cloudinary's
		// c_limit already keeps served pixels ≤ source, so max-width =
		// naturalWidth means "displayed pixels ≤ actual pixels" — no upscale).
		// mx-auto keeps small images centered in the 1200px column.
		(() => {
			const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('.craft-img'));
			const applyCap = (img: HTMLImageElement) => {
				if (img.naturalWidth > 0) {
					img.style.maxWidth = img.naturalWidth + 'px';
				}
			};
			imgs.forEach((img) => {
				if (img.complete && img.naturalWidth > 0) {
					applyCap(img);
				} else {
					img.addEventListener('load', () => applyCap(img), { once: true });
				}
			});
		})();
	</script>
</Layout>
