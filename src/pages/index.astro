---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import LogosMarquee from '../components/LogosMarquee.astro';
import SelectedWork from '../components/SelectedWork.astro';
import AILabSection from '../components/AILabSection.astro';
import Testimonials from '../components/Testimonials.astro';
import CraftSection from '../components/CraftSection.astro';
import AboutPreview from '../components/AboutPreview.astro';
import Footer from '../components/Footer.astro';
import SectionRule from '../components/SectionRule.astro';
---

<Layout
	title="David Bitan · Senior AI Product Designer"
	description="Senior AI Product Designer in Israel, available now. SaaS, fintech and gaming products, from user research to shipped design systems: case studies from Ryze Beyond, Sonary, Playright and more."
>
	<Nav />
	<main id="main" tabindex="-1">
	<Hero />
	{/* Étape 15, S46: --sp-sec after the hero (no rule), a thin rule between
	    2 sections, --sp-sec before the footer (no rule). */}
	{/* Étape 17, S95: a thin 1 px rule in the middle of the gap between the hero
	    and the company strip. It is drawn over the gap (absolute), so nothing
	    moves. Same colour as the vertical rule of S90 (the specialties line at 40%). */}
	<div class="sec-gap after-hero hero-rule-gap"><div class="hero-rule" aria-hidden="true"><hr /></div></div>
	{/* Étape 9, B1: the company names run above the figures. */}
	<LogosMarquee />
	<SectionRule />
	<Metrics />
	<SectionRule />
	<SelectedWork />
	<SectionRule />
	<AILabSection />
	<SectionRule />
	<Testimonials />
	<SectionRule />
	<AboutPreview />
	<SectionRule />
	<CraftSection />
	<div class="sec-gap"></div>
	</main>
	<Footer />
</Layout>
