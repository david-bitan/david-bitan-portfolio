---
/**
 * AI Lab case study — format allégé (no client/role/year, just intro paragraphs
 * + design system + gallery + live demo). Distinct from /work/[slug] which is
 * the full 6-section case study for client work.
 *
 * Intro pattern: first paragraph always visible, remaining paragraphs behind a
 * Show more / Show less toggle. Same accordion mechanics as the Work case
 * study "Read the full case study" toggle (measured scrollHeight for the
 * expand transition).
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { aiLabProjects } from '../../data/aiLabProjects';

export function getStaticPaths() {
	// Entries carrying `cardHref` are cards that point somewhere that already
	// exists (the colophon). Building a /lab/ page for them would duplicate
	// that content under a second URL.
	return aiLabProjects
		.filter((project) => !project.cardHref)
		.map((project) => ({
			params: { slug: project.slug },
			props: { project },
		}));
}

const { project } = Astro.props;

const seoDescription = project.shortDesc;
const seoOgImage = project.thumbnail;

// Split intro on blank lines. First paragraph is the visible teaser; the
// remaining paragraphs are hidden behind the Show more toggle.
const paragraphs = project.intro.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
const firstPara = paragraphs[0] ?? '';
const restParas = paragraphs.slice(1);

const projectJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.shortDesc,
	creator: { '@type': 'Person', name: 'David Bitan' },
	about: 'AI Lab experiment',
	image: seoOgImage,
	url: project.demoUrl,
};

const ds = project.designSystem;
---

<Layout
	title={`${project.title} — AI Lab · David Bitan`}
	description={seoDescription}
	ogImage={seoOgImage}
	structuredData={projectJsonLd}
>
	<Nav />

	<article class="mx-auto max-w-[1200px] px-6 pt-16 pb-2 sm:pt-20 lg:px-0" data-reveal>
		<a href="/#ai-lab" class="text-sm font-semibold text-accent hover:underline"
			>← Back to AI Lab</a
		>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">
			{project.eyebrow}
		</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			{project.title}
		</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{project.subtitle}</p>

		<div class="mt-10 flex flex-wrap items-center gap-4">
			<a
				href={project.demoUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-pill bg-accent px-7 py-3.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-ink"
			>
				View live demo
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.4"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M7 17L17 7M8 7h9v9"></path>
				</svg>
			</a>
			<span class="text-xs uppercase tracking-widest text-muted"
				>Fictional experiment · self-brief</span
			>
		</div>
	</article>

	<section class="mx-auto max-w-[1200px] px-6 pt-8 pb-12 sm:pt-10 sm:pb-16 lg:px-0" data-reveal>
		<div class="prose-lab max-w-[68ch]">
			<p class="prose-lead">{firstPara}</p>

			{
				restParas.length > 0 && (
					<>
						<div id="intro-more" class="intro-more" aria-hidden="true">
							{restParas.map((p) => (
								<p>{p}</p>
							))}
						</div>

						<button
							type="button"
							id="intro-toggle"
							aria-controls="intro-more"
							aria-expanded="false"
							class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
						>
							<span data-toggle-label>Show more</span>
							<svg
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.4"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4 transition-transform"
								data-toggle-chevron
							>
								<path d="M6 9l6 6 6-6" />
							</svg>
						</button>
					</>
				)
			}
		</div>
	</section>

	{
		ds && (
			<section
				class="mx-auto max-w-[1200px] px-6 pt-4 pb-12 sm:pt-6 sm:pb-16 lg:px-0"
				data-reveal
			>
				<p class="text-sm font-semibold uppercase tracking-widest text-muted">
					Under the hood
				</p>
				<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
					Design system
				</h2>

				{/* Colors */}
				<div class="mt-10">
					<h3 class="ds-h3">Palette</h3>
					<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
						{ds.colors.map((c) => (
							<div class="ds-swatch">
								<div
									class="ds-swatch-chip"
									style={`background-color:${c.hex}`}
									aria-hidden="true"
								/>
								<p class="mt-3 text-sm font-bold text-ink">{c.name}</p>
								<p class="mt-1 font-mono text-xs uppercase text-muted">{c.hex}</p>
								<p class="mt-2 text-xs text-muted">{c.role}</p>
							</div>
						))}
					</div>
				</div>

				{/* Typography */}
				<div class="mt-12">
					<h3 class="ds-h3">Typography</h3>
					<div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
						{ds.typography.map((t) => (
							<div class="ds-type">
								<p
									class="ds-type-sample"
									style={`font-family:'${t.family}',serif`}
								>
									{t.sample}
								</p>
								<p class="mt-3 text-sm font-semibold text-ink">{t.family}</p>
								<p class="mt-0.5 text-xs text-muted">{t.weights}</p>
								<p class="mt-1 text-xs text-muted">{t.role}</p>
							</div>
						))}
					</div>
				</div>

				{/* Three-column lists */}
				<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
					<div>
						<h3 class="ds-h3">Micro-typography</h3>
						<ul class="ds-list">
							{ds.micro.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="ds-h3">Interactions</h3>
						<ul class="ds-list">
							{ds.interactions.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="ds-h3">Constraints</h3>
						<ul class="ds-list">
							{ds.constraints.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				</div>
			</section>
		)
	}

	<section
		class="mx-auto max-w-[1200px] px-6 py-8 sm:py-12 lg:px-0"
		data-reveal
	>
		<div class="grid grid-cols-1 gap-6">
			{
				project.gallery.map((src, i) => (
					<div class="ai-lab-shot block overflow-hidden rounded-md bg-card">
						<img
							src={src}
							alt={`${project.title} — screenshot ${i + 1}`}
							loading={i === 0 ? 'eager' : 'lazy'}
							class="h-auto w-full object-cover"
						/>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-12 text-center sm:py-16 lg:px-0" data-reveal>
		<a
			href={project.demoUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-2 rounded-pill border border-ink/15 px-7 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-ink/40"
		>
			Open the live demo
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M7 17L17 7M8 7h9v9"></path>
			</svg>
		</a>
	</section>

	<Footer />
</Layout>

<style>
	.prose-lab p {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-ink);
	}
	.prose-lab p + p {
		margin-top: 1.25rem;
	}
	.prose-lead {
		/* first visible paragraph slightly larger for hierarchy */
		font-size: 1.125rem !important;
	}

	/* Show more accordion — same mechanics as work case study */
	.intro-more {
		overflow: hidden;
		max-height: 0;
		opacity: 0;
		transition:
			max-height 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
			opacity 350ms ease-out;
	}
	.intro-more[aria-hidden='false'] {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.intro-more {
			transition: none;
		}
	}

	/* Design system section */
	.ds-h3 {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-ink) 55%, transparent);
	}
	/* Palette entries follow the colophon: the swatch sits inside a bordered
	   card rather than floating on the page, which keeps it consistent with
	   the typography cards next to it and stops a dark colour from bleeding
	   into the background it is printed on. */
	.ds-swatch {
		display: block;
		border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
		border-radius: 12px;
		background: var(--color-card);
		padding: 1rem;
	}
	.ds-swatch-chip {
		height: 4rem;
		width: 100%;
		border-radius: 6px;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 10%, transparent);
	}
	.ds-type {
		border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
		border-radius: 12px;
		padding: 1.5rem;
		background: var(--color-card);
	}
	.ds-type-sample {
		font-size: 1.5rem;
		line-height: 1.2;
		color: var(--color-ink);
	}
	.ds-list {
		margin-top: 0.9rem;
		padding-left: 1rem;
		list-style: disc;
		color: var(--color-ink);
	}
	.ds-list li {
		font-size: 0.9375rem;
		line-height: 1.55;
		margin-top: 0.5rem;
	}

</style>

<script is:inline>
	// Intro Show more / Show less accordion — same measured scrollHeight
	// pattern as the work case study toggle so the animation lands cleanly
	// on any content length.
	(() => {
		const btn = document.getElementById('intro-toggle');
		const body = document.getElementById('intro-more');
		if (!btn || !body) return;

		const labelEl = btn.querySelector('[data-toggle-label]');
		const chevron = btn.querySelector('[data-toggle-chevron]');

		function setExpanded(next) {
			btn.setAttribute('aria-expanded', String(next));
			body.setAttribute('aria-hidden', String(!next));

			if (next) {
				body.style.maxHeight = body.scrollHeight + 'px';
				const clear = () => {
					body.style.maxHeight = 'none';
					body.removeEventListener('transitionend', clear);
				};
				body.addEventListener('transitionend', clear);
			} else {
				body.style.maxHeight = body.scrollHeight + 'px';
				void body.offsetHeight;
				body.style.maxHeight = '0px';
			}

			if (labelEl) {
				labelEl.textContent = next ? 'Show less' : 'Show more';
			}
			if (chevron) {
				chevron.style.transform = next ? 'rotate(180deg)' : '';
			}
		}

		btn.addEventListener('click', () => {
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			setExpanded(!expanded);
		});
	})();
</script>
