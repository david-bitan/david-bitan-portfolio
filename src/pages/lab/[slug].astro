---
/**
 * AI Lab case study — format allégé (no client/role/year, just intro paragraphs
 * + design system + gallery + live demo). Distinct from /work/[slug] which is
 * the full 6-section case study for client work.
 *
 * Intro pattern: first paragraph always visible, remaining paragraphs behind a
 * Show more / Show less toggle. Same accordion mechanics as the Work case
 * study "Read the full case study" toggle (measured scrollHeight for the
 * expand transition).
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { aiLabProjects } from '../../data/aiLabProjects';

export function getStaticPaths() {
	// Entries carrying `cardHref` are cards that point somewhere that already
	// exists (the colophon). Building a /lab/ page for them would duplicate
	// that content under a second URL.
	return aiLabProjects
		.filter((project) => !project.cardHref)
		.map((project) => ({
			params: { slug: project.slug },
			props: { project },
		}));
}

const { project } = Astro.props;
const lines = caseLines[project.slug];
const nextSlug = nextOf(project.slug, LAB_ORDER);
const next = nextSlug ? aiLabProjects.find((p) => p.slug === nextSlug) : null;

const seoDescription = project.metaDesc ?? project.shortDesc;
const seoOgImage = project.thumbnail;

// Split intro on blank lines. First paragraph is the visible teaser; the
// remaining paragraphs are hidden behind the Show more toggle.
const paragraphs = project.intro.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
const firstPara = paragraphs[0] ?? '';
const restParas = paragraphs.slice(1);

const projectJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: seoDescription,
	creator: { '@type': 'Person', name: 'David Bitan' },
	about: 'AI Lab experiment',
	image: seoOgImage,
	url: project.demoUrl,
};

const ds = project.designSystem;
import MasonryGallery from '../../components/MasonryGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import ZoneFilters from '../../components/ZoneFilters.astro';
import { caseLines, nextOf, LAB_ORDER } from '../../data/caseLines';
import CaseLines from '../../components/CaseLines.astro';
import ProjectTopVisual from '../../components/ProjectTopVisual.astro';
import { topLayouts } from '../../data/topVisuals';
const visual = topLayouts[project.slug];
---

<Layout
	title={`${project.title} · AI Lab Work · David Bitan`}
	description={seoDescription}
	ogImage={seoOgImage}
	structuredData={projectJsonLd}
>
	<Nav />
	<main id="main" tabindex="-1">
	<ZoneFilters backHref="/#ai-lab" backLabel="Back to AI Lab Work" />

	<article class="mx-auto max-w-[1200px] px-6 pt-4 sm:pt-5 min-[1248px]:px-0" data-reveal>
		<a href="/#ai-lab" data-top-back class="text-sm font-semibold text-accent-text"
			><span class="arr-back" aria-hidden="true">→</span>Back to AI Lab Work</a
		>

		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">
			{project.eyebrow.split(' · ').map((part, i) => <>{i > 0 && <span class="eb-gap"> </span>}{part}</>)}
		</p>
		{/* Étape 14, ajout 1: the text on the left, the composition over the
		    right part (desktop); phones: the composition under the text. */}
		<div class="ptv-hero mt-4" data-ptv-hero={visual ? '' : undefined}>
		<div class="ptv-text">
		<h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			{project.title}
		</h1>
		<p class="mt-4 max-w-2xl proj-intro">{project.subtitle}</p>

		<div class="mt-10 flex flex-wrap items-center gap-4">
			<a
				href={project.demoUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-pill bg-accent px-7 py-3.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-ink hover:text-bg"
			>
				View live demo
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.4"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M7 17L17 7M8 7h9v9"></path>
				</svg>
			</a>
			<span class="text-xs uppercase tracking-widest text-muted"
				>Self-initiated concept</span
			>
		</div>
		{/* Étape 14, ajout 2 (A): the intro and its Show more back in the left
		    column, 32 px under the button row; phones keep the same order. */}
		<div class="prose-lab mt-8 max-w-[68ch]">
			<p class="prose-lead">{firstPara}</p>

			{
				restParas.length > 0 && (
					<>
						<div id="intro-more" class="intro-more" aria-hidden="true">
							{restParas.map((p) => (
								<p>{p}</p>
							))}
						</div>

						<button
							type="button"
							id="intro-toggle"
							aria-controls="intro-more"
							aria-expanded="false"
							class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-text"
						>
							<span data-toggle-label>Show more</span>
							<svg
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.4"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4 transition-transform"
								data-toggle-chevron
							>
								<path d="M6 9l6 6 6-6" />
							</svg>
						</button>
					</>
				)
			}
		</div>
		</div>
		{visual && <ProjectTopVisual slug={project.slug} />}
		</div>

		{/* Étape 14, ajout 1 (S33): Challenge · What I did · Result · Role, full width */}
		{lines && <div class="mt-sec"><CaseLines lines={lines} /></div>}
	</article>


	{
		project.aiFeature && (
			<section id="ai-feature" class="lab-sec mx-auto max-w-[1200px] scroll-mt-24 px-6 min-[1248px]:px-0" data-reveal>
				<div class="box-line rounded-lg bg-card p-card">
					<p class="text-sm font-semibold uppercase tracking-widest text-accent-text">{project.aiFeature.eyebrow.split(' · ').map((part, i) => <>{i > 0 && <span class="eb-gap"> </span>}{part}</>)}</p>
					<h2 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">{project.aiFeature.title}</h2>
					<p class="mt-4 max-w-[68ch] proj-long leading-7">{project.aiFeature.lead}</p>
					<a
						href={project.aiFeature.tryUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="btn-secondary mt-6 inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-pill px-4 sm:w-auto sm:px-7 py-3.5 text-sm font-semibold"
					>
						{project.aiFeature.tryLabel}
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
					</a>

					<p class="mt-10 text-sm font-semibold uppercase tracking-widest text-muted">States designed</p>
					{/* Bullets, not pills: long states overflowed their pill on phones
					    (David, 15/11). Same orange dots as "Scope" on Work pages. */}
					<ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
						{project.aiFeature.states.map((s) => (
							<li class="flex items-start gap-3 text-sm text-ink">
								<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
								<span>{s}</span>
							</li>
						))}
					</ul>

					<p class="mt-10 text-sm font-semibold uppercase tracking-widest text-muted">Design decisions</p>
					<div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{project.aiFeature.decisions.slice(0, 3).map((d) => (
							<div>
								<p class="font-semibold">{d.title}</p>
								<p class="mt-2 text-sm text-muted">{d.body}</p>
							</div>
						))}
					</div>
					{project.aiFeature.decisions.length > 3 && (
						<details class="ai-more mt-8">
							<summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-pill border border-ink/15 px-4 py-2 text-sm font-semibold">
								<span class="ai-more-open">See the {project.aiFeature.decisions.length - 3} other decisions</span>
								<span class="ai-more-close">Show fewer decisions</span>
								<svg class="ai-more-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
							</summary>
							<div class="ai-more-body">
								<div class="grid grid-cols-1 gap-6 pt-6 sm:grid-cols-2 lg:grid-cols-3">
									{project.aiFeature.decisions.slice(3).map((d) => (
										<div>
											<p class="font-semibold">{d.title}</p>
											<p class="mt-2 text-sm text-muted">{d.body}</p>
										</div>
									))}
								</div>
							</div>
						</details>
					)}
				</div>
			</section>
		)
	}

	{
		ds && (
			<section
				class="lab-sec mx-auto max-w-[1200px] px-6 min-[1248px]:px-0"
				data-reveal
			>
				<p class="text-sm font-semibold uppercase tracking-widest text-muted">
					Under the hood
				</p>
				<h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
					Design system
				</h2>

				{/* Colors */}
				<div class="mt-title">
					<h3 class="ds-h3">Palette</h3>
					<div class="mt-4 gap-cards grid grid-cols-2 sm:grid-cols-4">
						{ds.colors.map((c) => (
							<div class="ds-swatch">
								<div
									class="ds-swatch-chip"
									style={`background-color:${c.hex}`}
									aria-hidden="true"
								/>
								<p class="mt-3 text-sm font-bold text-ink">{c.name}</p>
								<p class="mt-1 font-mono text-xs uppercase text-muted">{c.hex}</p>
								<p class="mt-2 text-xs text-muted">{c.role}</p>
							</div>
						))}
					</div>
				</div>

				{/* Typography: the demo’s own self-hosted fonts, so each sample shows the real face (no Google Fonts) */}
				{ds.fontCss && <link rel="stylesheet" href={ds.fontCss} />}
				<div class="mt-12">
					<h3 class="ds-h3">Typography</h3>
					<div class="mt-4 gap-cards grid grid-cols-1 md:grid-cols-3">
						{ds.typography.map((t) => (
							<div class="ds-type">
								<p
									class="ds-type-sample"
									style={`font-family:'${t.family}',system-ui,sans-serif`}
								>
									{t.sample}
								</p>
								<p class="mt-3 text-sm font-semibold text-ink">{t.family}</p>
								<p class="mt-0.5 text-xs text-muted">{t.weights}</p>
								<p class="mt-1 text-xs text-muted">{t.role}</p>
							</div>
						))}
					</div>
				</div>

				{/* Three-column lists */}
				<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
					<div>
						<h3 class="ds-h3">Micro-typography</h3>
						<ul class="ds-list">
							{ds.micro.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="ds-h3">Interactions</h3>
						<ul class="ds-list">
							{ds.interactions.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="ds-h3">Constraints</h3>
						<ul class="ds-list">
							{ds.constraints.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				</div>
			</section>
		)
	}

	<section
		class="lab-sec mx-auto max-w-[1200px] px-6 min-[1248px]:px-0"
		data-reveal
	>
		<div class="gap-cards grid grid-cols-1">
			{
				project.gallery.map((src, i) => (
					<div class="ai-lab-shot block overflow-hidden rounded-md bg-card">
						<img
							src={src}
							alt={`${project.title}: screenshot ${i + 1}`}
							loading={i === 0 ? 'eager' : 'lazy'}
							class="h-auto w-full object-cover"
							data-lb
							data-lb-kind="desktop"
							tabindex="0"
							role="button"
							aria-label={`${project.title}: open screenshot ${i + 1} full size`}
						/>
					</div>
				))
			}
		</div>
	</section>

	{
		project.mobileGallery && project.mobileGallery.length > 0 && (
			<section class="lab-sec mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
				<p class="mb-4 text-sm font-semibold uppercase tracking-widest text-muted">On mobile</p>
				<MasonryGallery urls={project.mobileGallery} alt={`${project.title}: mobile screenshot`} />
			</section>
		)
	}

	{
		project.nextSteps && project.nextSteps.length > 0 && (
			<section id="next-steps" class="lab-sec mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
				<div class="box-line rounded-lg bg-card p-card">
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Next steps</p>
					<div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{project.nextSteps.map((n) => (
							<div>
								<p class="font-semibold">
									{n.title}
									<span class="ms-2 rounded-pill bg-bg px-2.5 py-0.5 align-middle text-xs font-medium text-muted">Planned</span>
								</p>
								<p class="mt-2 text-sm text-muted">{n.body}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="lab-sec mx-auto max-w-[1200px] px-6 text-center min-[1248px]:px-0" data-reveal>
		<a
			href={project.demoUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-2 rounded-pill border border-ink/15 px-7 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-ink/40"
		>
			Open the live demo
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M7 17L17 7M8 7h9v9"></path>
			</svg>
		</a>
	</section>

	<div class="sec-gap"></div>
	</main>
	<Lightbox />
	<Footer />
</Layout>

<style>
	/* Étape 16, S81: the common project-page rule (global.css). */
	.prose-lab p {
		font-size: var(--fs-proj-long);
		line-height: 1.7;
		color: var(--c-proj-text);
	}
	.prose-lab p + p {
		margin-top: 1.25rem;
	}
	.prose-lead {
		/* first visible paragraph slightly larger for hierarchy */
		font-size: var(--fs-proj-long) !important;
	}
	/* Étape 15, S57: phones and tablets (intro under the button), the intro
	   is grey like the text under the title of the Work pages. */
	@media (max-width: 1023.98px) {
		.prose-lab p {
			color: var(--color-muted);
		}
	}

	/* Show more accordion — same mechanics as work case study */
	.intro-more {
		overflow: hidden;
		max-height: 0;
		opacity: 0;
		transition:
			max-height 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
			opacity 350ms ease-out;
	}
	.intro-more[aria-hidden='false'] {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.intro-more {
			transition: none;
		}
	}

	/* Design system section */
	.ds-h3 {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-ink) 55%, transparent);
	}
	/* Palette entries follow the colophon: the swatch sits inside a bordered
	   card rather than floating on the page, which keeps it consistent with
	   the typography cards next to it and stops a dark colour from bleeding
	   into the background it is printed on. */
	.ds-swatch {
		display: block;
		/* étape 17, ajout 1: no outline */
		border-radius: var(--radius-box);
		corner-shape: superellipse(3);
		background: var(--color-card);
		padding: var(--sp-pad); /* étape 15, S46: card padding 24 */
	}
	.ds-swatch-chip {
		height: 4rem;
		width: 100%;
		/* concentric: 16px box - 16px padding = 0, so the small minimum */
		border-radius: 4px;
		/* étape 18, S120: no outline */
	}
	.ds-type {
		/* étape 17, ajout 1: no outline */
		border-radius: var(--radius-box);
		corner-shape: superellipse(3);
		padding: 1.5rem;
		background: var(--color-card);
	}
	.ds-type-sample {
		font-size: 1.5rem;
		line-height: 1.2;
		color: var(--color-ink);
	}
	/* Orange dots like the "Scope" list of the Work pages (David, 15/11). */
	.ds-list {
		margin-top: 0.9rem;
		list-style: none;
		padding-left: 0;
		color: var(--color-ink);
	}
	.ds-list li {
		position: relative;
		padding-left: 18px;
		/* Long file paths (e.g. /demo/otium/media/CREDITS.txt) may break so the
		   list never widens the page (Otium at 768 px, CL2 14/11). */
		overflow-wrap: anywhere;
		font-size: 0.9375rem;
		line-height: 1.55;
		margin-top: 0.5rem;
	}
	.ds-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--color-accent);
	}

	/* folded design decisions */
	.ai-more summary::-webkit-details-marker { display: none; }
	.ai-more .ai-more-close { display: none; }
	.ai-more[open] .ai-more-open { display: none; }
	.ai-more[open] .ai-more-close { display: inline; }
	.ai-more .ai-more-ic { transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1); }
	.ai-more[open] .ai-more-ic { transform: rotate(180deg); }
	/* while closing, the button already reads "See the …" and the chevron turns back */
	.ai-more.is-closing .ai-more-open { display: inline; }
	.ai-more.is-closing .ai-more-close { display: none; }
	.ai-more.is-closing .ai-more-ic { transform: none; }
	.ai-more-body { overflow: hidden; }
</style>

<script is:inline>
	// Intro Show more / Show less accordion — same measured scrollHeight
	// pattern as the work case study toggle so the animation lands cleanly
	// on any content length.
	(() => {
		const btn = document.getElementById('intro-toggle');
		const body = document.getElementById('intro-more');
		if (!btn || !body) return;

		const labelEl = btn.querySelector('[data-toggle-label]');
		const chevron = btn.querySelector('[data-toggle-chevron]');

		function setExpanded(next) {
			btn.setAttribute('aria-expanded', String(next));
			body.setAttribute('aria-hidden', String(!next));

			if (next) {
				body.style.maxHeight = body.scrollHeight + 'px';
				const clear = () => {
					body.style.maxHeight = 'none';
					body.removeEventListener('transitionend', clear);
				};
				body.addEventListener('transitionend', clear);
			} else {
				body.style.maxHeight = body.scrollHeight + 'px';
				void body.offsetHeight;
				body.style.maxHeight = '0px';
			}

			if (labelEl) {
				labelEl.textContent = next ? 'Show less' : 'Show more';
			}
			if (chevron) {
				chevron.style.transform = next ? 'rotate(180deg)' : '';
			}
		}

		btn.addEventListener('click', () => {
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			setExpanded(!expanded);
		});
	})();

	// "See the N other decisions": the same opening as Show more (500 ms, same
	// curve), and a slightly quicker closing. Native <details> stays the base,
	// so it still works without JavaScript and with reduced motion.
	(() => {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
		document.querySelectorAll('details.ai-more').forEach((d) => {
			const summary = d.querySelector('summary');
			const body = d.querySelector('.ai-more-body');
			if (!summary || !body) return;
			let anim = null;
			summary.addEventListener('click', (e) => {
				if (reduce.matches || !body.animate) return;
				e.preventDefault();
				const from = anim ? body.getBoundingClientRect().height : null;
				anim?.cancel();
				const closing = d.open && !d.classList.contains('is-closing');
				if (!closing) {
					d.classList.remove('is-closing');
					d.open = true;
					const h = body.scrollHeight;
					anim = body.animate(
						[{ height: (from ?? 0) + 'px', opacity: from ? 1 : 0 }, { height: h + 'px', opacity: 1 }],
						{ duration: 500, easing: EASE }
					);
					anim.onfinish = () => { anim = null; };
				} else {
					d.classList.add('is-closing');
					const h = from ?? body.getBoundingClientRect().height;
					anim = body.animate(
						[{ height: h + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
						{ duration: 400, easing: EASE }
					);
					anim.onfinish = () => { d.open = false; d.classList.remove('is-closing'); anim = null; };
				}
			});
		});
	})();
</script>
