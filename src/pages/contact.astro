---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const email = 'advance26@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/david-bitan';
const city = 'Tel Aviv–Ashkelon area · Hybrid or remote';

// Read at build time (env is only available in the Astro frontmatter, not in
// client-side <script>). Injected into the client script via define:vars so
// the browser can build the POST URL without exposing anything unexpected.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const hasFormspree = Boolean(formspreeId);

const defaultNote = hasFormspree
	? "I usually reply within 24 hours."
	: 'Opens your email client, pre-filled and ready to send.';
---

<Layout
	title="Contact · David Bitan"
	description="Hiring a senior product designer? David Bitan is available now for senior and lead product design roles, hybrid in the Tel Aviv–Ashkelon area or remote."
>
	<Nav />

	<section class="mx-auto max-w-[1200px] px-6 pt-16 pb-24 sm:pt-20 lg:px-0" data-reveal>
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Contact</p>
		<h1 class="mt-4 max-w-2xl text-4xl font-extrabold tracking-tight sm:text-5xl">Hiring a senior product designer?</h1>
		<p class="mt-6 max-w-xl text-lg text-muted">
			I'm available now for senior and lead product design roles: hybrid in the Tel Aviv–Ashkelon
			area, or remote. Send me a note and I'll reply within 24 hours.
		</p>

		<div class="mt-14 grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
			<form id="contact-form" class="flex flex-col gap-6" novalidate>
				<!-- Honeypot: hidden from people and assistive tech, bots fill it and
				     Formspree drops the submission (_gotcha is Formspree's own field). -->
				<div class="hidden" aria-hidden="true">
					<label for="_gotcha">Leave this field empty</label>
					<input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
				</div>
				<div>
					<label for="name" class="block text-sm font-semibold">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-2 w-full rounded-sm border border-ink/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					/>
				</div>

				<div>
					<label for="email" class="block text-sm font-semibold">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-2 w-full rounded-sm border border-ink/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					/>
				</div>

				<div>
					<label for="message" class="block text-sm font-semibold">Message</label>
					<textarea
						id="message"
						name="message"
						rows="6"
						required
						class="mt-2 w-full resize-none rounded-sm border border-ink/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					></textarea>
				</div>

				<div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
					<button
						id="submit-btn"
						type="submit"
						class="shrink-0 whitespace-nowrap rounded-pill bg-accent px-7 py-3 text-[1.1875rem] font-bold text-accent-ink hover:bg-ink hover:text-bg transition-colors disabled:opacity-60 disabled:cursor-wait"
					>
						Send message
					</button>
					<p id="form-note" class="text-sm text-muted" role="status" aria-live="polite">{defaultNote}</p>
				</div>
			</form>

			<div class="flex flex-col gap-8">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Email</p>
					<a href={`mailto:${email}`} class="mt-2 block font-semibold text-accent-text hover:underline">
						{email}
					</a>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">LinkedIn</p>
					<a href={linkedinUrl} target="_blank" rel="noopener" class="mt-2 block font-semibold text-accent-text hover:underline">
						in/david-bitan
					</a>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Location</p>
					<p class="mt-2 font-semibold">{city}</p>
				</div>
			</div>
		</div>
	</section>

	<Footer hideCta />
</Layout>

<script define:vars={{ email, formspreeId }}>
	const form = document.getElementById('contact-form');
	const note = document.getElementById('form-note');
	const submitBtn = document.getElementById('submit-btn');

	// Keep the original class strings so we can restore them after showing a
	// transient status ("Sending…", success, error) without wiping the note's
	// layout. `text-muted` is the resting style used at load; success uses
	// `text-accent-text`; error uses a red utility already available in globals.
	const NOTE_CLASSES = {
		idle: 'text-sm text-muted',
		sending: 'text-sm text-muted',
		success: 'text-sm text-accent-text',
		error: 'text-sm text-[#c1121f]',
	};

	function setNote(state, text) {
		if (!note) return;
		note.className = NOTE_CLASSES[state] ?? NOTE_CLASSES.idle;
		note.textContent = text;
	}

	function fallbackMailto(data) {
		// Used when PUBLIC_FORMSPREE_ID isn't set — opens the visitor's email
		// client pre-filled with the message body so the form still works in
		// local dev before the ID is provisioned.
		const name = String(data.get('name') ?? '');
		const from = String(data.get('email') ?? '');
		const message = String(data.get('message') ?? '');
		const subject = `Portfolio contact from ${name}`;
		const body = `${message}\n\n${name} (${from})`;
		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);

		// novalidate keeps the browser bubbles out (they don't match the site),
		// so check the three fields here and focus the first one that's wrong.
		const fields = ['name', 'email', 'message'].map((id) => document.getElementById(id));
		const bad = fields.find((el) => !el.value.trim() || (el.type === 'email' && !el.checkValidity()));
		fields.forEach((el) => el.setAttribute('aria-invalid', String(el === bad)));
		if (bad) {
			const label = bad.id === 'email' && bad.value.trim() ? 'a valid email address' : `your ${bad.id}`;
			setNote('error', `Please add ${label}.`);
			bad.focus();
			return;
		}

		if (!formspreeId) {
			fallbackMailto(data);
			return;
		}

		submitBtn?.setAttribute('disabled', 'true');
		if (submitBtn) submitBtn.textContent = 'Sending…';
		setNote('sending', 'Sending your message…');

		try {
			const res = await fetch(`https://formspree.io/f/${formspreeId}`, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: data,
			});

			if (res.ok) {
				form.reset();
				setNote('success', "Thanks, your message is on its way. I'll reply within 24 hours.");
			} else {
				// Formspree returns JSON with a helpful `errors` array on 4xx
				// (missing field, spam trap, etc.). We surface a generic message
				// but keep the raw response in the console for debugging.
				const payload = await res.json().catch(() => null);
				console.error('Formspree responded with', res.status, payload);
				setNote('error', `Sending failed. Please email me at ${email}.`);
			}
		} catch (err) {
			// Network error, ad-blocker on the Formspree domain, etc.
			console.error('Contact form fetch failed', err);
			setNote('error', `Network error. Please email me at ${email}.`);
		} finally {
			submitBtn?.removeAttribute('disabled');
			if (submitBtn) submitBtn.textContent = 'Send message';
		}
	});
</script>
