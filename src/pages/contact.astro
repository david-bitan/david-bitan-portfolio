---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const email = 'advance26@gmail.com';
const phone = '054-9-248-520';
const city = 'Ashkelon, Israel';
---

<Layout title="Contact — David Bitan">
	<Nav />

	<section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-20" data-reveal>
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Contact</p>
		<h1 class="mt-4 max-w-2xl text-4xl font-extrabold tracking-tight sm:text-5xl">Let's build something.</h1>
		<p class="mt-6 max-w-xl text-lg text-muted">
			Tell me about your project — I'll get back to you at {email}.
		</p>

		<div class="mt-14 grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
			<form id="contact-form" class="flex flex-col gap-6" novalidate>
				<div>
					<label for="name" class="block text-sm font-semibold">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-2 w-full rounded-sm border border-black/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					/>
				</div>

				<div>
					<label for="email" class="block text-sm font-semibold">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-2 w-full rounded-sm border border-black/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					/>
				</div>

				<div>
					<label for="message" class="block text-sm font-semibold">Message</label>
					<textarea
						id="message"
						name="message"
						rows="6"
						required
						class="mt-2 w-full resize-none rounded-sm border border-black/10 bg-card px-4 py-3 text-ink outline-none focus:border-accent"
					></textarea>
				</div>

				<div class="flex items-center gap-4">
					<button
						type="submit"
						class="rounded-pill bg-accent px-7 py-3.5 text-sm font-semibold text-accent-ink hover:bg-ink transition-colors"
					>
						Send message
					</button>
					<p id="form-note" class="text-sm text-muted">Opens your email client, pre-filled and ready to send.</p>
				</div>
			</form>

			<div class="flex flex-col gap-8">
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Email</p>
					<a href={`mailto:${email}`} class="mt-2 block font-semibold text-accent hover:underline">
						{email}
					</a>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Phone</p>
					<a href={`tel:${phone.replace(/\D/g, '')}`} class="mt-2 block font-semibold text-accent hover:underline">
						{phone}
					</a>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-widest text-muted">Location</p>
					<p class="mt-2 font-semibold">{city}</p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script define:vars={{ email }}>
	const form = document.getElementById('contact-form');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name') ?? '');
		const from = String(data.get('email') ?? '');
		const message = String(data.get('message') ?? '');

		const subject = `Portfolio contact from ${name}`;
		const body = `${message}\n\n— ${name} (${from})`;
		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	});
</script>
