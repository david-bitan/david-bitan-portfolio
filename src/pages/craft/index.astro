---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { craftItems } from '../../data/craftItems';
import { cld, SQUARE } from '../../lib/cloudinary';

const categories = ['All', ...Array.from(new Set(craftItems.map((c) => c.category)))];
---

<Layout title="Craft — David Bitan">
	<Nav />

	<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 sm:pt-20" data-reveal>
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Craft</p>
		<h1 class="mt-4 max-w-2xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			3D and digital painting, outside the product work.
		</h1>

		<div id="filters" class="mt-10 flex flex-wrap gap-3">
			{
				categories.map((category, i) => (
					<button
						type="button"
						data-filter={category}
						aria-pressed={i === 0}
						class="filter-btn rounded-pill border px-5 py-2 text-sm font-medium transition-colors"
					>
						{category}
					</button>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-24" data-reveal>
		<div id="craft-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			{
				craftItems.map((item) => (
					<a
						href={item.image}
						target="_blank"
						rel="noopener noreferrer"
						data-category={item.category}
						class="group block overflow-hidden rounded-md bg-card"
					>
						<div class="aspect-square">
							<img
								src={cld(item.image, SQUARE)}
								alt={item.title}
								loading="lazy"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.05]"
							/>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<ContactCTA />
</Layout>

<style>
	.filter-btn {
		border-color: color-mix(in srgb, var(--color-ink) 15%, transparent);
		color: var(--color-muted);
	}
	.filter-btn[aria-pressed='true'] {
		background-color: var(--color-ink);
		border-color: var(--color-ink);
		color: white;
	}
</style>

<script>
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
	const cards = Array.from(document.querySelectorAll<HTMLElement>('#craft-grid > [data-category]'));

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			cards.forEach((card) => {
				const match = filter === 'All' || card.dataset.category === filter;
				card.classList.toggle('hidden', !match);
			});
		});
	});
</script>
