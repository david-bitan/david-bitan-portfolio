---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionRule from '../components/SectionRule.astro';
import ZoneFilters from '../components/ZoneFilters.astro';

// Dedicated page for the "how this site was built" story. Linked from the
// /about AI section + the footer micro-mention. Kept medium-length (2-3
// screens): stack + role split + build stats + brief case study.

const stack = [
	{ label: 'Framework', value: 'Astro 7', why: 'Static-first and made for content sites. No JavaScript by default, so pages ship as light HTML.' },
	{ label: 'Styling', value: 'Tailwind CSS 4', why: 'Design tokens in CSS, no config file, tree-shaken to a tiny bundle.' },
	{ label: 'Images', value: 'Cloudinary', why: '260+ WebP assets, on-the-fly transforms, DPR-aware srcsets for retina.' },
	{ label: 'Hosting', value: 'Cloudflare Pages', why: 'Free tier, global CDN, HTTPS out of the box, auto-deploys from GitHub.' },
	{ label: 'Source', value: 'GitHub', why: 'Version control. Each push starts a Cloudflare Pages build.' },
	{ label: 'Editor', value: 'VS Code + Cowork (Claude)', why: 'Local editing plus a Claude session with file + shell access.' },
];

const claudeDid = [
	'Wrote most of the Astro + Tailwind code, refactored as the design evolved.',
	'Fixed CSS and build bugs (rolldown native bindings, corner-shape support, srcset breakpoints).',
	'Kept a versioned archive of every edit for one-click rollback (30+ snapshots).',
	'Suggested UX improvements: pill filters, Load More coordination, dark-first ordering.',
	'Kept the session memory file up to date, so a new chat picks up where the last one stopped.',
];

const davidDid = [
	'Set the direction: audience, tone, project selection, editorial angle.',
	'Reviewed every visual change in the browser, called out what didn’t work.',
	'Managed the Figma exports, Cloudinary uploads, and the Google Sheet CMS.',
	'Made the design calls: dropped the phone-mockup bezel experiment and kept the Behance grid.',
	'Ran every git push from PowerShell (Cowork sandbox blocks HTTPS to GitHub).',
];

// `sub` shown below the label for context. Kept optional so short stats
// stay clean.
type BuildStat = { n: string; label: string; sub?: string };

const buildStats: BuildStat[] = [
	{ n: '30+', label: 'Iteration checkpoints tracked locally' },
	{ n: '17', label: 'Pages designed + coded' },
	{ n: 'Solo', label: 'Designer + AI‑assisted dev' },
];

// Design tokens actually shipped — kept in sync with src/styles/global.css.
// Split into two blocks so the layout reads as "colors first, then shape".
const palette = [
	{ swatch: '#EAEDF2', name: 'Background', role: 'Near-white canvas: launchnow.design-inspired, easy on the eyes' },
	{ swatch: '#0A0A0A', name: 'Ink', role: 'Body copy + headlines, high contrast on the light bg' },
	{ swatch: '#4B5563', name: 'Muted', role: 'Secondary text, metadata, captions' },
	{ swatch: '#F25C24', name: 'Accent (dark)', role: 'Same role in dark mode: the brand orange on night blue' },
	{ swatch: '#0D101A', name: 'Dark mode', role: 'Night blue: page #0D101A, cards #1A2033, blue-grey text #EEF0F4 and #B8BDC8' },
];

const shape = [
	{ label: 'Typeface', value: 'Manrope 400 / 500 / 700 / 800', why: 'A geometric sans, set with tight tracking on headlines.' },
	{ label: 'Radius', value: '8px · 16px · pill', why: 'Buttons 8, cards 16, CTAs fully rounded. Three values only, no one-off radii.' },
	{ label: 'Corners', value: 'Squircle (superellipse 3)', why: 'iOS-style corners on rounded cards in browsers that support corner-shape. Other browsers show the normal radius.' },
	{ label: 'Dark mode', value: 'Night blue, orange kept', why: 'Same night blue as the footer. Accent orange is identical in both modes, so the brand reads the same.' },
];

const method = [
	{
		title: 'Pair with Claude via Cowork',
		body: 'Claude works in the repo with file and shell access. Claude writes the code, fixes bugs and suggests UX improvements. I make the design calls and review each change in the browser.',
	},
	{
		title: 'Versioned local archives before every edit',
		body: 'Before each real change, Claude saves a numbered snapshot in /archives/vNNN_.../ with a README and the rollback command. 30+ checkpoints so far, so a failed experiment can be undone in one click.',
	},
	{
		title: 'Session memory file',
		body: 'A file outside the repo, contexte-portfolio.md, holds the decisions, patterns and next steps. Each new chat session starts by reading it, so nothing is lost between sessions.',
	},
	{
		title: 'Content in Google Sheets, code in Astro',
		body: 'Projects, craft items, timeline and metadata live in a five-tab spreadsheet. TypeScript code reads it at build time. To change content, I edit the sheet and rebuild, with no CMS to host.',
	},
	{
		title: 'Behance-informed layout, own tokens',
		body: 'The grid and case-study format follow Behance. The visual tokens started from launchnow.design, and the final set keeps only what this site uses.',
	},
	{
		title: 'Ship in phases, review live',
		body: 'The work ran in phases: nav, layout, interactions, then SEO and backend. Each phase went live and got a review on the live URL before the next one began.',
	},
];
---

<Layout title="Colophon · How this site was built">
	<Nav />
	<main id="main" tabindex="-1">
	<ZoneFilters backHref="/about" backLabel="Back to About me" />

	<article class="mx-auto max-w-[1200px] px-6 pt-8 sm:pt-10 min-[1248px]:px-0" data-reveal>
		<a href="/about" data-top-back class="text-sm font-semibold text-accent-text hover:underline"><span class="arr-back" aria-hidden="true">→</span>Back</a>
		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">Colophon</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			How this site was built.
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted">
			The stack, the workflow and who did what. I built this portfolio with the same AI workflow it describes.
		</p>
	</article>
	<div class="sec-gap"></div>

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">The stack</h2>
		<div class="mt-title gap-cards grid grid-cols-1 sm:grid-cols-2">
			{
				stack.map((s) => (
					<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
						<p class="text-xs font-semibold uppercase tracking-widest text-muted">{s.label}</p>
						<p class="mt-2 text-lg font-bold">{s.value}</p>
						<p class="mt-2 text-sm text-muted">{s.why}</p>
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Design system</h2>
		<p class="mt-4 max-w-2xl text-muted">
			One small set of tokens for every page. The values live in <code class="rounded bg-ink/5 px-1.5 py-0.5 text-sm">global.css</code>.
		</p>

		<h3 class="mt-title text-sm font-semibold uppercase tracking-widest text-muted">Palette</h3>
		{/* Étape 12, 17: 2 per row on phones, like the AI Lab palettes; 5 on desktop. */}
		<div class="mt-4 gap-cards grid grid-cols-2 lg:grid-cols-5">
			{
				palette.map((c) => (
					<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
						<div
							class="h-16 w-full rounded-[4px] ring-1 ring-ink/10"
							style={`background-color: ${c.swatch};`}
							aria-hidden="true"
						/>
						<p class="mt-3 text-sm font-bold">{c.name}</p>
						<p class="mt-1 font-mono text-xs uppercase text-muted">{c.swatch}</p>
						<p class="mt-2 text-xs text-muted/90">{c.role}</p>
					</div>
				))
			}
		</div>

		<h3 class="mt-12 text-sm font-semibold uppercase tracking-widest text-muted">Type, shape, mode</h3>
		<div class="mt-4 gap-cards grid grid-cols-1 sm:grid-cols-2">
			{
				shape.map((s) => (
					<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
						<p class="text-xs font-semibold uppercase tracking-widest text-muted">{s.label}</p>
						<p class="mt-2 text-lg font-bold">{s.value}</p>
						<p class="mt-2 text-sm text-muted">{s.why}</p>
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Method</h2>
		<p class="mt-4 max-w-2xl text-muted">
			The habits and tools behind the build.
		</p>
		<div class="mt-title gap-cards grid grid-cols-1 sm:grid-cols-2">
			{
				method.map((m) => (
					<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
						<p class="text-base font-bold text-ink">{m.title}</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">{m.body}</p>
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Who did what</h2>
		<p class="mt-4 max-w-2xl text-muted">
			I worked with Claude as a pair, and each of us had a clear part of the job.
		</p>

		<div class="mt-title gap-cards grid grid-cols-1 sm:grid-cols-2">
			<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
				<p class="text-sm font-semibold uppercase tracking-widest text-accent-text">Claude did</p>
				<ul class="mt-4 flex flex-col gap-3">
					{
						claudeDid.map((line) => (
							<li class="flex items-start gap-3 text-muted">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
								<span>{line}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
				<p class="text-sm font-semibold uppercase tracking-widest text-accent-text">I did</p>
				<ul class="mt-4 flex flex-col gap-3">
					{
						davidDid.map((line) => (
							<li class="flex items-start gap-3 text-muted">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
								<span>{line}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Build stats</h2>
		{/* Étape 12, 18: the 3 side by side on one line, each centred. */}
		<div class="mt-title grid grid-cols-3 gap-4 sm:gap-8">
			{
				buildStats.map((s) => (
					<div class="text-center">
						<p class="text-3xl font-extrabold tracking-tight sm:text-4xl">{s.n}</p>
						<p class="mt-2 text-sm text-muted">{s.label}</p>
						{s.sub && <p class="mt-1 text-xs text-muted/80">{s.sub}</p>}
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">A note on honesty</h2>
		<div class="mt-title max-w-2xl space-y-4 text-lg text-muted">
			<p>
				I designed the projects in Selected Work by hand, with the tools each project needed: Figma, and earlier Photoshop and Illustrator, plus Cinema 4D, ZBrush, After Effects or Spline when a project called for motion or 3D.
			</p>
			<p>
				In 2025 and 2026, AI changed how I build what sits around the work: this portfolio, its filters and its case-study pages. My design craft stayed the same.
			</p>
		</div>
	</section>
	<div class="sec-gap"></div>

	</main>
	<Footer />
</Layout>
