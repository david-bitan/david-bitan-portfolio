---
import { testimonials, LINKEDIN_RECOMMENDATIONS_URL } from '../data/testimonials';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Sourced from ../../CV_David_Bitan_2026_v3.docx and ../../portfolio-cms-v2.xlsx (Timeline sheet).
const timeline = [
	{
		range: '2019 - 2026',
		role: 'Senior Product Designer · UI/UX & AI',
		company: 'Ryze Beyond (formerly TrafficPoint)',
		highlights: [
			'Often the only product designer on a project, across every company website and product, growing with the company from 32 to 110+ employees',
			'Sonary Software Stack Manager (SaaS dashboard): sole designer from user interviews to shipped UI: 6 core surfaces including an AI chatbot for natural-language queries, dark and light modes, 96 shipped screens from a 2,000+ frame Figma project, full visual redesign delivered in 9 working days',
			'Sonary comparison platform: three major redesigns; design system behind 1,400+ indexed pages across 37 software categories, WordPress → Webflow migration',
			'Top5: parametric Figma design system (variables, inherited color tokens) serving ~40 verticals from one component library',
			'Playright (UK online casino comparison): redesigned the homepage and ranking pages, with hover animations coded in HTML/CSS and UKGC responsible-gambling requirements built in',
			'Also: Ryze Beyond brand site (2026 redesign), Ryze Hub internal portal (self-initiated), Sonary email template system',
			'Shared tips, tools and design-system practices with the designers who joined the team over the years',
			'User research, usability testing, A/B testing, personas, journey mapping, grounded decisions in real behavior',
			'5 breakpoints per product, WCAG accessibility built in, developer handoff and post-implementation design QA',
			'Motion and visual craft: SVG micro-interactions and loaders, UI animation, brand logos and marks, 3D concept explorations, and short-form video for product and marketing',
			'AI-augmented workflow (Claude, ChatGPT, Midjourney, Leonardo AI, Adobe Firefly, Figma AI) letting one designer cover the output of a three-person team',
		],
	},
	{
		range: '2018 - 2019',
		role: 'Senior UI/UX Designer',
		company: 'Smart.bid (LoanMax Team)',
		highlights: [
			'Led UI/UX for the LoanMax brand and its sub-brands across all platforms',
			'Rebranded the website, mobile web, and payment application end-to-end',
			'Built a financial portal from scratch: wireframes, UX flows, UI design, and hand-off specs',
			'Produced design materials for landing pages, blogs, marketing sites, and social',
		],
	},
	{
		range: '2017 - 2018',
		role: 'Senior UI/UX Designer',
		company: 'Wochat (now Slatch)',
		highlights: [
			'Live voice, text, and video translation messaging app, owned all design aspects (sketches, user flows, wireframes, specs) for the mobile app',
			'Researched new features and ideas; owned Wochat brand identity from scratch',
			'Specified and designed both mobile and desktop sites; built page templates in HTML5 / CSS3',
			'Designed landing pages, marketing banners, and micro-animations',
		],
	},
	{
		range: '2015 - 2017',
		role: 'UI/UX Designer',
		company: 'GamingTech (SBTech Group)',
		highlights: [
			'Sports betting and casino gaming products: sketches, wireframes, and full UI design for mobile and web',
			'Owned branding, specification, and design for the 10Bet, Real Deal Bet, and Bet Rally brands',
			'Designed responsive landing pages, product surfaces, and applications',
			'Produced marketing banners and interactive calendars, including animated interactive banners built in HTML5 / CSS3',
		],
	},
	{
		range: '2013 - 2015',
		role: 'Interactive & UI/UX Designer',
		company: 'Mench · Qdigital',
		highlights: [
			'Digital advertising agency, designed campaigns and interactive experiences for major Israeli brands including Israel Discount Bank, Coca-Cola, and Laline',
			'Rich media banners, campaign microsites, and landing pages across Flash and HTML5 / CSS3',
			'Owned art direction on multi-client briefs, from concept through delivery',
		],
	},
	{
		range: '2011 - 2013',
		role: 'Interactive Art Designer',
		company: 'IGMD Affeurope · Tradologic',
		highlights: [
			'White-label casino platform provider for online operators: designed operator-facing interfaces and player-facing UI',
			'Trading widgets, casino lobbies, gaming HUDs, and promotional landing pages',
			'Delivered animated marketing assets in Flash / HTML5 for multi-market rollouts',
		],
	},
	{
		range: '2006 - 2011',
		role: 'Interactive Art Designer',
		company: 'Arc Interactive (Publicis Group)',
		highlights: [
			'Digital advertising agency inside Publicis Group, designed campaigns for major brands including Nokia, Cadillac, Chevrolet and Bank Leumi',
			'Interactive rich media, campaign microsites, and animated banner ecosystems in Flash and HTML5',
			'Contributed to team-designed campaigns awarded 12+ Cactus prizes (Gold, Silver, Bronze), Israel\'s top advertising awards, across five years at Arc Interactive, 2006–2011',
			'Cross-discipline collaboration with creative directors, copywriters, developers, and account teams inside a full-service agency',
		],
	},
	{
		range: '2003 - 2005',
		role: 'Department Manager & Print Designer',
		company: 'Gestimo',
		highlights: [
			'First professional role, managed the in-house print and digital design department at an Israeli real-estate advertising firm',
			'Directed print collateral (brochures, catalogs, ads) and early web campaigns; oversaw output quality across a small design team',
		],
	},
];

const skillGroups = [
	{
		title: 'UX methods & design',
		items: [
			'User Research',
			'Usability Testing',
			'A/B Testing',
			'Personas',
			'Journey Mapping',
			'Competitive Analysis',
			'Wireframing',
			'Prototyping',
			'Information Architecture',
			'Interaction Design',
			'Responsive & Mobile-First Design',
			'Accessibility (WCAG)',
			'Design Systems',
		],
	},
	{
		title: 'Design tools',
		items: ['Figma (primary)', 'Photoshop', 'Illustrator', 'Sketch', 'After Effects', 'Cinema 4D', 'ZBrush'],
	},
	{
		title: 'AI tools',
		items: [
			'Claude (Code, Artifacts, Skills, Cowork)',
			'AI Agents',
			'ChatGPT',
			'Gemini',
			'Midjourney',
			'Leonardo AI',
			'Adobe Firefly',
			'Figma AI',
			'Adobe AI (Illustrator, Photoshop, After Effects)',
			'Runway · Sora · Kling · Higgsfield (video gen)',
		],
	},
	{
		title: 'Visual & motion',
		items: [
			'Iconography',
			'Vector Illustration',
			'SVG micro-interactions (SVGator)',
			'Adobe Animate (formerly Flash)',
			'CapCut',
		],
	},
	{
		title: 'Code',
		items: [
			'HTML5',
			'CSS3 (Flexbox & Grid)',
		],
	},
];

const linkedinUrl = 'https://www.linkedin.com/in/david-bitan';

const languages = [
	{ lang: 'French', level: 'Native' },
	{ lang: 'Hebrew', level: 'Fluent' },
	{ lang: 'English', level: 'Professional working proficiency' },
];
---

<Layout
	title="About · David Bitan"
	description="Senior AI Product Designer across SaaS, fintech, iGaming and digital advertising. Experience, skills and tools, plus how this AI-native portfolio was built."
>
	<Nav />

	<section class="mx-auto max-w-[1200px] px-6 pt-16 pb-10 sm:pt-20 lg:px-0" data-reveal>
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">About</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			Product design craft, now <span class="whitespace-nowrap">AI-native.</span>
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted">
			Senior AI Product Designer across SaaS, fintech, iGaming and digital advertising,
			focused on AI-augmented product design and AI UX. Often the only product designer at Ryze Beyond
			(2019–2026): the AI-augmented workflow lets a single senior handle what used to take a full team.
		</p>
		<p class="mt-4 text-sm font-semibold text-ink">Available now · <span class="whitespace-nowrap">Tel Aviv–Ashkelon area</span> · <span class="whitespace-nowrap">Hybrid or remote</span></p>
		<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
			<a href={linkedinUrl} target="_blank" rel="noopener" class="text-accent-text hover:underline">LinkedIn ↗</a>
			<a href="/cv/CV-David-Bitan.pdf" class="text-accent-text hover:underline">Download CV (PDF)</a>
			<a href="/cv/CV-David-Bitan.docx" class="text-accent-text hover:underline">Download CV (DOCX)</a>
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 pt-6 lg:px-0" data-reveal>
		<div class="max-w-2xl border-l-2 border-accent pl-6">
			<p class="text-lg font-semibold">Mentor at heart.</p>
			<p class="mt-2 text-muted">
				At every company I've worked for, I helped onboard the designers who joined the team,
				with honest, encouraging design reviews, and shared tips and design-system practices
				with them.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-0" data-reveal>
		<div class="rounded-lg border border-ink/10 bg-card p-8 sm:p-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-text">How this site was built</p>
			<p class="mt-4 max-w-2xl text-lg">
				This portfolio was designed and shipped in about two weeks of evening sessions,
				in pair with Claude, Anthropic's AI. Design decisions, copy, and code all came
				out of the same conversation. A live demonstration of the workflow the rest of
				this site is about.
			</p>
			<a
				href="/colophon"
				class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-text hover:underline"
			>
				Read the full colophon
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.4"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
				>
					<path d="M5 12h14" />
					<path d="M13 5l7 7-7 7" />
				</svg>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Experience</h2>
		<div class="mt-10 flex flex-col">
			{
				timeline.map((entry) => (
					<div class="grid grid-cols-1 gap-2 border-t border-ink/5 py-8 sm:grid-cols-[160px_1fr] sm:gap-8">
						<p class="font-semibold text-muted">{entry.range}</p>
						<div>
							<p class="text-lg font-semibold">
								{entry.role} <span class="font-normal text-muted">· {entry.company}</span>
							</p>
							<ul class="mt-3 flex flex-col gap-1.5">
								{entry.highlights.map((highlight) => (
									<li class="flex items-start gap-3 text-muted">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
										<span>{highlight}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section id="recommendations" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 py-16 lg:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Recommendations</h2>
		<p class="mt-3 max-w-2xl text-muted">
			Quoted in full from LinkedIn, in the authors' own words.
		</p>
		<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
			{
				testimonials.map((t) => (
					<figure class="flex flex-col rounded-md bg-card p-6 sm:p-8">
						<blockquote class="flex-1 space-y-4 leading-relaxed text-ink">
							{t.text.map((para) => <p>{para}</p>)}
						</blockquote>
						<figcaption class="mt-6 border-t border-ink/10 pt-4">
							<p class="font-semibold">{t.name}</p>
							<p class="mt-0.5 text-sm text-muted">{t.role} · {t.relation}</p>
						</figcaption>
					</figure>
				))
			}
		</div>
		<a href={LINKEDIN_RECOMMENDATIONS_URL} target="_blank" rel="noopener" class="mt-8 inline-block text-sm font-semibold text-accent-text hover:underline">
			See all recommendations on LinkedIn ↗
		</a>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Skills</h2>
		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div class="rounded-md bg-card p-6">
						<p class="font-semibold">{group.title}</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="rounded-pill bg-bg px-3 py-1 text-xs font-medium text-muted">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-0" data-reveal>
		<div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-24">
			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Languages</h2>
				<ul class="mt-6 flex flex-col gap-3">
					{
						languages.map((l) => (
							<li class="flex items-baseline justify-between border-b border-ink/5 pb-3">
								<span class="font-semibold">{l.lang}</span>
								<span class="text-muted">{l.level}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Awards & education</h2>
				<div class="mt-6 flex flex-col gap-6">
					<div>
						<p class="font-semibold">
							<span class="text-accent-text">🏆</span> Cactus Gold, Silver & Bronze
						</p>
						<p class="mt-1 text-muted">
							Israel's top advertising awards, for Israeli campaigns. Team contributor on 12+ Cactus
							wins (Gold, Silver, Bronze) over five years at Arc Interactive (Publicis Group), 2006–2011.
						</p>
					</div>
					<div>
						<p class="font-semibold">ORT Strasbourg (France)</p>
						<p class="mt-1 text-muted">
							Software Engineering School · Specification, design & programming of web
							applications
						</p>
					</div>
					<div>
						<p class="font-semibold">UI/UX Design Certification</p>
						<p class="mt-1 text-muted">Tal Florentin (Israel)</p>
					</div>
					<div>
						<p class="font-semibold">Self-taught, continuously</p>
						<p class="mt-1 text-muted">
							Hundreds of design courses: Udemy, YouTube, and community platforms
							(Le Site du Zéro → OpenClassrooms). I've always been driven to learn (new tools,
							new techniques, new craft) to stay current with the best tech and software in the
							design field.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
