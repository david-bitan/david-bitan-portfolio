---
import { testimonials, LINKEDIN_RECOMMENDATIONS_URL } from '../data/testimonials';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ZoneFilters from '../components/ZoneFilters.astro';
import RecByline from '../components/RecByline.astro';
import SectionRule from '../components/SectionRule.astro';

// Sourced from ../../CV_David_Bitan_2026_v3.docx and ../../portfolio-cms-v2.xlsx (Timeline sheet).
const timeline = [
	{
		range: '2019 – 2026',
		role: 'Senior Product Designer · UI/UX & AI',
		company: 'Ryze Beyond (formerly TrafficPoint)',
		highlights: [
			'At Ryze Beyond, I owned my projects end to end, across every company website and product, as the company grew from 32 to 110+ employees. The design team ranged from 1 to 4 people: when designers joined, we split the projects, each very different from the others, to share the workload; when they moved on, I took them all back.',
			'Sonary Software Stack Manager (SaaS dashboard): product designer from user interviews to shipped UI: 6 core surfaces including an AI chatbot for natural-language queries, dark and light modes, 96 shipped screens from a 2,000+ frame Figma project',
			'Sonary comparison platform: three major redesigns; design system behind 1,400+ indexed pages across 37 software categories, WordPress to Webflow migration',
			'Top5: parametric Figma design system (variables, inherited color tokens) serving 40+ verticals from one component library',
			'Playright (UK online casino comparison): redesigned the homepage and ranking pages, with hover animations coded in HTML/CSS and UKGC responsible-gambling requirements built in',
			'Also: Ryze Beyond brand site (2026 redesign), Sonary email template system',
			'Helped onboard the designers who joined the team',
			'User research, usability testing, A/B testing, personas, journey mapping, grounded decisions in real behavior',
			'5 breakpoints per product, developer handoff and post-implementation design QA',
			'Motion and visual craft: SVG micro-interactions and loaders, UI animation, brand logos and marks, 3D concept explorations, and short-form video for product and marketing',
			'AI-augmented workflow (Claude, ChatGPT, Midjourney, Leonardo AI, Adobe Firefly, Figma AI, Gamma)',
		],
	},
	{
		range: '2018 – 2019',
		role: 'Senior UI/UX Designer',
		company: 'Smart.bid (LoanMax Team)',
		highlights: [
			'Led UI/UX for LoanMax and its sub-brands: web, mobile and app.',
			'Rebranded the website, mobile and payment app.',
			'Designed a financial portal from scratch.',
			'Landing pages, blog templates, marketing sites and social media visuals.',
		],
	},
	{
		range: '2017 – 2018',
		role: 'Senior UI/UX Designer',
		company: 'Wochat (now Slatch)',
		highlights: [
			'Live voice, text, and video translation messaging app, owned all design aspects (sketches, user flows, wireframes, specs) for the mobile app',
			'Researched new features and ideas; owned Wochat brand identity from scratch',
			'Specified and designed both mobile and desktop sites; built page templates in HTML5 / CSS3',
			'Designed landing pages, marketing banners, and micro-animations',
		],
	},
	{
		range: '2015 – 2017',
		role: 'UI/UX Designer',
		company: 'GamingTech (SBTech Group)',
		highlights: [
			'Sports betting and casino gaming products: sketches, wireframes, and full UI design for mobile and web',
			'Owned branding, specification, and design for the 10Bet, Real Deal Bet, and Bet Rally brands',
			'Designed responsive landing pages, product surfaces, and applications',
			'Produced marketing banners and interactive calendars, including animated interactive banners built in HTML5 / CSS3',
		],
	},
	{
		range: '2013 – 2015',
		role: 'Interactive & UI/UX Designer',
		company: 'Mench · Qdigital',
		highlights: [
			'Media agency, designed campaigns and interactive experiences for major Israeli brands including Israel Discount Bank, Coca-Cola, and Laline',
			'Rich media banners, campaign microsites, and landing pages across Flash and HTML5 / CSS3',
			'Owned art direction on campaigns for several brands, from concept through delivery',
		],
	},
	{
		range: '2011 – 2013',
		role: 'Interactive Art Designer',
		company: 'IGMD Affeurope · Tradologic',
		highlights: [
			'White-label casino platform provider for online operators: designed operator-facing interfaces and player-facing UI',
			'Casino lobbies and promotional landing pages',
			'Delivered animated marketing assets in Flash / HTML5 for multi-market rollouts',
		],
	},
	{
		range: '2006 – 2011',
		role: 'Interactive Art Designer',
		company: 'Arc Interactive (Publicis Group)',
		highlights: [
			'Media agency inside Publicis Group, designed campaigns for major brands including Nokia, Cadillac, Chevrolet and Bank Leumi',
			'Interactive rich media, campaign microsites, and animated banner ecosystems in Flash and HTML5',
			'Contributed to team-designed campaigns awarded 12+ Cactus prizes (Gold, Silver, Bronze), Israel’s top advertising awards, across five years at Arc Interactive, 2006 – 2011',
			'Cross-discipline collaboration with creative directors, copywriters, developers, and account teams inside a full-service agency',
		],
	},
];

// Étape 12, 9: tags of each card reordered to fill the lines (same groups,
// same tags, first tag kept). Étape 13, 21-22: one bubble per tool, plus
// Atomic Design and Character Animation; order filled again.
const skillGroups = [
	{
		title: 'UX methods & design',
		items: [
			'User Research',
			'Usability Testing',
			'A/B Testing',
			'Interaction Design',
			'Information Architecture',
			'Personas',
			'Competitive Analysis',
			'Prototyping',
			'Journey Mapping',
			'Wireframing',
			'Atomic Design',
			'Design Systems',
			'Responsive & Mobile-First Design',
		],
	},
	{
		title: 'Design tools',
		items: ['Figma (primary)', 'Photoshop', 'Illustrator', 'Sketch', 'After Effects', 'Cinema 4D', 'ZBrush'],
	},
	{
		title: 'AI tools',
		items: [
			'Claude (Code, Artifacts, Skills, Cowork)',
			'AI Agents',
			'ChatGPT',
			'Midjourney',
			'Figma AI',
			'Runway',
			'Sora',
			'Kling',
			'Higgsfield',
			'Adobe Firefly',
			'Gemini',
			'Leonardo AI',
			'Adobe AI',
			'Illustrator',
			'Photoshop',
			'After Effects',
			'Gamma',
		],
	},
	{
		title: 'Visual & motion',
		items: [
			'Iconography',
			'SVG micro-interactions',
			'Vector Illustration',
			'Adobe Animate',
			'SVGator',
			'Character Animation',
			'CapCut',
		],
	},
	{
		title: 'Code',
		items: [
			'HTML5',
			'CSS3',
			'Flexbox',
			'Grid',
		],
	},
];

const linkedinUrl = 'https://www.linkedin.com/in/david-bitan';

const languages = [
	{ lang: 'French', level: 'Native' },
	{ lang: 'Hebrew', level: 'Fluent' },
	{ lang: 'English', level: 'Professional working proficiency' },
];
import DownloadCV from '../components/DownloadCV.astro';
---

<Layout
	title="About · David Bitan"
	description="Senior AI Product Designer for SaaS, fintech and iGaming products and websites, focused on AI-augmented design and AI UX. Experience, skills and tools, plus how this AI-native portfolio was built."
>
	<Nav />
	<main id="main" tabindex="-1">
	<ZoneFilters backHref="/" backLabel="Back to home" />

	<section class="mx-auto max-w-[1200px] px-6 pt-8 sm:pt-10 min-[1248px]:px-0" data-reveal>
		{/* Étape 12, 6: a "← Back" link at the top of every inner page. */}
		<a href="/" data-top-back class="text-sm font-semibold text-accent-text"><span class="arr-back" aria-hidden="true">→</span>Back</a>
		<p class="mt-8 text-sm font-semibold uppercase tracking-widest text-muted">About me</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
			Product design craft, now <span class="whitespace-nowrap">AI-native.</span>
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted max-lg:text-[16px] max-lg:leading-7">
			Senior AI Product Designer for SaaS, fintech and iGaming products and websites, focused on AI-augmented design and AI UX. At Ryze Beyond (2019 – 2026), I owned my projects end to end. The design team ranged from 1 to 4 people: when designers joined, we split the projects, each very different from the others, to share the workload; when they moved on, I took them all back.
		</p>
		<p class="mt-4 text-sm font-semibold text-ink">Available now · <span class="whitespace-nowrap">Ashkelon, Israel</span> · <span class="whitespace-nowrap">Hybrid or remote, Tel Aviv area</span></p>
		{/* Étape 12, 10 + 15, S50: one line, LinkedIn ↗ then the CV block, 32 px apart, no dot. */}
		<div class="mt-6 flex flex-wrap items-center gap-x-8 text-sm">
			<a href={linkedinUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-semibold text-accent-text">LinkedIn<span class="sr-only"> (opens in a new tab)</span><span class="ext-arr" aria-hidden="true">↗</span></a>
			<DownloadCV />
		</div>
	</section>

	<section class="mx-auto max-w-[1200px] px-6 pt-6 min-[1248px]:px-0" data-reveal>
		<div class="max-w-2xl border-l-2 border-accent pl-6">
			<p class="text-lg font-semibold">Mentor at heart.</p>
			<p class="mt-2 text-muted">
				At every company I’ve worked for, I helped onboard the designers who joined the team,
				with honest, encouraging design reviews, and shared tips and design-system practices
				with them.
			</p>
		</div>
	</section>
	<div class="sec-gap"></div>

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<div class="box-line rounded-lg bg-card p-card">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-text">How this site was built</p>
			<p class="mt-4 max-w-2xl text-lg">
				I designed and built this portfolio with AI (Claude).
			</p>
			<a
				href="/colophon"
				class="-mb-3 mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent-text"
			>
				Read the full colophon
				<span class="arr arr-x" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Experience</h2>
		<div class="mt-title flex flex-col">
			{
				timeline.map((entry) => (
					<div class="grid grid-cols-1 gap-2 border-t border-ink/5 py-8 sm:grid-cols-[160px_1fr] sm:gap-8">
						<p class="whitespace-nowrap font-semibold text-muted">{entry.range}</p>
						<div>
							<p class="text-lg font-semibold">
								{entry.role}<span class="eb-gap"> </span><span class="font-normal text-muted">{entry.company}</span>
							</p>
							<ul class="mt-3 flex flex-col gap-1.5">
								{entry.highlights.map((highlight) => (
									<li class="flex items-start gap-3 text-muted">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
										<span>{highlight}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section id="recommendations" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Recommendations</h2>
		<p class="mt-2 max-w-2xl text-muted">
			Quoted in full from LinkedIn, in the authors’ own words.
		</p>
		{/* Étape 16, S80: back to the V5 layout (grid, 2 columns on desktop, 1 below),
		    in David's order (Elad first); text 13 px. The cascade of S54 is gone. */}
		{/* Étape 17, S96: closed cards all have the height of the shortest recommendation
		    shown in full; "Read more" opens the cards of its row together (see the script
		    at the end of the page). */}
		{/* V11, S113 + S125.1: the closed cards now work at every width; cards per row
		    (.reco-grid, CSS below): 1 under 640 px, 2 from 640 px, 3 on a landscape screen
		    at least 900 px wide and 500 px high, and 3 above 1366 px wide. */}
		<div id="reco-grid" class="reco-grid mt-title gap-cards grid">
			{
				testimonials.map((t) => (
					/* Étape 13, 18: author (photo, name, role, company) at the top of
					   the card, then the quote marks as on the home page, then the text. */
					<figure class="reco-card flex flex-col rounded-md bg-card p-card">
						<RecByline t={t} top />
						<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 text-accent" fill="currentColor">
							<path d="M9.5 6C6.5 6.6 4 9.3 4 13v5h6v-6H7c.2-2 1.4-3.4 3.2-3.9L9.5 6Zm10 0c-3 .6-5.5 3.3-5.5 7v5h6v-6h-3c.2-2 1.4-3.4 3.2-3.9L19.5 6Z" />
						</svg>
						<div class="reco-clip mt-4">
							<blockquote class="space-y-4 text-[13px] leading-[1.6] text-ink">
								{t.text.map((para) => <p>{para}</p>)}
							</blockquote>
						</div>
						<button type="button" class="reco-more mt-auto min-h-11 self-start text-[13px] font-semibold text-accent-text" aria-expanded="false">Read more</button>
					</figure>
				))
			}
		</div>
		{/* Étape 13, 19: centred. */}
		<div class="mt-btn flex justify-center">
			<a href={LINKEDIN_RECOMMENDATIONS_URL} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm font-semibold text-accent-text">
				Read all recommendations on LinkedIn<span class="sr-only"> (opens in a new tab)</span><span class="ext-arr" aria-hidden="true">↗</span>
			</a>
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Skills</h2>
		<div class="mt-title gap-cards grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div class="rounded-md bg-card p-card">
						<p class="font-semibold">{group.title}</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="rounded-pill bg-bg px-3 py-1 text-xs font-medium text-muted">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>
	<SectionRule />

	<section class="mx-auto max-w-[1200px] px-6 min-[1248px]:px-0" data-reveal>
		<div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-24">
			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Languages</h2>
				<ul class="mt-title flex flex-col gap-3">
					{
						languages.map((l) => (
							<li class="flex items-baseline justify-between border-b border-ink/5 pb-3">
								<span class="font-semibold">{l.lang}</span>
								<span class="text-muted">{l.level}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Awards & education</h2>
				<div class="mt-title flex flex-col gap-6">
					<div>
						<p class="font-semibold">
							Cactus Gold, Silver & Bronze
						</p>
						<p class="mt-1 text-muted">
							Israel’s top advertising awards, for Israeli campaigns. Team contributor on 12+ Cactus
							wins (Gold, Silver, Bronze) over five years at Arc Interactive (Publicis Group), 2006 – 2011.
						</p>
					</div>
					<div>
						<p class="font-semibold">ORT Strasbourg (France)</p>
						<p class="mt-1 text-muted">
							Software Engineering School · Specification, design & programming of web
							applications
						</p>
					</div>
					<div>
						<p class="font-semibold">UI/UX Design Certification · Tal Florentin</p>
					</div>
					<div>
						<p class="font-semibold">Ongoing learning</p>
						<p class="mt-1 text-muted">
							Udemy, UX Planet, YouTube, OpenClassrooms (formerly Site du Zéro). I keep learning new AI tools and UI/UX design techniques.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	<div class="sec-gap"></div>

	</main>
	<Footer />
</Layout>

<style is:global>
	/* V11, S125.1: recommendations per row. 1 under 640 px; 2 from 640 px (tablet in
	   portrait, phone in landscape); 3 on a landscape screen (wider than high) at least
	   900 px wide and 500 px high (tablet in landscape, laptop, desktop), and 3 above
	   1366 px wide even in portrait. A phone in landscape (under 500 px high) keeps 2. */
	.reco-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); }
	@media (min-width: 640px) { .reco-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (orientation: landscape) and (min-width: 900px) and (min-height: 500px) { .reco-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	@media (min-width: 1366.02px) { .reco-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	/* Étape 17, S96 (V11, S113: at every width): "Read more" only on the cards whose text
	   is cut (the script turns it on). */
	.reco-more { display: none; }
	.reco-more.is-on { display: inline-flex; align-items: center; }
	/* Étape 18, S113: closed card, "…" right after the last visible word (set by the
	   script); it fades out when the card opens. */
	.reco-card { position: relative; }
	.reco-ell {
		position: absolute;
		font-size: 13px;
		line-height: normal;
		color: var(--color-ink);
		pointer-events: none;
		transition: opacity 150ms ease;
	}
	@media (prefers-reduced-motion: reduce) { .reco-ell { transition: none; } }
</style>

<script>
	// Étape 17, S96: About page, recommendations (V11: at every width).
	// Closed: every card has the height of the shortest recommendation shown in full
	// (H0); longer texts are cut on a line boundary, with "Read more" at the bottom of the
	// card. A click opens the 3 cards of its row together (each card keeps its own text,
	// the row takes the height of its longest card), the row's links become "Read less";
	// another click closes the row. Other rows stay as they are. Soft open (450 ms) and
	// close (350 ms); instant with "reduce motion".
	// V11, S113 + S125.1: the same at every width (phone, tablet, desktop). A "row" is
	// the cards side by side on the screen at that moment (1, 2 or 3, CSS .reco-grid).
	// When the number per row changes (window resized, tablet turned), every row closes
	// and the cards are measured again.
	const grid = document.getElementById('reco-grid');
	if (grid) {
		let COLS = 0;
		const cards = Array.from(grid.querySelectorAll<HTMLElement>('.reco-card'));
		const rowOf = (i: number) => Math.floor(i / COLS);
		const rows = new Map<number, HTMLElement[]>();
		const openRows = new Set<number>();
		const colsNow = () => getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length || 1;
		function setCols() {
			const n = colsNow();
			if (n === COLS) return;
			COLS = n;
			openRows.clear();
			rows.clear();
			cards.forEach((c, i) => rows.set(rowOf(i), [...(rows.get(rowOf(i)) ?? []), c]));
		}
		const ease = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
		const clipOf = (c: HTMLElement) => c.querySelector<HTMLElement>('.reco-clip')!;
		const btnOf = (c: HTMLElement) => c.querySelector<HTMLButtonElement>('.reco-more')!;
		const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let cut = new Map<HTMLElement, number>(); // card -> height of its cut text
		let H0 = 0;

		// Étape 18, S113: the "…" after the last visible word of a closed card.
		const ellOf = (c: HTMLElement) => {
			let e = c.querySelector<HTMLElement>('.reco-ell');
			if (!e) { e = document.createElement('span'); e.className = 'reco-ell'; e.setAttribute('aria-hidden', 'true'); e.textContent = '…'; c.appendChild(e); }
			return e;
		};
		function placeEll(c: HTMLElement, h: number) {
			const bq = clipOf(c).querySelector('blockquote')!;
			const top = clipOf(c).getBoundingClientRect().top;
			const range = document.createRange();
			const walker = document.createTreeWalker(bq, NodeFilter.SHOW_TEXT);
			let last: DOMRect | null = null;
			let done = false;
			while (!done && walker.nextNode()) {
				const n = walker.currentNode as Text;
				const re = /\S+/g;
				let m: RegExpExecArray | null;
				while ((m = re.exec(n.data))) {
					range.setStart(n, m.index); range.setEnd(n, m.index + m[0].length);
					const rs = range.getClientRects(); const r = rs[rs.length - 1];
					if (!r) continue;
					if (r.bottom - top <= h + 0.5) last = r; else { done = true; break; }
				}
			}
			const e = ellOf(c);
			if (!last) { e.style.opacity = '0'; return; }
			const box = c.getBoundingClientRect();
			e.style.left = last.right - box.left + 'px';
			e.style.top = last.top - box.top + 'px';
			e.style.opacity = '1';
		}
		// V11: a new measure (tablet turned, window resized) stops a row that is still
		// opening or closing, and that old animation's end does nothing.
		let gen = 0;
		const running: Animation[] = [];
		function reset() {
			gen++;
			running.splice(0).forEach((a) => a.cancel());
			cards.forEach((c) => c.querySelector('.reco-ell')?.remove());
			cards.forEach((c) => {
				c.style.height = '';
				clipOf(c).style.height = '';
				clipOf(c).style.overflow = '';
				btnOf(c).classList.remove('is-on');
			});
			cut = new Map();
		}
		// last text line that ends within `room` px of the top of the text block
		function snap(c: HTMLElement, room: number) {
			const clip = clipOf(c);
			const top = clip.getBoundingClientRect().top;
			const lineH = parseFloat(getComputedStyle(clip.querySelector('blockquote')!).lineHeight) || 20.8;
			const range = document.createRange();
			range.selectNodeContents(clip.querySelector('blockquote')!);
			let best = 0;
			for (const r of Array.from(range.getClientRects())) {
				const bottom = r.bottom - top + (lineH - r.height) / 2;
				if (bottom <= room + 0.5 && bottom > best) best = bottom;
			}
			return Math.round(best);
		}
		function layout() {
			reset();
			setCols();
			// 1. natural height of every card alone (text whole, no link): the shortest is H0
			cards.forEach((c) => (c.style.alignSelf = 'start'));
			const alone = cards.map((c) => c.offsetHeight);
			H0 = Math.min(...alone);
			// 2. the cards taller than H0 get the link and a text cut on a line boundary
			cards.forEach((c, i) => {
				if (alone[i] <= H0 + 0.5) return; // fits whole: no link
				const clip = clipOf(c);
				btnOf(c).classList.add('is-on');
				clip.style.height = '0px';
				const room = H0 - c.offsetHeight; // room for the text next to the card's other parts
				clip.style.height = '';
				cut.set(c, snap(c, room));
			});
			cards.forEach((c) => (c.style.alignSelf = ''));
			// 3. closed state (a row that was open stays open)
			cards.forEach((c, i) => {
				const r = rowOf(i);
				const clip = clipOf(c);
				const btn = btnOf(c);
				if (cut.has(c)) {
					btn.classList.add('is-on');
					btn.textContent = openRows.has(r) ? 'Read less' : 'Read more';
					btn.setAttribute('aria-expanded', openRows.has(r) ? 'true' : 'false');
				}
				if (openRows.has(r)) { if (cut.has(c)) ellOf(c).style.opacity = '0'; return; }
				c.style.height = H0 + 'px';
				if (cut.has(c)) { clip.style.height = cut.get(c)! + 'px'; clip.style.overflow = 'hidden'; }
			});
			cards.forEach((c, i) => { if (cut.has(c) && !openRows.has(rowOf(i))) placeEll(c, cut.get(c)!); });
		}
		function toggle(r: number) {
			const row = rows.get(r)!;
			const opening = !openRows.has(r);
			const fast = reduce();
			const start = row.map((c) => ({ card: c, h: c.getBoundingClientRect().height, clip: clipOf(c).getBoundingClientRect().height }));
			// target heights
			row.forEach((c) => { c.style.height = ''; clipOf(c).style.height = ''; clipOf(c).style.overflow = ''; });
			let end: { h: number; clip: number }[];
			if (opening) {
				row.forEach((c) => (c.style.alignSelf = ''));
				end = row.map((c) => ({ h: c.getBoundingClientRect().height, clip: clipOf(c).getBoundingClientRect().height }));
			} else {
				end = row.map((c) => ({ h: H0, clip: cut.has(c) ? cut.get(c)! : clipOf(c).getBoundingClientRect().height }));
			}
			if (opening) openRows.add(r); else openRows.delete(r);
			row.forEach((c) => {
				const b = btnOf(c);
				if (cut.has(c)) { b.textContent = opening ? 'Read less' : 'Read more'; b.setAttribute('aria-expanded', String(opening)); }
				if (cut.has(c) && opening) ellOf(c).style.opacity = '0';
			});
			const my = gen;
			const finish = () => {
				if (my !== gen) return;
				row.forEach((c) => {
					const clip = clipOf(c);
					if (opening) { c.style.height = ''; clip.style.height = ''; clip.style.overflow = ''; }
					else { c.style.height = H0 + 'px'; if (cut.has(c)) { clip.style.height = cut.get(c)! + 'px'; clip.style.overflow = 'hidden'; placeEll(c, cut.get(c)!); } }
				});
			};
			if (fast) return finish();
			let done = 0;
			row.forEach((c, i) => {
				const clip = clipOf(c);
				c.style.height = start[i].h + 'px';
				clip.style.overflow = 'hidden';
				clip.style.height = start[i].clip + 'px';
				const dur = opening ? 450 : 350;
				const a1 = c.animate([{ height: start[i].h + 'px' }, { height: end[i].h + 'px' }], { duration: dur, easing: ease, fill: 'forwards' });
				const a2 = clip.animate([{ height: start[i].clip + 'px' }, { height: end[i].clip + 'px' }], { duration: dur, easing: ease, fill: 'forwards' });
				running.push(a1, a2);
				a1.onfinish = () => { a1.cancel(); if (++done === row.length * 2) finish(); };
				a2.onfinish = () => { a2.cancel(); if (++done === row.length * 2) finish(); };
			});
		}
		cards.forEach((c, i) => btnOf(c).addEventListener('click', () => toggle(rowOf(i))));
		let t: number | undefined;
		// V11: on a phone the window height changes each time the address bar shows or
		// hides; that alone (same width, same number per row) does not measure again.
		let lastW = window.innerWidth;
		const again = () => {
			window.clearTimeout(t);
			t = window.setTimeout(() => {
				if (window.innerWidth === lastW && colsNow() === COLS) return;
				lastW = window.innerWidth;
				layout();
			}, 120);
		};
		window.addEventListener('resize', again);
		document.fonts?.ready.then(layout);
		layout();
	}
</script>
