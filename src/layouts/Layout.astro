---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
	title?: string;
	description?: string;
	/** Absolute URL (starts with http) or root-relative path. Root-relative
	 * gets resolved against SITE_URL below so OG/Twitter get an absolute URL —
	 * some scrapers reject relative paths and drop the preview image. */
	ogImage?: string;
	/** Optional per-page JSON-LD payload (e.g. a CreativeWork for /work/[slug]).
	 * Rendered as a second <script type="application/ld+json"> after the global
	 * Person node. */
	structuredData?: unknown;
}

// Deployed URL. This has to match the domain the site is actually served from:
// it feeds rel=canonical, og:url and the absolute og:image. It used to read
// davidbitan.pages.dev, which no longer resolves at all (NXDOMAIN) — so every
// page declared a dead canonical, and link previews on LinkedIn / WhatsApp had
// no image to fetch. Update again when a custom domain lands.
const SITE_URL = 'https://david-bitan-portfolio.pages.dev';
const SITE_NAME = 'David Bitan · Portfolio';
const DEFAULT_TITLE = 'David Bitan · Senior AI Product Designer';
const DEFAULT_DESCRIPTION =
	'Senior AI Product Designer in Israel, available now. SaaS, fintech and gaming products, from user research to shipped design systems: case studies from Ryze Beyond, Sonary, Playright and more.';
const DEFAULT_OG = '/og-image.png';

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	ogImage = DEFAULT_OG,
	structuredData,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = ogImage.startsWith('http')
	? ogImage
	: new URL(ogImage, SITE_URL).toString();

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

// Global Person schema — surfaces name, role and location to search engines
// and to social previews that consume Schema.org. Rendered on every page so
// the identity signal is consistent across the site (not only /about).
const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'David Bitan',
	jobTitle: 'Senior AI Product Designer',
	url: SITE_URL,
	email: 'mailto:advance26@gmail.com',
	sameAs: ['https://www.linkedin.com/in/david-bitan'],
	address: {
		'@type': 'PostalAddress',
		addressCountry: 'IL',
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- initial-scale=1 is not optional: without it iOS Safari picks its own
		     scale and can render the page zoomed out, most visibly on rotation.
		     viewport-fit=cover lets the layout reach under the notch. -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{/* Étape 15, S59: favicon V6 (SVG as supplied; .ico 16/32/48 and the
		    180 px Apple icon made from it). */}
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph — Facebook / LinkedIn / iMessage previews. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter / X card. summary_large_image → full-width preview. -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Manrope, self-hosted (OFL): no request to Google Fonts (GDPR) -->
		<link rel="preload" href="/fonts/manrope/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link href="/fonts/manrope/fonts.css" rel="stylesheet" />
		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}

		{umamiId && (
			<script
				is:inline
				defer
				src="https://cloud.umami.is/script.js"
				data-website-id={umamiId}
			></script>
		)}

		<script is:inline>
			// Runs before body paint to avoid a light→dark flash. Light is the
			// default — only a saved "dark" preference switches it, never OS
			// detection.
			try {
				if (localStorage.getItem('theme') === 'dark') {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch {
				// localStorage unavailable (private mode, etc.) — default to light
			}
			// Étape 15, S64: no smooth scrolling while the browser puts the page
			// back where it was (back button, reload); smooth again once loaded.
			// Étape 16, S85: a menu link to a home section (/#work…, flag set by
			// Nav.astro) keeps the smooth scroll down to its section; any other
			// arrival stays instant, as before.
			try {
				var nv = performance.getEntriesByType('navigation')[0];
				var soft = !!nv && nv.type === 'navigate' && sessionStorage.getItem('cpSmooth') === '1';
				sessionStorage.removeItem('cpSmooth');
				if (!soft) document.documentElement.style.scrollBehavior = 'auto';
			} catch (e) {
				document.documentElement.style.scrollBehavior = 'auto';
			}
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<slot />
		<BackToTop />
		<script is:inline>
			// Étape 15, S64: on Back / reload, the saved position is put back as
			// soon as the page is parsed, before it is shown (see the script below).
			(function () {
				try {
					var n = performance.getEntriesByType('navigation')[0];
					var y = history.state && history.state.cpY;
					if (n && (n.type === 'back_forward' || n.type === 'reload') && typeof y === 'number') {
						history.scrollRestoration = 'manual';
						scrollTo(0, y);
					}
				} catch (e) {}
			})();
		</script>
			<script is:inline>
			// nowidow: glue the last two words of short text blocks with a
			// non-breaking space, unless the pair would be too long for a phone.
			(() => {
				const sel = 'h1,h2,h3,h4,p,li,figcaption,blockquote';
				document.querySelectorAll(sel).forEach((el) => {
					// étape 14, ajout 2 (C): a card caption holds its own <p>, which is
					// already glued; a second pass glued three words ("The / month’s
					// total, first.") and defeated text-wrap: balance.
					if (el.matches('.ptv-card figcaption')) return;
					const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
					let last = null;
					while (walker.nextNode()) if (walker.currentNode.textContent.trim()) last = walker.currentNode;
					if (!last) return;
					const t = last.textContent.replace(/\s+$/, '');
					const k = t.lastIndexOf(' ');
					if (k < 1 || t.length - k > 18) return;
					const prev = t.lastIndexOf(' ', k - 1);
					if (t.length - prev > 26) return;
					last.textContent = t.slice(0, k) + '\u00A0' + t.slice(k + 1) + last.textContent.slice(t.length);
				});
			})();
		</script>
</body>
</html>

<script>
	// Étape 15, S64: the « Back » links (top link and round chevron) go back
	// to exactly where the visitor was: if the previous page is on this site,
	// history.back() (the position comes back exactly, no smooth scroll);
	// otherwise the normal link.
	{
		const html = document.documentElement;
		const smoothAgain = () => requestAnimationFrame(() => requestAnimationFrame(() => { html.style.scrollBehavior = ''; }));
		// The browser's own restore landed 16 px off (it records the position
		// at another moment), so the site keeps the position itself: each
		// history entry stores its scroll position (history.state, written when
		// the scrolling stops and on leaving) and gets it back exactly, on Back,
		// Forward or reload, and for in-page steps (#work…) too.
		try { history.scrollRestoration = 'manual'; } catch {}
		const save = () => { try { history.replaceState({ ...(history.state || {}), cpY: Math.round(scrollY) }, ''); } catch {} };
		let st = 0;
		addEventListener('scroll', () => { clearTimeout(st); st = window.setTimeout(save, 200); }, { passive: true });
		addEventListener('pagehide', save);
		document.addEventListener('click', save, true); // before a link adds a history entry
		const savedY = () => { const y = history.state?.cpY; return typeof y === 'number' ? y : NaN; };
		const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
		const back = !!nav && (nav.type === 'back_forward' || nav.type === 'reload');
		const restore = () => { const y = savedY(); if (back && Number.isFinite(y)) scrollTo({ top: y, behavior: 'instant' as ScrollBehavior }); };
		restore();
		const onLoad = () => { restore(); smoothAgain(); };
		if (document.readyState === 'complete') onLoad();
		else addEventListener('load', onLoad, { once: true });
		// Étape 16, S85: a click on a link to a section of this same page
		// (/#work from the home menu) also fires popstate; that one is not a
		// Back, so it keeps the browser's smooth scroll.
		let hashClick = false;
		document.addEventListener('click', (e) => {
			const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
			if (!a || a.pathname !== location.pathname || !a.hash) return;
			hashClick = true;
			setTimeout(() => { hashClick = false; }, 100);
		}, true);
		addEventListener('popstate', () => {
			if (hashClick) { hashClick = false; return; }
			const y = savedY();
			if (Number.isFinite(y)) scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
			else if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ behavior: 'instant' as ScrollBehavior });
			else scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
		});
		addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) smoothAgain(); });
		let moved = false; // an in-page jump (#anchor) adds a history entry on this page
		addEventListener('hashchange', () => { moved = true; });
		const fromSite = () => {
			try { return !!document.referrer && new URL(document.referrer).origin === location.origin && new URL(document.referrer).pathname !== location.pathname; }
			catch { return false; }
		};
		document.addEventListener('click', (e) => {
			const a = (e.target as Element | null)?.closest?.('a[data-top-back], a.zf-back-link');
			if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			if (moved || history.length < 2 || !fromSite()) return;
			e.preventDefault();
			html.style.scrollBehavior = 'auto';
			history.back();
		});
	}

	const targets = document.querySelectorAll('[data-reveal]');
	// threshold: 0 + a bottom rootMargin (not a % threshold) so this triggers
	// consistently regardless of section height — a percentage threshold like
	// 0.15 can never be satisfied by a section taller than ~6x the viewport
	// (e.g. a 96-image case-study gallery), leaving it permanently invisible.
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0, rootMargin: '0px 0px -10% 0px' }
	);
	targets.forEach((target) => observer.observe(target));
</script>
