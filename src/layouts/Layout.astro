---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
	title?: string;
	description?: string;
	/** Absolute URL (starts with http) or root-relative path. Root-relative
	 * gets resolved against SITE_URL below so OG/Twitter get an absolute URL —
	 * some scrapers reject relative paths and drop the preview image. */
	ogImage?: string;
	/** Optional per-page JSON-LD payload (e.g. a CreativeWork for /work/[slug]).
	 * Rendered as a second <script type="application/ld+json"> after the global
	 * Person node. */
	structuredData?: unknown;
}

// Deployed URL. This has to match the domain the site is actually served from:
// it feeds rel=canonical, og:url and the absolute og:image. It used to read
// davidbitan.pages.dev, which no longer resolves at all (NXDOMAIN) — so every
// page declared a dead canonical, and link previews on LinkedIn / WhatsApp had
// no image to fetch. Update again when a custom domain lands.
const SITE_URL = 'https://david-bitan-portfolio.pages.dev';
const SITE_NAME = 'David Bitan · Portfolio';
const DEFAULT_TITLE = 'David Bitan · Senior AI Product Designer';
const DEFAULT_DESCRIPTION =
	'Senior AI Product Designer in Israel, available now. SaaS, fintech and gaming products, from user research to shipped design systems: case studies from Ryze Beyond, Sonary, Playright and more.';
const DEFAULT_OG = '/og-image.png';

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	ogImage = DEFAULT_OG,
	structuredData,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = ogImage.startsWith('http')
	? ogImage
	: new URL(ogImage, SITE_URL).toString();

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

// Global Person schema — surfaces name, role and location to search engines
// and to social previews that consume Schema.org. Rendered on every page so
// the identity signal is consistent across the site (not only /about).
const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'David Bitan',
	jobTitle: 'Senior AI Product Designer',
	url: SITE_URL,
	email: 'mailto:advance26@gmail.com',
	sameAs: ['https://www.linkedin.com/in/david-bitan'],
	address: {
		'@type': 'PostalAddress',
		addressCountry: 'IL',
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- initial-scale=1 is not optional: without it iOS Safari picks its own
		     scale and can render the page zoomed out, most visibly on rotation.
		     viewport-fit=cover lets the layout reach under the notch. -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph — Facebook / LinkedIn / iMessage previews. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter / X card. summary_large_image → full-width preview. -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Manrope, self-hosted (OFL): no request to Google Fonts (GDPR) -->
		<link rel="preload" href="/fonts/manrope/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link href="/fonts/manrope/fonts.css" rel="stylesheet" />
		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}

		{umamiId && (
			<script
				is:inline
				defer
				src="https://cloud.umami.is/script.js"
				data-website-id={umamiId}
			></script>
		)}

		<script is:inline>
			// Runs before body paint to avoid a light→dark flash. Light is the
			// default — only a saved "dark" preference switches it, never OS
			// detection.
			try {
				if (localStorage.getItem('theme') === 'dark') {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch {
				// localStorage unavailable (private mode, etc.) — default to light
			}
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<slot />
		<BackToTop />
			<script is:inline>
			// nowidow: glue the last two words of short text blocks with a
			// non-breaking space, unless the pair would be too long for a phone.
			(() => {
				const sel = 'h1,h2,h3,h4,p,li,figcaption,blockquote';
				document.querySelectorAll(sel).forEach((el) => {
					const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
					let last = null;
					while (walker.nextNode()) if (walker.currentNode.textContent.trim()) last = walker.currentNode;
					if (!last) return;
					const t = last.textContent.replace(/\s+$/, '');
					const k = t.lastIndexOf(' ');
					if (k < 1 || t.length - k > 18) return;
					const prev = t.lastIndexOf(' ', k - 1);
					if (t.length - prev > 26) return;
					last.textContent = t.slice(0, k) + '\u00A0' + t.slice(k + 1) + last.textContent.slice(t.length);
				});
			})();
		</script>
</body>
</html>

<script>
	const targets = document.querySelectorAll('[data-reveal]');
	// threshold: 0 + a bottom rootMargin (not a % threshold) so this triggers
	// consistently regardless of section height — a percentage threshold like
	// 0.15 can never be satisfied by a section taller than ~6x the viewport
	// (e.g. a 96-image case-study gallery), leaving it permanently invisible.
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0, rootMargin: '0px 0px -10% 0px' }
	);
	targets.forEach((target) => observer.observe(target));
</script>
