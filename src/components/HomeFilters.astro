---
// Inline pill filter bar for home sections (Selected Work, Craft).
// Same visual language as CraftFilters.astro (sticky /craft page), but
// rendered INLINE inside the section — not sticky.
//
// Params:
//  - id: unique DOM id (also used as script scope)
//  - categories: pills to render, in order (built by caller from data source)
//  - target: CSS selector of items to filter. Items must have [data-category].
//
// Emits a CustomEvent 'home-filter:change' on the container with
// detail `{ filter }` so callers (CraftSection) can react — used to
// coordinate with Load More visibility.

interface Props {
	id: string;
	categories: string[];
	target: string;
}
const { id, categories, target } = Astro.props;
---

<div
	id={id}
	class="home-filters mb-5"
	data-target={target}
>
	{/* Étape 13, 2: ONE line on every screen, swipe or drag it sideways
	    (finger and mouse) like the filters of the inner pages; 36 px tall
	    (44 px tap area from global.css); each pill = text + the same
	    padding on both sides. */}
	<div class="home-filters-scroll -mx-6 flex flex-nowrap items-center gap-2 overflow-x-auto px-6 py-1 min-[1248px]:mx-0 min-[1248px]:px-0">
		<button
			type="button"
			data-home-filter="__all__"
			class="home-filter-btn inline-flex h-9 shrink-0 cursor-pointer items-center whitespace-nowrap rounded-pill border border-ink/15 bg-ink px-4 text-sm font-semibold text-bg transition-colors"
			aria-pressed="true"
		>
			All
		</button>
		{
			categories.map((cat) => (
				<button
					type="button"
					data-home-filter={cat}
					class="home-filter-btn inline-flex h-9 shrink-0 cursor-pointer items-center whitespace-nowrap rounded-pill border border-ink/15 bg-transparent px-4 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent-text"
					aria-pressed="false"
				>
					{cat}
				</button>
			))
		}
	</div>
</div>

<script>
	// Wire ALL .home-filters bars found on the page. Each bar owns its own
	// button set + a `data-target` selector pointing at the items to filter.
	// Script is a module (auto-deferred) — runs after full DOM parse, so
	// items further down in the source are already reachable.
	const bars = document.querySelectorAll<HTMLElement>('.home-filters');

	const ACTIVE_ADD = ['bg-ink', 'text-bg'];
	const ACTIVE_REMOVE = [
		'bg-transparent',
		'text-ink',
		'hover:border-accent',
		'hover:text-accent-text',
	];

	bars.forEach((bar) => {
		const selector = bar.dataset.target;
		if (!selector) return;

		const buttons = bar.querySelectorAll<HTMLButtonElement>('.home-filter-btn');
		const items = document.querySelectorAll<HTMLElement>(selector);
		if (!buttons.length || !items.length) return;

		function apply(filter: string) {
			items.forEach((el) => {
				// Multi-tag support: `data-categories="SaaS|UI/UX"` — split on
				// pipe (chosen over whitespace to survive multi-word category
				// names like "Digital Painting"). A project can belong to
				// several pill filters (e.g. SaaS projects are also UI/UX).
				const raw = el.dataset.categories || '';
				const cats = raw.split('|').map((s) => s.trim()).filter(Boolean);
				const show = filter === '__all__' || cats.includes(filter);
				el.classList.toggle('home-filter-hidden', !show);
			});
			buttons.forEach((b) => {
				const active = b.dataset.homeFilter === filter;
				b.setAttribute('aria-pressed', String(active));
				if (active) {
					b.classList.add(...ACTIVE_ADD);
					b.classList.remove(...ACTIVE_REMOVE);
				} else {
					b.classList.remove(...ACTIVE_ADD);
					b.classList.add(...ACTIVE_REMOVE);
				}
			});
			// Notify listeners (e.g. CraftSection Load More logic).
			bar.dispatchEvent(
				new CustomEvent('home-filter:change', {
					detail: { filter },
					bubbles: true,
				}),
			);
		}

		// Étape 13, 2: the row can also be dragged with the mouse; a drag
		// does not press the pill it ends on.
		const row = bar.querySelector<HTMLElement>('.home-filters-scroll');
		let drag: { x: number; left: number } | null = null;
		let dragged = false;
		row?.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0) return;
			drag = { x: e.clientX, left: row.scrollLeft };
			dragged = false;
		});
		row?.addEventListener('pointermove', (e) => {
			if (!drag) return;
			const dx = e.clientX - drag.x;
			if (!dragged && Math.abs(dx) > 5) {
				dragged = true;
				row.setPointerCapture(e.pointerId);
				row.classList.add('is-dragging');
			}
			if (dragged) row.scrollLeft = drag.left - dx;
		});
		const end = () => {
			drag = null;
			row?.classList.remove('is-dragging');
			setTimeout(() => (dragged = false), 0);
		};
		row?.addEventListener('pointerup', end);
		row?.addEventListener('pointercancel', end);

		buttons.forEach((b) => {
			b.addEventListener('click', (e) => {
				if (dragged) { e.preventDefault(); return; }
				const key = b.dataset.homeFilter;
				if (key) apply(key);
			});
		});
	});
</script>

<style is:global>
	/* Own hide class (not Tailwind `.hidden`) so that filter state doesn't
	   collide with Craft Load More logic — CraftSection uses `.hidden` for
	   its "past initial cap" items, and both systems need to coexist. */
	.home-filter-hidden {
		display: none !important;
	}
	/* Swipe sideways, no visible scrollbar (like the inner pages). */
	.home-filters-scroll {
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.home-filters-scroll::-webkit-scrollbar {
		display: none;
	}
	.home-filters-scroll.is-dragging,
	.home-filters-scroll.is-dragging .home-filter-btn {
		cursor: grabbing;
		user-select: none;
	}
</style>
