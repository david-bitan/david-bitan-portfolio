---
import { cld, PORTRAIT, LANDSCAPE } from '../lib/cloudinary';
import type { FullProject } from '../data/allProjects';

interface Props {
	project: FullProject;
}

const { project } = Astro.props;
---

<a
	href={`/work/${project.slug}`}
	data-category={project.category}
	class="group block overflow-hidden rounded-md border border-transparent bg-card transition-all hover:-translate-y-1 hover:border-accent"
>
	<div class={project.orientation === 'portrait' ? 'aspect-[3/4]' : 'aspect-[4/3]'}>
		<img
			src={cld(project.thumbnail, project.orientation === 'portrait' ? PORTRAIT : LANDSCAPE)}
			alt={project.title}
			loading="lazy"
			class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
		/>
	</div>
	<div class="p-5">
		<p class="font-semibold">{project.title}</p>
		<p class="mt-1 text-sm text-muted">
			{project.client} · {project.year}
		</p>
	</div>
</a>
