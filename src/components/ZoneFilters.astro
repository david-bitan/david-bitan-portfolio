---
import type { Zone } from '../lib/zones';

interface Props {
	zones?: Zone[];
	/** Where the sticky back link goes, and its label in the bare bar. */
	backHref?: string;
	backLabel?: string;
}

const { zones = [], backHref = '/#work', backLabel = 'Back to work' } = Astro.props;

// Two independent filter groups: a Device choice AND a Theme choice can be
// combined (e.g. Desktop + Dark shows only the "Desktop · Dark" zone).
// One single row since 15/11 (David): no "DEVICE" / "THEME" captions, a thin
// grey divider between the groups, swipe sideways when it does not fit.
const labels = zones.map((z) => z.label);
const hasDesktop = labels.some((l) => /desktop/i.test(l));
const hasMobile = labels.some((l) => /mobile/i.test(l));
const hasLight = labels.some((l) => /light/i.test(l));
const hasDark = labels.some((l) => /dark/i.test(l));

type Filter = { key: string; label: string };

const deviceOptions: Filter[] = [];
if (hasDesktop || hasMobile) {
	deviceOptions.push({ key: 'all', label: 'All' });
	if (hasDesktop) deviceOptions.push({ key: 'desktop', label: 'Desktop' });
	if (hasMobile) deviceOptions.push({ key: 'mobile', label: 'Mobile' });
}

const themeOptions: Filter[] = [];
if (hasLight || hasDark) {
	themeOptions.push({ key: 'all', label: 'All' });
	if (hasLight) themeOptions.push({ key: 'light', label: 'Light' });
	if (hasDark) themeOptions.push({ key: 'dark', label: 'Dark' });
}

const showBar = deviceOptions.length > 1 || themeOptions.length > 1;
---

{/* Always rendered, so every project page keeps a sticky way back.
    With filters: the bar sticks under the header and "← Back" appears pinned
    on its left; only the filters scroll behind it (David, 15/11).
    Without filters ("bare"): a thin bar with "← Back to …" fades in, pinned
    under the header, once the page's own top back link has scrolled away. */}
<div
	id="zone-filters-bar"
	data-zf
	class:list={['z-30 w-full border-y border-ink/10 bg-bg', showBar ? 'sticky zf-sticky' : 'zf-bare']}
>
	<div class="relative mx-auto max-w-[1200px]">
		{/* Étape 9, I1: back to the round pill with a small chevron (no word, it
		    took too much room); its name stays for screen readers; 44px tap area. */}
		<div class="zone-filters-back absolute inset-y-0 left-0 z-20 flex items-center pl-6 min-[1248px]:pl-0">
			<a
				href={backHref}
				aria-label={showBar ? 'Back' : backLabel}
				class="zf-back-link flex h-8 w-8 items-center justify-center rounded-full border border-ink/15 text-muted transition-colors hover:border-accent hover:text-accent-text"
			>
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M15 18l-6-6 6-6" /></svg>
			</a>
			{showBar && <span class="zf-divider ml-3 h-5 w-px bg-ink/15" aria-hidden="true" />}
		</div>

		{showBar && (
			<div class="zone-filters-scroll flex flex-nowrap items-center gap-3 overflow-x-auto py-3 pl-6 min-[1248px]:pl-0">
					{deviceOptions.length > 1 && (
						<div role="group" aria-labelledby="zf-device" class="flex shrink-0 items-center gap-2">
							<span id="zf-device" class="sr-only">Device</span>
							{deviceOptions.map((f, i) => (
								<button
									type="button"
									data-filter-group="device"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									aria-pressed={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn inline-flex h-9 shrink-0 items-center rounded-pill border border-ink/15 px-4 text-sm font-medium leading-none text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-bg"
								>
									{f.label}
								</button>
							))}
						</div>
					)}

					{deviceOptions.length > 1 && themeOptions.length > 1 && (
						<span class="h-5 w-px shrink-0 bg-ink/15" aria-hidden="true" />
					)}
					{themeOptions.length > 1 && (
						<div role="group" aria-labelledby="zf-theme" class="flex shrink-0 items-center gap-2">
							<span id="zf-theme" class="sr-only">Theme</span>
							{themeOptions.map((f, i) => (
								<button
									type="button"
									data-filter-group="theme"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									aria-pressed={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn inline-flex h-9 shrink-0 items-center rounded-pill border border-ink/15 px-4 text-sm font-medium leading-none text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-bg"
								>
									{f.label}
								</button>
							))}
						</div>
					)}

				{/* End margin: the last pill never sits flush on the edge, so a
				    cut pill reads as "there is more". */}
				<span class="block w-3 shrink-0 min-[1248px]:w-0" aria-hidden="true" />
			</div>
		)}
		{!showBar && <div class="h-[60px]" aria-hidden="true" />}
	</div>
</div>

<script>
	const deviceBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="device"]'),
	);
	const themeBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="theme"]'),
	);
	const sections = Array.from(
		document.querySelectorAll<HTMLElement>('section[data-zone-label]'),
	);

	let selectedDevice = 'all';
	let selectedTheme = 'all';

	function apply() {
		deviceBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedDevice ? 'true' : 'false';
			b.setAttribute('aria-pressed', b.dataset.active);
		});
		themeBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedTheme ? 'true' : 'false';
			b.setAttribute('aria-pressed', b.dataset.active);
		});
		sections.forEach((sec) => {
			const label = (sec.dataset.zoneLabel || '').toLowerCase();
			const matchDevice = selectedDevice === 'all' || label.includes(selectedDevice);
			const matchTheme = selectedTheme === 'all' || label.includes(selectedTheme);
			sec.classList.toggle('hidden', !(matchDevice && matchTheme));
		});
	}

	deviceBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedDevice = b.dataset.filterKey || 'all';
			apply();
		}),
	);
	themeBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedTheme = b.dataset.filterKey || 'all';
			apply();
		}),
	);

	// Sticky state. The header height changes with the breakpoint (85px on
	// phones, 77px on desktop): it is read from --header-h (set by Nav) so the
	// bar never slides under the header hairline (P5, 15/11).
	const bar = document.getElementById('zone-filters-bar');
	const back = bar?.querySelector<HTMLElement>('.zone-filters-back');
	const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 77;
	// The top-of-page back link (first one in <main>): once it is under the
	// header, the bare bar shows up.
	const topLink = document.querySelector<HTMLElement>('main [data-top-back]');
	function measure() {
		if (back && bar) bar.style.setProperty('--zf-back-w', back.offsetWidth + 'px');
	}
	function update() {
		if (!bar) return;
		let stuck: boolean;
		if (bar.classList.contains('zf-bare')) {
			const anchor = topLink || document.querySelector<HTMLElement>('main h1');
			stuck = anchor ? anchor.getBoundingClientRect().bottom <= headerH() : window.scrollY > 200;
		} else {
			stuck = bar.getBoundingClientRect().top <= headerH() + 0.5;
		}
		bar.classList.toggle('is-stuck', stuck);
	}
	let ticking = false;
	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => { update(); ticking = false; });
	};
	if (bar) {
		// keyboard focus never lands hidden under the header + this bar (WCAG 2.4.11)
		document.documentElement.classList.add('has-zf');
		measure();
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => { measure(); onScroll(); });
		document.fonts?.ready.then(measure);
	}
</script>

<style is:global>
	html.has-zf { scroll-padding-top: calc(var(--header-h, 77px) + 72px); }
	/* Étape 9, I3: 1 px under the header (the header is drawn above it), so no
	   gap ever shows between the two, at any width or zoom level. */
	.zf-sticky,
	.zf-bare { top: calc(var(--header-h, 77px) - 1px); }
	/* Bare bar: out of the flow, pinned, hidden until the top link is gone. */
	.zf-bare {
		position: fixed;
		left: 0;
		right: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 160ms ease-out, visibility 0s linear 160ms;
	}
	.zf-bare.is-stuck {
		opacity: 1;
		visibility: visible;
		transition: opacity 160ms ease-out, visibility 0s;
	}

	/* Swipe sideways, no visible scrollbar. */
	.zone-filters-scroll {
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		transition: padding-left 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.zone-filters-scroll::-webkit-scrollbar { display: none; }

	/* Étape 9, I2: when the bar sticks, the filters slide right to make room
	   while the round pill grows from tiny and clear (scale 0.2, opacity 0) to
	   its size, 280 ms on a soft ease-out; unsticking plays it backwards. The
	   pill starts 80 ms after the filters (and leaves 80 ms before them), so
	   the two never overlap. */
	.zone-filters-back { visibility: hidden; transition: visibility 0s linear 360ms; }
	.zone-filters-back .zf-back-link,
	.zone-filters-back .zf-divider {
		opacity: 0;
		transform: scale(0.2);
		transition:
			opacity 240ms cubic-bezier(0.4, 0, 1, 1),
			transform 240ms cubic-bezier(0.4, 0, 1, 1),
			border-color 200ms ease,
			color 200ms ease;
	}
	.zone-filters-back .zf-divider { transform: none; }
	/* its ground (which hides the filters scrolled under it) fades with the
	   pill, so it never cuts a filter while they move */
	.zone-filters-back::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-bg);
		opacity: 0;
		transition: opacity 200ms ease;
	}
	.is-stuck .zone-filters-back::before {
		opacity: 1;
		transition: opacity 200ms ease 200ms;
	}
	.is-stuck .zone-filters-back { visibility: visible; transition: visibility 0s; }
	.is-stuck .zone-filters-back .zf-back-link,
	.is-stuck .zone-filters-back .zf-divider {
		opacity: 1;
		transform: none;
		transition:
			opacity 280ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
			border-color 200ms ease,
			color 200ms ease;
	}
	.zone-filters-scroll {
		transition: padding-left 280ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
	}
	.zf-sticky.is-stuck .zone-filters-scroll {
		padding-left: calc(var(--zf-back-w, 72px) + 12px);
		transition: padding-left 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.zone-filters-back,
		.zone-filters-back .zf-back-link,
		.zone-filters-back .zf-divider,
		.zone-filters-back::before,
		.zone-filters-scroll,
		.zf-bare {
			transition: none !important;
		}
	}
</style>
