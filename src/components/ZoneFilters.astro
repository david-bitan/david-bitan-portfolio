---
import type { Zone } from '../lib/zones';

interface Props {
	zones: Zone[];
}

const { zones } = Astro.props;

// Two independent filter groups — a Device choice AND a Theme choice can be
// combined (e.g. Desktop + Dark → shows only the "Desktop · Dark" zone).
// Sonary Dashboard shows both groups. A 2-zone project without theme split
// shows only the Device group. A Gallery-only project shows nothing.
const labels = zones.map((z) => z.label);
const hasDesktop = labels.some((l) => /desktop/i.test(l));
const hasMobile = labels.some((l) => /mobile/i.test(l));
const hasLight = labels.some((l) => /light/i.test(l));
const hasDark = labels.some((l) => /dark/i.test(l));

type Filter = { key: string; label: string };

const deviceOptions: Filter[] = [];
if (hasDesktop || hasMobile) {
	deviceOptions.push({ key: 'all', label: 'All' });
	if (hasDesktop) deviceOptions.push({ key: 'desktop', label: 'Desktop' });
	if (hasMobile) deviceOptions.push({ key: 'mobile', label: 'Mobile' });
}

const themeOptions: Filter[] = [];
if (hasLight || hasDark) {
	themeOptions.push({ key: 'all', label: 'All' });
	if (hasLight) themeOptions.push({ key: 'light', label: 'Light' });
	if (hasDark) themeOptions.push({ key: 'dark', label: 'Dark' });
}

const showBar = deviceOptions.length > 1 || themeOptions.length > 1;
---

{
	showBar && (
		<div
			id="zone-filters-bar"
			class="sticky top-[76px] z-30 w-full border-y border-ink/10 bg-bg"
		>
			{/* Bar bg spans FULL viewport (w-full outer). Inner container
				max-w-[1200px] mx-auto centres the content (pills + arrows)
				and matches the site-wide 1200 alignment.
				This ensures the bar bg opacity cover ANY content that scrolls
				underneath on wide viewports (>1200 CSS), preventing image
				bleed / shadow visible on the sides. */}
			<div class="relative mx-auto h-14 max-w-[1200px]">
				{/* Back arrow — ABSOLUTE positioned (not a flex item), so it
					takes no space in the scroll flow. Invisible by default via
					opacity, revealed with fade + slide animation when the bar
					becomes sticky. bg-bg opaque + z-20 so pills passing behind
					during horizontal scroll are visually hidden.
					Mobile : left-6 (24 from viewport edge).
					Desktop lg+ : left-0 (pile 1200 edge). */}
				<a
					href="/#work"
					aria-label="Back to projects"
					class="zone-filters-back absolute inset-y-0 left-0 z-20 flex items-center bg-bg pl-6 pr-3 lg:pl-0"
				>
					<span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/15 text-muted transition-colors hover:border-accent hover:text-accent">
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4"
						>
							<path d="M15 18l-6-6 6-6" />
						</svg>
					</span>
				</a>

				{/* Right shield miroir — masks pills scrolling behind the
					right edge of the 1200 container. Same z-20 + bg-bg opaque
					pattern as the left back-arrow shield. No content (purely
					visual mask). pointer-events-none so it never intercepts
					clicks on real elements underneath.
					Mobile : w-6 (24 wide, matches left pl-6).
					Desktop lg+ : w-3 (12 wide, subtle mask at edge). */}
				<div
					aria-hidden="true"
					class="zone-filters-shield-right pointer-events-none absolute inset-y-0 right-0 z-20 w-6 bg-bg lg:w-3"
				/>

				{/* Scroll container — full-width single row. Padding-left
					animates from small (non-sticky : content flush left) to
					larger (sticky : content shifted right to make room for
					back arrow). Padding-right for tail spacing. */}
				<div class="zone-filters-scroll flex h-full items-center gap-2 overflow-x-auto pl-6 pr-6 sm:gap-3 lg:pl-0 lg:pr-0">
					{deviceOptions.length > 1 && (
						<>
							{/* The "Device" / "Theme" captions were dropped: on a phone they ate a
								third of the single scrolling row, and the pills say what they filter
								("Desktop", "Mobile", "Light", "Dark") well enough on their own. The
								label survives for screen readers on each button's aria-label, since
								without it "Dark" alone is ambiguous out of context. */}
							{deviceOptions.map((f, i) => (
								<button
									type="button"
									aria-label={`Filter by device: ${f.label}`}
									data-filter-group="device"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn inline-flex h-9 shrink-0 items-center rounded-pill border border-ink/15 px-4 text-sm font-medium leading-none text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink"
								>
									{f.label}
								</button>
							))}
						</>
					)}

					{deviceOptions.length > 1 && themeOptions.length > 1 && (
						<div class="h-6 w-px shrink-0 bg-ink/15" aria-hidden="true" />
					)}

					{themeOptions.length > 1 && (
						<>
							{themeOptions.map((f, i) => (
								<button
									type="button"
									aria-label={`Filter by theme: ${f.label}`}
									data-filter-group="theme"
									data-filter-key={f.key}
									data-active={i === 0 ? 'true' : 'false'}
									class="zone-filter-btn inline-flex h-9 shrink-0 items-center rounded-pill border border-ink/15 px-4 text-sm font-medium leading-none text-muted transition-colors hover:border-ink/40 hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-accent-ink"
								>
									{f.label}
								</button>
							))}
						</>
					)}
				</div>
			</div>
		</div>
	)
}

<script>
	const deviceBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="device"]'),
	);
	const themeBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-filter-group="theme"]'),
	);
	const sections = Array.from(
		document.querySelectorAll<HTMLElement>('section[data-zone-label]'),
	);

	let selectedDevice = 'all';
	let selectedTheme = 'all';

	function apply() {
		deviceBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedDevice ? 'true' : 'false';
		});
		themeBtns.forEach((b) => {
			b.dataset.active = b.dataset.filterKey === selectedTheme ? 'true' : 'false';
		});
		sections.forEach((sec) => {
			const label = (sec.dataset.zoneLabel || '').toLowerCase();
			const matchDevice = selectedDevice === 'all' || label.includes(selectedDevice);
			const matchTheme = selectedTheme === 'all' || label.includes(selectedTheme);
			sec.classList.toggle('hidden', !(matchDevice && matchTheme));
		});
	}

	deviceBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedDevice = b.dataset.filterKey || 'all';
			apply();
		}),
	);
	themeBtns.forEach((b) =>
		b.addEventListener('click', () => {
			selectedTheme = b.dataset.filterKey || 'all';
			apply();
		}),
	);

	// Sticky detection — toggle `.is-stuck` on the bar when it pins to
	// top-[68px]. IntersectionObserver rootMargin -69px fires when bar top
	// edge crosses the 68px line under the nav.
	const bar = document.getElementById('zone-filters-bar');
	if (bar && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			([entry]) => {
				bar.classList.toggle('is-stuck', entry.intersectionRatio < 1);
			},
			{ rootMargin: '-77px 0px 0px 0px', threshold: [1] },
		);
		io.observe(bar);
	}
</script>

<style is:global>
	/* Hide horizontal scrollbar (touch/trackpad/wheel scroll still works). */
	.zone-filters-scroll {
		scrollbar-width: none;
	}
	.zone-filters-scroll::-webkit-scrollbar {
		display: none;
	}

	/* Back arrow reveal animation.
	   Non-sticky : opacity 0 + slight translateX(-6px) + translateY(-50%) to
	     keep vertical centering (absolute + top-1/2 needs Y translate).
	     pointer-events none so clicks pass through (no interaction area).
	   Sticky : opacity 1 + translateX(0). */
	.zone-filters-back {
		opacity: 0;
		transform: translateX(-6px);
		pointer-events: none;
		transition:
			opacity 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
			border-color 200ms ease,
			color 200ms ease;
		will-change: opacity, transform;
	}
	#zone-filters-bar.is-stuck .zone-filters-back {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
	}

	/* Content shift : padding-left animates to make room for back arrow when
	   sticky. Small enough shift (mobile : 24 → 64, lg : 0 → 40) so most of
	   the row content stays visible after the shift, minimising the amount of
	   pills that get pushed off-screen to the right. */
	.zone-filters-scroll {
		transition: padding-left 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: padding-left;
	}
	#zone-filters-bar.is-stuck .zone-filters-scroll {
		padding-left: 76px;
	}
	@media (min-width: 1024px) {
		#zone-filters-bar.is-stuck .zone-filters-scroll {
			padding-left: 52px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.zone-filters-back,
		.zone-filters-scroll {
			transition: none !important;
		}
	}
</style>
