---
const skills = [
	'User Research & Usability Testing',
	'A/B Testing, Personas, Journey Mapping',
	'Design systems (variants, auto layout, nested components)',
	'WCAG accessibility',
	'AI-augmented workflow (Claude, ChatGPT, Midjourney, Figma AI, Adobe AI, Firefly)',
	'HTML5 / CSS3 (Flexbox & Grid)',
	'3D & motion (Cinema 4D, ZBrush, After Effects, SVGator)',
];
---

<section id="about" class="mx-auto max-w-[1200px] px-6 py-20 sm:py-28 lg:px-0" data-reveal>
	<div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-16">
		<div>
		<p class="text-2xl font-medium leading-relaxed tracking-tight sm:text-3xl">
			Product design across SaaS, fintech, iGaming and digital advertising. At Ryze Beyond, often the only
			product designer on my projects, within a design team of 1 to 4, while the company grew from 32 to 110+
			people, held together by an AI-augmented workflow.
		</p>
		<div class="mt-8 border-l-2 border-accent pl-5">
			<p class="font-semibold">Mentor at heart.</p>
			<p class="mt-1.5 text-muted">
				At every company I've worked for, I helped onboard the designers who joined the team,
				with honest, encouraging design reviews, and shared tips and design-system practices
				with them.
			</p>
		</div>
		</div>

		<div>
			<ul class="flex flex-col gap-4">
				{
					skills.map((skill) => (
						<li class="flex items-start gap-3 text-muted">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
							<span>{skill}</span>
						</li>
					))
				}
			</ul>
			<a href="/about" class="mt-6 inline-block text-sm font-semibold text-accent-text hover:underline">
				More about me →
			</a>
		</div>
	</div>
</section>
