---
// Home About block (CL2 étape 6, lot 1; layout étape 8, N): David’s validated
// paragraph, the mentor note, then the skills already shown here, sorted into
// three titled groups (none added, none removed). One skill fits none of the
// three groups; it closes the skills block on its own line.
const groups = [
	{
		title: 'Product & UX',
		skills: ['User Research & Usability Testing', 'A/B Testing, Personas, Journey Mapping'],
	},
	{
		title: 'Design systems & build',
		skills: ['Design systems (variants, auto layout, nested components)', 'HTML5 / CSS3 (Flexbox & Grid)'],
	},
	{
		title: 'AI',
		skills: ['AI-augmented workflow (Claude, ChatGPT, Midjourney, Figma AI, Adobe AI, Firefly, Gamma)'],
	},
];
const ungrouped = ['3D & motion (Cinema 4D, ZBrush, After Effects, SVGator)'];
---

<section id="about" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 sm:scroll-mt-0 min-[1248px]:px-0" data-reveal>
	{/* Étape 8, N (David 15/11): a real title like the other sections; on desktop two balanced
	    columns, the text on the left, every skill in one clean block on the right (three groups of
	    the same height, "3D & motion" filed inside); "More about me →" as an orange-outline button.
	    Texts unchanged. */}
	<h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">About me</h2>

	<div class="mt-title grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-12">
		<div class="flex flex-col">
			{/* Étape 13, 3: on phones the paragraph stops halfway with "… Read more";
			    a tap opens the rest smoothly (height + fade). sm+: the whole text. */}
			<p id="about-intro" class="text-base leading-relaxed sm:text-lg">
				I design products end to end, from research to shipped product, with a focus on AI products. My
				experience spans SaaS, fintech and iGaming products, game interfaces, and complex systems that stay simple to use, like a multi-brand design system<span class="about-rest"> for 40+ verticals. At Ryze Beyond, I owned my projects from start to finish. The design team ranged from 1 to 4 people: when designers joined, we split the projects, each very different from the others, to share the workload; when they moved on, I took them all back.</span><button type="button" class="about-more font-semibold text-accent-text sm:hidden" aria-expanded="false" aria-controls="about-intro">… Read more</button>
			</p>
			<div class="mt-8 border-l-2 border-accent pl-5">
				<p class="font-semibold">Mentor at heart.</p>
				<p class="mt-1.5 text-muted">
					At every company I’ve worked for, I helped onboard the designers who joined the team,
					with honest, encouraging design reviews, and shared tips and design-system practices
					with them.
				</p>
			</div>
			<a href="/about" class="btn-secondary mt-btn hidden min-h-11 items-center justify-center self-start whitespace-nowrap rounded-pill px-6 text-sm font-semibold lg:inline-flex">
				More about me&nbsp;<span class="arr" aria-hidden="true">→</span>
			</a>
		</div>

		<div class="box-line rounded-lg border border-ink/10 bg-card p-card">
			<div class="grid divide-y divide-ink/10 lg:auto-rows-fr">
				{
					groups.map((g) => (
						<div class="py-5 first:pt-0">
							<h3 class="text-sm font-semibold uppercase tracking-widest text-muted">{g.title}</h3>
							<ul class="mt-3 flex flex-col gap-2.5">
								{g.skills.map((skill) => (
									<li class="flex items-start gap-3">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
										<span>{skill}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
			<ul class="flex flex-col gap-2.5 border-t border-ink/10 pt-5">
				{
					ungrouped.map((skill) => (
						<li class="flex items-start gap-3 text-muted">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
							<span>{skill}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	{/* Phones: centred in the page (étape 9, B4). */}
	<div class="mt-btn flex justify-center lg:hidden">
	<a href="/about" class="btn-secondary inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-pill px-6 text-sm font-semibold">
		More about me&nbsp;<span class="arr" aria-hidden="true">→</span>
	</a>
	</div>
</section>

<style>
	/* Étape 13, 3: phones only. */
	@media (max-width: 639px) {
		#about-intro:not(.is-open) .about-rest {
			display: none;
		}
		.about-more {
			position: relative;
			margin-left: 0.25em;
		}
		/* 44 px tap area without moving the text */
		.about-more::after {
			content: '';
			position: absolute;
			inset: 50% auto auto 50%;
			width: max(100%, 44px);
			height: 44px;
			transform: translate(-50%, -50%);
		}
	}
</style>

<script>
	// Étape 13, 3: "… Read more" opens the rest of the paragraph smoothly.
	const intro = document.getElementById('about-intro');
	const more = intro?.querySelector<HTMLButtonElement>('.about-more');
	const rest = intro?.querySelector<HTMLElement>('.about-rest');
	more?.addEventListener('click', () => {
		if (!intro || !rest) return;
		const h0 = intro.offsetHeight;
		intro.classList.add('is-open');
		more.setAttribute('aria-expanded', 'true');
		more.hidden = true;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const h1 = intro.offsetHeight;
		const ease = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
		intro.animate([{ height: h0 + 'px', overflow: 'hidden' }, { height: h1 + 'px', overflow: 'hidden' }], { duration: 450, easing: ease });
		rest.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, delay: 80, easing: 'ease-out', fill: 'backwards' });
	});
	// the focus moves to the text that just opened (the button is gone)
	more?.addEventListener('click', () => { if (rest) { rest.tabIndex = -1; rest.focus({ preventScroll: true }); } });
</script>
