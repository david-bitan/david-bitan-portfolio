---
const employers = [
	'Ryze Beyond',
	'Smart.bid',
	'Wochat (now Slatch)',
	'GamingTech (SBTech Group)',
	'Tradologic',
	'Arc Interactive (Publicis)',
	'Mench',
];
// Tripled (not doubled) so the strip never runs out of content mid-loop on
// wide screens — two copies can be narrower than the viewport, leaving a
// visible gap right before the seamless wrap.
const track = [...employers, ...employers, ...employers];
---

<section class="overflow-hidden py-8 sm:py-10" data-reveal>
	<p class="mb-5 text-center text-xs font-semibold uppercase tracking-widest text-muted">
		Companies I have designed for
	</p>
	{/* Focusable region so keyboard users can pause the strip too. Only the
	    first copy is read out; the two loop copies are aria-hidden. */}
	<div class="marquee-mask" tabindex="0" role="region" aria-label="Companies I have designed for">
		<div class="marquee-track">
			{
				track.map((name, i) => (
					<span class="marquee-name shrink-0 px-8 text-xl font-bold whitespace-nowrap" aria-hidden={i >= employers.length ? 'true' : undefined}>{name}</span>
				))
			}
		</div>
	</div>
</section>
