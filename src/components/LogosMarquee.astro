---
const employers = [
	'Ryze Beyond',
	'Smart.bid',
	'Wochat (now Slatch)',
	'GamingTech (SBTech Group)',
	'Tradologic',
	'Arc Interactive (Publicis)',
	'Mench',
];
// Tripled (not doubled) so the strip never runs out of content mid-loop on
// wide screens — two copies can be narrower than the viewport, leaving a
// visible gap right before the seamless wrap.
const track = [...employers, ...employers, ...employers];
---

<section class="overflow-hidden" data-reveal>
	<p class="mb-4 text-center text-xs font-semibold uppercase tracking-widest text-muted">
		Companies I have designed for
	</p>
	{/* Focusable region so keyboard users can pause the strip too. Only the
	    first copy is read out; the two loop copies are aria-hidden. */}
	<div class="marquee-mask logos-mask" tabindex="0" role="region" aria-label="Companies I have designed for">
		<div class="marquee-track">
			{
				track.map((name, i) => (
					<span class="marquee-name shrink-0 px-8 text-xl font-bold whitespace-nowrap" aria-hidden={i >= employers.length ? 'true' : undefined}>{name}</span>
				))
			}
		</div>
	</div>
</section>

<script>
	// Étape 16, S91: a click or a tap toggles pause / play; a click elsewhere
	// plays again. Keyboard: the strip still pauses when it gets the focus,
	// and Enter or Space toggles. Mouse hover still pauses (CSS); a click on
	// the paused strip plays it, until the pointer leaves the strip.
	const mask = document.querySelector<HTMLElement>('.logos-mask');
	if (mask) {
		type State = '' | 'paused' | 'playing';
		let state: State = '';
		const set = (s: State) => {
			state = s;
			mask.classList.toggle('lm-paused', s === 'paused');
			mask.classList.toggle('lm-playing', s === 'playing');
		};
		// What the visitor sees decides: paused (by a click, by the mouse
		// hovering it, or by the keyboard focus) -> play; running -> pause.
		// A finger has no real hover (the browser keeps one after a tap), so
		// for touch only the click state counts.
		let touch = false;
		mask.addEventListener('pointerdown', (e) => { touch = e.pointerType !== 'mouse'; });
		const toggle = (keyboard: boolean) => {
			const held = keyboard ? mask.matches(':focus-visible') : !touch && mask.matches(':hover');
			const paused = state === 'paused' || (state === '' && held);
			set(paused ? 'playing' : 'paused');
		};
		mask.addEventListener('click', () => toggle(false));
		mask.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			e.preventDefault();
			toggle(true);
		});
		document.addEventListener('pointerdown', (e) => {
			if (state && !mask.contains(e.target as Node)) set('');
		});
		mask.addEventListener('blur', () => set(''));
		// The pointer leaves after a click that played: back to normal (a
		// focus given by the mouse would pause it again, so it is let go).
		mask.addEventListener('mouseleave', () => {
			if (state !== 'playing') return;
			set('');
			if (document.activeElement === mask && !mask.matches(':focus-visible')) mask.blur();
		});
	}
</script>
