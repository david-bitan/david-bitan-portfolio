---
const employers = [
	'Ryze Beyond',
	'Smart.bid',
	'Wochat (now Slatch)',
	'GamingTech (SBTech Group)',
	'Tradologic',
	'Arc Interactive (Publicis)',
	'Mench',
];
// Tripled (not doubled) so the strip never runs out of content mid-loop on
// wide screens — two copies can be narrower than the viewport, leaving a
// visible gap right before the seamless wrap.
const track = [...employers, ...employers, ...employers];
---

<section class="overflow-hidden py-8 sm:py-10" data-reveal>
	<p class="mb-5 text-center text-xs font-semibold uppercase tracking-widest text-muted">
		Companies I have designed for
	</p>
	<div class="marquee-mask">
		<div class="marquee-track">
			{
				track.map((name) => (
					<span class="shrink-0 px-8 text-xl font-bold text-ink/25 whitespace-nowrap">{name}</span>
				))
			}
		</div>
	</div>
</section>
