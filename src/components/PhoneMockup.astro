---
// Phase F — minimal phone mockup used inside `Mobile` zones on project pages.
//
// Composition (outer → inner):
//   1. Colored block (project-specific bg) with generous vertical padding —
//      the phone floats in the middle.
//   2. Bezel : black frame 10px thick, rounded 2.5rem (iPhone Pro corner
//      radius approximation), soft shadow, subtle white/10 hairline so the
//      bezel is still visible when the bg is very dark (Sonary slate-900).
//   3. Inner clipped container : rounds the screenshot to 2rem so it sits
//      flush inside the bezel.
//   4. `<img>` at native 375px width (mobileSrcset covers retina).
//
// No Dynamic Island / notch / physical buttons yet — kept intentionally
// simple. A more detailed SVG variant can replace this later without
// touching the call sites.

interface Props {
	src: string;
	srcset?: string;
	sizes?: string;
	alt: string;
	bgColor?: string;
	loading?: 'lazy' | 'eager';
}

const {
	src,
	srcset,
	sizes = '375px',
	alt,
	bgColor = '#0f172a',
	loading = 'lazy',
} = Astro.props;
---

<div
	class="flex items-center justify-center rounded-2xl px-6 py-14 sm:px-10 sm:py-20"
	style={`background-color: ${bgColor}`}
>
	<div class="relative rounded-[2.5rem] bg-black p-[10px] shadow-2xl ring-1 ring-white/10">
		<div class="overflow-hidden rounded-[2rem]">
			<img
				src={src}
				srcset={srcset}
				sizes={sizes}
				alt={alt}
				loading={loading}
				width="375"
				class="block h-auto w-[375px] max-w-full"
			/>
		</div>
	</div>
</div>
