			});
			pool.forEach((el, i) => {
				const pr = pairs[i];
				if (!pr) { el.style.display = 'none'; if (el.__cut) { el.__cut = null; el.removeAttribute('clip-path'); } return; }
				const q = pr.q, a = pr.a, b = pr.b, { x, y, w, h, r } = pr.now;
				el.style.display = '';
				el.setAttribute('d', sq(x, y, w, h, r)); // a squircle (pills and circles stay round)
				const cut = pr.cut ? `url(#${pr.up.clip.cp.id})` : null;
				if (el.__cut !== cut) { el.__cut = cut; if (cut) el.setAttribute('clip-path', cut); else el.removeAttribute('clip-path'); }
