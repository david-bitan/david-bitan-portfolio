				pr.vis = V ? { x: x0, y: y0, w: Math.max(0, Math.min(x + w, V.x + V.w) - x0), h: Math.max(0, Math.min(y + h, V.y + V.h) - y0) } : pr.now;
				if (pr.clip) { const v = pr.vis; pr.clip.r.setAttribute('d', sq(v.x, v.y, v.w, v.h, pr.now.r)); }
