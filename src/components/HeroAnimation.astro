				pairs = pairUp(A, B); morphKey = key;
				scenes[n].g.style.display = 'none';
			}
			const sp = scenes[p], sn = scenes[n];
			if (tau < 0.15) { sp.g.style.display = ''; sp.g.classList.add('ha-hide-m'); sp.g.style.opacity = (1 - sm(tau / 0.15)).toFixed(3); }
			else sp.g.style.display = 'none';
			doodleSets[p].style.opacity = (1 - sm(clamp(tau / 0.15))).toFixed(3); lastTrace[p] = -1;
			if (tau >= 1.05) { sn.g.style.display = ''; sn.g.classList.toggle('ha-hide-m', tau < 1.25); sn.g.style.opacity = tau < 1.25 ? sm((tau - 1.05) / 0.2).toFixed(3) : 1; }
			else sn.g.style.display = 'none';
			if (tau < 1.25) drawMorph(tau); else morphG.style.display = 'none';
		}

		// ---- Timeline
		let t = H + 0.15, last = null, onScreen = true, raf = 0;
		const wrapS = (k, T) => { let s = ((T - START[k]) % LOOP + LOOP) % LOOP; if (s >= LOOP - H) s -= LOOP; return s; };
		function render() {
			const T = t;
			let p = -1, n = -1, tau = 0, current = 0;
			for (let k = 0; k < N; k++) { const s = wrapS(k, T); if (s < H) { n = k; p = (k + N - 1) % N; tau = s + H; } if (s >= 0 && s < DURS[k]) current = k; }
			const inTrans = n >= 0;
			scenes.forEach((sc, k) => {
				const s = wrapS(k, T);
				const vis = inTrans ? k === p || k === n : k === current;
				sc.g.style.display = vis ? '' : 'none';
				doodleSets[k].style.display = vis ? '' : 'none';
				if (!vis) return;
				if (!inTrans) { sc.g.style.opacity = 1; sc.g.classList.remove('ha-hide-m'); }
				if (!inTrans) { sc.items.forEach((it) => { it.style.opacity = 1; it.removeAttribute('transform'); }); }
				update[k](s, T);
				if (!inTrans || k === n) trace(k, clamp((s + H - TRACE_AT) / 0.4));
			});
			if (inTrans) transB(p, n, tau, T, `${p}-${n}-${Math.floor(T / LOOP)}`);
			if (!inTrans) morphG.style.display = 'none';
			doodles.forEach((d) => {
				if (doodleSets[+d.el.closest('.ha-doodles').dataset.scene].style.display === 'none') return;
				const f = float(d.i, T), a = d.tag === 'pin' ? 0.3 : 1; // the "live UI" arrow keeps its tail on the design
				d.el.setAttribute('transform', `translate(${d.x + a * f.dx} ${d.y + a * f.dy}) rotate(${d.r + a * f.dr}) scale(${d.s})`);
			});
			dots.forEach((d, k) => d.setAttribute('aria-current', k === current ? 'true' : 'false'));
		}
		function frame(now) {
			raf = 0;
			if (last != null) t = (t + Math.min(0.05, (now - last) / 1000)) % LOOP;
			last = now;
			render();
			schedule();
		}
		function schedule() {
			if (raf || reduce.matches || !onScreen || document.hidden) { last = null; return; }
			raf = requestAnimationFrame(frame);
		}
		document.addEventListener('visibilitychange', schedule);
		new IntersectionObserver((es) => { onScreen = es[0].isIntersecting; schedule(); }).observe(root);
		// Reduced motion: each scene shown still. Scene 1: prompt typed, line in the middle, wireframe left, UI right.
		const still = (k) => (k === 0 ? S0 - 0.05 : START[k] + DURS[k] - 0.8);
		dots.forEach((d) => d.addEventListener('click', () => { const k = +d.dataset.go; t = reduce.matches ? still(k) : START[k] + H + 0.01; render(); schedule(); }));
		if (reduce.matches) t = still(0);
		render();
		schedule();
	})();
</script>

