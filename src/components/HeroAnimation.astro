				// 0.27 s in the middle of the move (same pixels as an old layer fading over the new), outline too
				const flip = Math.abs(a.f[0] - b.f[0]) > 0.35, m = sm(clamp(((tau - 0.15 - pr.delay) / 0.9 - 0.35) / 0.3)); // about 0.27 s
				if (flip) { el.style.fill = `rgba(${a.c.slice(0, 3).map((v, i) => Math.round(v + (b.c[i] - v) * m)).join(',')},${(a.c[3] + (b.c[3] - a.c[3]) * m).toFixed(3)})`; }
