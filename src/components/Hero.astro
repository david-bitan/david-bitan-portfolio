---
import HeroAnimation from './HeroAnimation.astro';
---

<section class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-10 px-6 pt-10 pb-12 sm:pt-12 sm:pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-12 lg:px-0" data-reveal>
	<div>
	<p class="text-sm font-semibold uppercase tracking-widest text-muted">
		Product Design · UX/UI
	</p>

	<h1 class="mt-4 max-w-4xl text-[1.8rem] min-[374px]:text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
		Senior <span class="text-accent">AI</span> Product Designer
	</h1>

	<!-- Specialties, laid out as on the LinkedIn banner: the first on its own
	     line, then the two others with a round orange separator, twice a text
	     dot (CL2 phase D). The dot stays with "Web & Mobile". -->
	<p class="mt-4 text-base font-semibold leading-relaxed text-muted sm:text-lg">
		<span class="block">AI Features &amp; Chatbots</span>
		<span>Multi-brand Design Systems</span>
		<span class="whitespace-nowrap"><span class="mx-3 inline-block size-2 rounded-full bg-accent align-middle" aria-hidden="true"></span>Web &amp; Mobile</span>
	</p>

	<p class="mt-4 max-w-xl text-lg text-muted">
		Product designer shipping AI-native products. I design SaaS, fintech and gaming products, from user research to shipped design systems,
		and now build AI products end to end.
	</p>

	<!-- Availability sits right above the buttons so a recruiter reads status,
	     then action. The Cactus badge moved out of the hero (still in Metrics
	     and on About) per the 2026-11-12 recruiter brief. -->
	<!-- DOM order reads naturally for screen readers. On phones the line breaks
	     after "Available now · Ashkelon, Israel", so no separator dangles at a
	     line end, and "Hybrid or remote, Tel Aviv area" sits on its own line. -->
	<p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-ink">
		<span class="order-1 inline-flex items-center gap-2">
			<span class="size-2.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
			Available now
		</span>
		<span class="order-2 text-muted" aria-hidden="true">·</span>
		<span class="order-3 whitespace-nowrap">Ashkelon, Israel</span>
		<span class="order-4 basis-full sm:hidden" aria-hidden="true"></span>
		<span class="order-5 hidden text-muted sm:inline" aria-hidden="true">·</span>
		<span class="order-6 whitespace-nowrap pl-[18px] sm:pl-0">Hybrid or remote, Tel Aviv area</span>
	</p>

	<div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
		<div class="flex flex-col gap-4 sm:flex-row">
			<a
				href="#work"
				class="rounded-pill bg-accent px-7 py-3.5 text-center text-sm font-semibold text-accent-ink hover:bg-ink hover:text-bg transition-colors"
			>
				See work
			</a>
			<a
				href="/cv/CV-David-Bitan.pdf"
				download
				class="rounded-pill border border-ink/15 px-7 py-3.5 text-center text-sm font-semibold hover:border-ink/40 transition-colors"
			>
				Download CV
			</a>
		</div>

		<!-- The .docx sits under the button rather than beside it: recruiters
		     who need the editable file are a minority, and a third pill in the
		     row would have made the primary action compete with itself. -->
		<!-- Centred on mobile: the two buttons above stretch full-width with their
		     labels centred, so a left-aligned line underneath reads as misaligned.
		     From sm up the row is horizontal and the link sits beside them, where
		     left alignment is the correct relationship again. -->
		<p class="text-center text-sm text-muted sm:ml-1 sm:text-left">
			<a
				href="/cv/CV-David-Bitan.docx"
				download
				class="font-semibold text-ink underline underline-offset-4 hover:text-accent-text transition-colors"
			>
				or download .docx
			</a>
		</p>
	</div>
	</div>

	<!-- Decorative animation: beside the text on desktop, under it (smaller)
	     on phones; the text stays what you read first. -->
	<div class="mx-auto w-full max-w-[420px] lg:max-w-none">
		<HeroAnimation />
	</div>
</section>
