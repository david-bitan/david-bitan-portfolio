---
---

<section class="mx-auto max-w-[1200px] px-6 pt-10 pb-12 sm:pt-12 sm:pb-16 lg:px-0" data-reveal>
	<p class="text-sm font-semibold uppercase tracking-widest text-muted">
		Senior Product Designer · 20+ years
	</p>

	<h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
		20+ years of product design craft, now <span class="text-accent">AI-native</span>.
	</h1>

	<p class="mt-4 max-w-xl text-lg text-muted">
		Product interfaces across web, mobile, 3D, video and concept art — designed with an
		AI-native workflow.
	</p>

	<!-- Sits under the lead rather than in the button row: beside two pills and
	     the .docx link it pushed that row well past the text column and made a
	     single over-long line. inline-flex so the card hugs its content instead
	     of stretching the full width. Previous version kept in
	     archives/v188_2026-08-31_before-stagger-nthchild-and-x-size/Hero.astro. -->
	<div class="mt-5 inline-flex items-center gap-3 rounded-md bg-card px-4 py-3">
		<span class="text-xl">🏆</span>
		<p class="text-sm font-medium text-muted">
			<span class="font-semibold text-ink">12+ Cactus awards</span> in 5 years · Publicis Group team contributor
		</p>
	</div>

	<div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
		<div class="flex flex-col gap-4 sm:flex-row">
			<a
				href="#work"
				class="rounded-pill bg-accent px-7 py-3.5 text-center text-sm font-semibold text-accent-ink hover:bg-ink transition-colors"
			>
				See work
			</a>
			<a
				href="/cv/CV-David-Bitan.pdf"
				download
				class="rounded-pill border border-ink/15 px-7 py-3.5 text-center text-sm font-semibold hover:border-ink/40 transition-colors"
			>
				Download CV
			</a>
		</div>

		<!-- The .docx sits under the button rather than beside it: recruiters
		     who need the editable file are a minority, and a third pill in the
		     row would have made the primary action compete with itself. -->
		<!-- Centred on mobile: the two buttons above stretch full-width with their
		     labels centred, so a left-aligned line underneath reads as misaligned.
		     From sm up the row is horizontal and the link sits beside them, where
		     left alignment is the correct relationship again. -->
		<p class="text-center text-sm text-muted sm:ml-1 sm:text-left">
			<a
				href="/cv/CV-David-Bitan.docx"
				download
				class="font-semibold text-ink underline underline-offset-4 hover:text-accent transition-colors"
			>
				or download .docx
			</a>
		</p>
	</div>
</section>
