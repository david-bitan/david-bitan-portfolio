---
import HeroAnimation from './HeroAnimation.astro';
---

<section class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-10 px-6 pt-10 pb-12 sm:pt-12 sm:pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-12 min-[1248px]:px-0" data-reveal>
	<div>
	<p class="text-sm font-semibold uppercase tracking-widest text-muted">
		Product Design · UX/UI
	</p>

	<h1 class="mt-4 max-w-4xl text-[1.8rem] min-[374px]:text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
		Senior <span class="text-accent">AI</span> Product Designer
	</h1>

	<!-- Specialties, laid out as on the LinkedIn banner: the first on its own
	     line, then the two others with a round orange separator, twice a text
	     dot (CL2 phase D). The dot stays with "Web & Mobile". Phones: 14px under
	     390px, 15px from 390px, so the second line fits even at 360px (measured
	     309px for 312px of room); desktop unchanged (David, 15/11). -->
	<p class="mt-4 text-[14px] font-semibold leading-relaxed text-quiet min-[390px]:text-[15px] sm:text-lg">
		<span class="block">AI Features &amp; Chatbots</span>
		<span>Multi-brand Design Systems</span>
		<span class="whitespace-nowrap"><span class="mx-3 inline-block size-2 rounded-full bg-accent align-middle" aria-hidden="true"></span>Web &amp; Mobile</span>
	</p>

	<p class="mt-4 max-w-xl text-lg text-muted">
		I design SaaS, fintech and gaming products, from user research to shipped design systems, and I design and build AI products end to end.
	</p>

	<!-- Availability sits right above the buttons so a recruiter reads status,
	     then action. The Cactus badge moved out of the hero (still in Metrics
	     and on About) per the 2026-11-12 recruiter brief. -->
	<!-- DOM order reads naturally for screen readers. On phones the line breaks
	     after "Available now · Ashkelon, Israel", so no separator dangles at a
	     line end, and "Hybrid or remote, Tel Aviv area" sits on its own line. -->
	<p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-ink">
		<span class="order-1 inline-flex items-center gap-2">
			<span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
			Available now
		</span>
		<span class="order-2 text-muted" aria-hidden="true">·</span>
		<span class="order-3 whitespace-nowrap">Ashkelon, Israel</span>
		<span class="order-4 basis-full sm:hidden" aria-hidden="true"></span>
		<span class="order-5 hidden text-muted sm:inline" aria-hidden="true">·</span>
		<span class="order-6 whitespace-nowrap pl-4 sm:pl-0">Hybrid or remote, Tel Aviv area</span>
	</p>

	<!-- Étape 11, 7: one orange action ("See work"), an outlined "AI Lab"
	     (white outline in dark mode, night-blue outline in light mode) that
	     goes straight to the AI Lab section, and the two CV files below. -->
	<div class="mt-7 flex flex-col gap-4">
		<div class="flex flex-col gap-4 sm:flex-row">
			<a
				href="#work"
				class="rounded-pill border-[1.5px] border-transparent bg-accent px-7 py-3.5 text-center text-sm font-semibold text-accent-ink hover:bg-ink hover:text-bg transition-colors"
			>
				See work
			</a>
			<a
				href="#ai-lab"
				class="btn-outline-ink rounded-pill px-7 py-3.5 text-center text-sm font-semibold transition-colors"
			>
				AI Lab
			</a>
		</div>
		<p class="text-center text-sm text-muted sm:text-left">
			Download CV:
			<a href="/cv/CV-David-Bitan.pdf" download class="inline-flex min-h-11 min-w-11 items-center justify-center px-1 font-semibold text-ink underline underline-offset-4 hover:text-accent-text transition-colors">PDF</a>
			<span aria-hidden="true">·</span>
			<a href="/cv/CV-David-Bitan.docx" download class="inline-flex min-h-11 min-w-11 items-center justify-center px-1 font-semibold text-ink underline underline-offset-4 hover:text-accent-text transition-colors">DOCX</a>
		</p>
	</div>
	</div>

	<!-- Decorative animation: beside the text on desktop, under it (smaller)
	     on phones; the text stays what you read first. -->
	<div class="mx-auto w-full max-w-[420px] lg:max-w-none">
		<HeroAnimation />
	</div>
</section>

<style>
	/* Étape 11, 7: outlined second button, night blue in light mode, white in
	   dark mode; fills on hover. */
	.btn-outline-ink {
		border: 1.5px solid #0d101a;
		color: #0d101a;
	}
	:global([data-theme='dark']) .btn-outline-ink {
		border-color: #ffffff;
		color: #ffffff;
	}
	.btn-outline-ink:hover {
		background-color: var(--color-ink);
		color: var(--color-bg);
	}
</style>
