---
// Étape 14, ajout 1 (S32): the composition at the top of a project page,
// validated by David page by page. Desktop (1024 px and up): a 1200 x blocTop
// stage laid over the header, x from the left edge of the container, y from
// the top of the tallest letter of the H1 (measured by the script); 2 cards
// (the 2nd in front), a pill with a real figure, 3 line drawings behind. From
// 1024 to 1439 px the whole stage shrinks with the container. Phones and
// tablets: the 2 cards in a diagonal, the pill, 2 drawings, under the text.
import { topVisuals, topLayouts, extraCards, CARD_WIDTHS, type CardRef } from '../data/topVisuals';
import { DOODLES, DOODLE_FILTERS } from '../data/doodles';
interface Props { slug: string }
const { slug } = Astro.props;
const L = topLayouts[slug];
const cards = topVisuals[slug] ?? [];
const pick = (ref: CardRef) =>
	typeof ref === 'number' ? { ...cards[ref - 1], width: CARD_WIDTHS[ref - 1] } : extraCards[ref];
const A = L && pick(L.a.card);
const B = L && pick(L.b.card);
// Étape 15, S60: phones and tablets show the desktop composition itself,
// scaled down to the column. First paint uses this estimate of its box (at a
// 342 px column, a 390 px phone); the script below measures the real box.
const est = (() => {
	if (!L || !A || !B) return null;
	const cardH = (c: any) => 32 + 20.6 + 2 + 17.9 + 12 + ((c.width - 32) * c.h) / c.w;
	const boxes: number[][] = [
		[L.a.x, L.a.y, L.a.x + A.width, L.a.y + cardH(A)],
		[L.b.x, L.b.y, L.b.x + B.width, L.b.y + cardH(B)],
		[L.pill.x, L.pill.y, L.pill.x + (L.pill.w ?? 200), L.pill.y + 53.4],
		...L.doodles.map((d) => [d.x - 24 * d.s, d.y - 24 * d.s, d.x + 24 * d.s, d.y + 24 * d.s]),
	];
	const x0 = Math.min(...boxes.map((b) => b[0])), y0 = Math.min(...boxes.map((b) => b[1]));
	const w = Math.max(...boxes.map((b) => b[2])) - x0, h = Math.max(...boxes.map((b) => b[3])) - y0;
	const k = Math.min(1, 342 / w);
	return { x0: +x0.toFixed(1), y0: +y0.toFixed(1), k: +k.toFixed(4), h: Math.round(h * k) };
})();
const dd = (d: { name: string; x: number; y: number; r: number; s: number; orange?: boolean }, x = d.x, y = d.y, k = 1) =>
	`<g class="ptv-dd${d.orange ? ' is-orange' : ''}" transform="translate(${x} ${y}) rotate(${d.r}) scale(${+(d.s * k).toFixed(3)})">` +
	`<g filter="url(#ptv-p1)" stroke-width="3.2" opacity="0.85">${DOODLES[d.name]}</g>` +
	`<g filter="url(#ptv-p2)" stroke-width="1.4" opacity="0.45" transform="translate(0.9 0.7)">${DOODLES[d.name]}</g></g>`;
---

{L && A && B && (
	<div class="ptv2" data-ptv2 style={`--bloc:${L.blocTop}px;--ph:${est!.h}px;--pt:scale(${est!.k}) translate(${-est!.x0}px, ${-est!.y0}px)`}>
		<svg class="ptv-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs set:html={DOODLE_FILTERS} /></svg>

		{/* desktop; phones and tablets: the same stage, scaled (étape 15, S60) */}
		<div class="ptv2-stage" role="group" aria-label="Product highlights">
			<svg class="ptv2-dd" width="1200" height={L.blocTop} viewBox={`0 0 1200 ${L.blocTop}`} aria-hidden="true" focusable="false" set:html={L.doodles.map((d) => dd(d)).join('')} />
			{[[A, L.a, 1], [B, L.b, 2]].map(([c, p, z]: any) => (
				<figure class="ptv-card radius-box bg-card" style={`left:${p.x}px;top:${p.y}px;width:${c.width}px;z-index:${z}`}>
					<figcaption>
						<p class="ptv-t">{c.title}</p>
						<p class="ptv-d">{c.desc}</p>
					</figcaption>
					<img src={c.src} width={c.w / 2} height={c.h / 2} alt={c.alt} loading="eager" decoding="async" class="ptv-img" />
				</figure>
			))}
			<div class="ptv-pill radius-box" style={`left:${L.pill.x}px;top:${L.pill.y}px;${L.pill.w ? `width:${L.pill.w}px;` : ''}${L.pill.bg ? `--pill-bg:${L.pill.bg};` : ''}`}>
				<span class="ptv-pill-ic" style={`background:${L.pill.color}`} aria-hidden="true">{L.pill.icon}</span>
				<span class="ptv-pill-tx"><span class="ptv-l1">{L.pill.l1}</span><span class="ptv-l2">{L.pill.l2}</span></span>
			</div>
		</div>

	</div>
)}

<script>
	// Étape 14, ajout 1: y = 0 is the top of the tallest letter of the H1, and
	// between 1024 and 1439 px the stage shrinks with the container.
	const fit = () => {
		document.querySelectorAll<HTMLElement>('[data-ptv-hero]').forEach((hero) => {
			hero.style.setProperty('--f', String(Math.min(1, hero.clientWidth / 1200)));
			const h1 = hero.querySelector('h1');
			if (!h1) return;
			const range = document.createRange();
			range.selectNodeContents(h1);
			const line = range.getClientRects()[0];
			if (!line) return;
			const cs = getComputedStyle(h1);
			const ctx = document.createElement('canvas').getContext('2d');
			if (!ctx) return;
			ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
			const m = ctx.measureText((h1.textContent || '').trim());
			const top = line.top + (m.fontBoundingBoxAscent - m.actualBoundingBoxAscent) - hero.getBoundingClientRect().top;
			hero.style.setProperty('--glyph', `${top.toFixed(2)}px`);
		});
	};
	// Étape 15, S60: phones and tablets, the stage is cropped to the box of
	// what it shows (cards, pill, drawings) and scaled to the column.
	const fitPhone = () => {
		if (matchMedia('(min-width: 1024px)').matches) return;
		document.querySelectorAll<HTMLElement>('[data-ptv2]').forEach((host) => {
			const stage = host.querySelector<HTMLElement>('.ptv2-stage');
			if (!stage) return;
			const prev = stage.style.transform;
			stage.style.transform = 'none';
			const o = stage.getBoundingClientRect();
			let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
			const add = (r: DOMRect) => {
				if (!r.width && !r.height) return;
				x0 = Math.min(x0, r.left - o.left); y0 = Math.min(y0, r.top - o.top);
				x1 = Math.max(x1, r.right - o.left); y1 = Math.max(y1, r.bottom - o.top);
			};
			stage.querySelectorAll(':scope > figure, :scope > .ptv-pill, .ptv2-dd > g').forEach((el) => add(el.getBoundingClientRect()));
			stage.style.transform = prev;
			if (!isFinite(x0)) return;
			const w = x1 - x0, h = y1 - y0, room = host.clientWidth;
			const k = Math.min(1, room / w);
			const dx = k < 1 ? 0 : (room - w) / 2;
			host.style.setProperty('--ph', `${(h * k).toFixed(1)}px`);
			host.style.setProperty('--pt', `translate(${dx.toFixed(1)}px, 0) scale(${k.toFixed(4)}) translate(${(-x0).toFixed(1)}px, ${(-y0).toFixed(1)}px)`);
		});
	};
	const fitAll = () => { fit(); fitPhone(); };
	fitAll();
	document.fonts?.ready.then(fitAll);
	addEventListener('load', fitPhone);
	document.querySelectorAll('[data-ptv-hero]').forEach((h) => new ResizeObserver(fitAll).observe(h));
</script>

<style>
	.ptv-defs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}
	.ptv-card {
		padding: 16px;
		box-shadow: 0 12px 32px rgb(13 16 26 / 0.14);
	}
	:global(:root[data-theme='dark']) .ptv-card {
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.6), 0 2px 6px rgb(0 0 0 / 0.4);
	}
	.ptv-t {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.375;
		color: var(--color-ink);
	}
	.ptv-d {
		margin-top: 2px;
		font-size: 13px;
		line-height: 1.375;
		color: var(--color-muted);
		text-wrap: balance; /* étape 14, ajout 2 (C), desktop and phone */
	}
	.ptv-img {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 12px;
		border-radius: 6px; /* concentric with the 16 px card */
	}
	/* pill: white, 16 px squircle, soft shadow */
	.ptv-pill {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 14px 8px 8px;
		background: var(--pill-bg, #fff);
		box-shadow: 0 8px 24px rgb(20 25 40 / 0.14);
	}
	:global(:root[data-theme='dark']) .ptv-pill {
		background: var(--color-card);
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.5);
	}
	.ptv-pill-ic {
		display: grid;
		place-items: center;
		flex: none;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		color: #fff;
		font-size: 15px;
		font-weight: 700;
		line-height: 1;
	}
	@supports (corner-shape: superellipse(3)) {
		.ptv-pill-ic {
			corner-shape: superellipse(3);
		}
	}
	.ptv-pill-tx {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.ptv-l1 {
		font-size: 17px;
		font-weight: 700;
		line-height: 1.25;
		color: #0d101a;
		white-space: nowrap;
	}
	.ptv-l2 {
		font-size: 12px;
		line-height: 1.35;
		color: #4b5263;
		text-wrap: balance;
	}
	:global(:root[data-theme='dark']) .ptv-l1 {
		color: var(--color-ink);
	}
	:global(:root[data-theme='dark']) .ptv-l2 {
		color: #b8bdc8;
	}
	/* drawings: hero line, grey (hero colours), one orange */
	:global(.ptv-dd) {
		fill: none;
		stroke: #5a6378;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	:global(:root[data-theme='dark'] .ptv-dd) {
		stroke: #b8bdc8;
	}
	:global(.ptv-dd.is-orange),
	:global(:root[data-theme='dark'] .ptv-dd.is-orange) {
		stroke: #f25c24; /* the orange one stays orange in both themes */
	}

	/* ---------- desktop ---------- */
	.ptv2-stage {
		display: block;
		position: absolute;
		left: 0;
		width: 1200px;
		height: var(--bloc);
		transform-origin: 0 0;
	}
	.ptv2-stage > * {
		position: absolute;
	}
	.ptv2-dd {
		left: 0;
		top: 0;
		overflow: visible;
		z-index: 0;
		pointer-events: none;
	}
	.ptv2-stage .ptv-pill {
		z-index: 3;
	}
	@media (min-width: 1024px) {
		.ptv2 {
			position: relative;
			height: calc((var(--glyph, 8px) + var(--bloc)) * var(--f, 1));
			pointer-events: none;
		}
		.ptv2-stage {
			top: var(--glyph, 8px);
			transform: scale(var(--f, 1));
		}
		.ptv2-stage > * {
			pointer-events: auto;
		}
	}

	/* ---------- phones and tablets (étape 15, S60) ----------
	   The desktop composition itself (2 cards, pill, 3 drawings, same
	   places), cropped to its own box and scaled to the column width; never
	   larger than on desktop (tablets: centred at its desktop size). The
	   script sets --ph (height) and --pt (scale + offset) from the real box. */
	@media (max-width: 1023.98px) {
		.ptv2 {
			position: relative;
			margin-top: var(--sp-title);
			height: var(--ph);
			/* the unscaled 1200 px stage must not widen the page or catch taps
			   outside the picture; shadows keep 24 px of room */
			overflow: clip;
			overflow-clip-margin: 24px;
		}
		.ptv2-stage {
			top: 0;
			transform: var(--pt);
			pointer-events: none;
		}
		.ptv2-stage > :not(.ptv2-dd) {
			pointer-events: auto;
		}
	}
</style>
