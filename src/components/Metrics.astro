---
// Recent, verifiable figures only (2026-11-12): no years-of-experience
// count (age bias) and the Cactus awards live on /about.
type Metric = { value: string; label: string; sub?: string };

const metrics: Metric[] = [
	{ value: '~40', label: 'Verticals on one design system', sub: 'Top5 comparison family' },
	{ value: '96', label: 'Screens shipped', sub: 'Sonary SaaS, from a 2,000+ frame Figma project' },
	{ value: '4', label: 'AI products with live demos', sub: 'APEX Athletic Club · Otium · Facet · Margin' },
];
---

<section class="border-y border-ink/5" data-reveal>
	<div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-y-8 px-6 py-8 sm:py-10 sm:grid-cols-3 lg:px-0">
		{
			metrics.map((metric) => (
				<div class="px-3 text-center sm:border-l sm:border-ink/5 sm:first:border-l-0">
					<p class="text-4xl font-extrabold tracking-tight sm:text-5xl">{metric.value}</p>
					<p class="mt-2 text-sm text-muted">{metric.label}</p>
					{metric.sub && (
						<p class="mt-1 text-xs text-muted">{metric.sub}</p>
					)}
				</div>
			))
		}
	</div>
</section>
