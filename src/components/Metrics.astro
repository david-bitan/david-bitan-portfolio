---
const metrics = [
	{ value: '20+', label: 'Years experience' },
	{ value: '6', label: 'Industries' },
	{ value: '3×', label: 'Cactus awards' },
	{ value: '100+', label: 'Shipped features' },
];
---

<section class="border-y border-ink/5" data-reveal>
	<div class="mx-auto grid max-w-[1200px] grid-cols-2 gap-y-10 px-6 py-14 sm:grid-cols-4">
		{
			metrics.map((metric) => (
				<div class="text-center sm:border-l sm:border-ink/5 sm:first:border-l-0">
					<p class="text-4xl font-extrabold tracking-tight sm:text-5xl">{metric.value}</p>
					<p class="mt-2 text-sm text-muted">{metric.label}</p>
				</div>
			))
		}
	</div>
</section>
