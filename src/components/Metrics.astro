---
// Recent, verifiable figures only (2026-11-12): no years-of-experience
// count (age bias) and the Cactus awards live on /about.
type Metric = { value: string; label: string; sub?: string; note?: string; icon: string[] };

const metrics: Metric[] = [
	{ value: '40+', label: 'Verticals on one design system', sub: 'Top5 comparison family',
		// stacked layers
		icon: ['M16.1 4.6c3.9 1.9 7.6 3.8 11.3 5.6-3.8 2-7.5 3.9-11.4 5.8-3.8-1.9-7.6-3.8-11.4-5.7 3.9-2 7.6-3.8 11.5-5.7z', 'M4.9 15.7c3.7 1.8 7.4 3.7 11.2 5.6 3.7-1.9 7.4-3.7 11.1-5.7', 'M4.7 21.1c3.8 1.9 7.5 3.8 11.3 5.7 3.8-1.9 7.6-3.9 11.4-5.8'] },
	{ value: '96', label: 'Screens shipped', sub: 'Sonary SaaS, 2,000+ Figma frames',
		// desktop screen + phone
		icon: ['M4.2 6.4c6.1-.2 12.2-.1 18.3 0 .2 4.4.1 8.8 0 13.2-6.1.2-12.2.1-18.3 0-.2-4.4-.2-8.8 0-13.2z', 'M13.3 19.9c0 1.2.1 2.4 0 3.6', 'M9.6 23.7c2.4-.1 4.9-.1 7.3 0', 'M22.4 11.2c2.1-.1 4.2-.1 6.2 0 .2 4.3.2 8.6 0 12.9-2.1.2-4.1.1-6.2 0-.2-4.3-.2-8.6 0-12.9z', 'M24.9 21.7c.4 0 .9 0 1.3 0'] },
	{ value: '4', label: 'AI products with live demos', sub: 'APEX · Otium · Facet · Margin',
		// sparkle
		icon: ['M15.9 4.2c.8 6.6 2.6 10 11.3 11.7-8.6 1.6-10.5 5.1-11.4 11.9-.8-6.8-2.7-10.2-11.3-11.8 8.6-1.7 10.6-5.1 11.4-11.8z', 'M25.8 3.6c0 1.6.1 3.1 0 4.7', 'M23.5 6c1.6-.1 3.1-.1 4.7 0'] },
];
---

{/* Étape 9, B6: on phones no hairlines, each figure in its own box (card
    colour, the one box radius, squircle); tablet and desktop unchanged.
    Étape 12, 3b-3c: from 1024 px the 3 blocks share one row (étape 13, 1: below, the small
    lines wrapped), their lines
    aligned row by row (subgrid); phones: compact box, figure on the left,
    text on the right. */}
<section data-reveal>
	<div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-y-4 px-6 lg:grid-cols-3 lg:gap-y-0 min-[1248px]:px-0">
		{
			metrics.map((metric) => (
				<div class="metric grid grid-cols-[4.25rem_1fr] items-center gap-x-3 rounded-md bg-card px-4 py-4 lg:row-span-4 lg:grid-cols-1 lg:grid-rows-subgrid lg:items-start lg:gap-x-0 lg:rounded-none lg:bg-transparent lg:px-3 lg:py-0 lg:text-center lg:border-l lg:border-ink/5 lg:first:border-l-0">
					<div class="flex flex-col items-center lg:contents">
						{/* Pencil-style icon, same hand-drawn line as the banner drawings:
						    drawn stroke by stroke once when the block shows, then still. */}
						<svg class="metric-icon mb-1 h-6 w-6 text-accent lg:mx-auto lg:mb-3 lg:h-8 lg:w-8" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							{metric.icon.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
						</svg>
						<p class="text-[2rem] leading-10 font-extrabold tracking-tight lg:text-5xl lg:leading-none">{metric.value}</p>
					</div>
					<div class="lg:contents">
						<p class="text-sm text-metric-label lg:mt-2">{metric.label}</p>
						{metric.sub ? <p class="metric-sub mt-1 text-xs text-metric-sub">{metric.sub}</p> : <span class="hidden lg:block" />}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	/* Draw-on, once: the section’s data-reveal adds .is-visible when it
	   scrolls in. Each stroke starts after the previous one. */
	.metric-icon path {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}
	:global(.is-visible) .metric-icon path {
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 700ms cubic-bezier(0.65, 0, 0.35, 1);
		transition-delay: calc(150ms + var(--i) * 260ms);
	}
	/* Étape 13, 1: the 2nd small line, quieter. Phones (white / #1A2033
	   card): light #6E7686 (4.6:1), dark #788193 (about 4:1, accepted by
	   David for this line only). From 1024 px (on the page background):
	   light #636C7C (4.5:1 on #EAEDF2), dark #737C8E (4.5:1 on #0D101A). */
	@media (min-width: 1024px) {
		.metric-sub {
			color: #636c7c;
		}
		:global(:root[data-theme='dark']) .metric-sub {
			color: #737c8e;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.metric-icon path,
		:global(.is-visible) .metric-icon path {
			stroke-dashoffset: 0;
			transition: none;
		}
	}
</style>
