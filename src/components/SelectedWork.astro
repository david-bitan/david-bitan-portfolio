---
import ProjectCard from './ProjectCard.astro';
import HomeFilters from './HomeFilters.astro';
import { allProjects } from '../data/allProjects';

// Categories built dynamically from data — adding a new project category
// (or renaming one) in allProjects.ts automatically updates the pill row.
// Order preserved by first-occurrence to keep it stable across builds.
// Uses `categories` (multi-tag) when present, else falls back to `category`.
// "Selected work" = recent projects (Ryze Beyond era); older work sits in its
// own block below (2026-11-12 recruiter brief). Same filter bar drives both.
const EARLIER = ['ui-ux-vintage', 'branding-old', 'gamingtech', 'tradologic'];
const RECENT = ['sonary-dashboard', 'top5', 'sonary-website', 'playright', 'ryze-brand', 'sonary-mailer'];
const recent = [
	...RECENT.map((slug) => allProjects.find((p) => p.slug === slug)!).filter(Boolean),
	...allProjects.filter((p) => !EARLIER.includes(p.slug) && !RECENT.includes(p.slug)),
];
const earlier = EARLIER.map((slug) => allProjects.find((p) => p.slug === slug)!).filter(Boolean);
const workCategories = Array.from(
	new Set(allProjects.flatMap((p) => p.categories ?? [p.category])),
);
---

<section id="work" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pt-10 pb-20 sm:pt-12 sm:pb-28 lg:px-0" data-reveal>
	<div class="mb-7">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Work</p>
		<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Selected work</h2>
	</div>

	<HomeFilters
		id="work-filters"
		categories={workCategories}
		target="#work-grid > [data-categories], #earlier-grid > [data-categories]"
	/>

	<div id="work-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{recent.map((project) => <ProjectCard project={project} />)}
	</div>

	<div id="earlier-work" class="mt-16 sm:mt-20">
		<h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">Earlier work (2006 – 2018)</h3>
		<div id="earlier-grid" class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{earlier.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</section>

<script>
	// Hide the "Earlier work" heading when the active filter leaves it empty.
	document.addEventListener('home-filter:change', () => {
		const block = document.getElementById('earlier-work');
		const cards = document.querySelectorAll('#earlier-grid > [data-categories]');
		const visible = Array.from(cards).some((c) => !c.classList.contains('home-filter-hidden'));
		block?.classList.toggle('hidden', !visible);
	});
</script>
