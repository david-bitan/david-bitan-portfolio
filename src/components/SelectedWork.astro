---
import ProjectCard from './ProjectCard.astro';
import HomeFilters from './HomeFilters.astro';
import { allProjects } from '../data/allProjects';
import { WORK_RECENT, WORK_EARLIER } from '../data/caseLines';

// Categories built dynamically from data — adding a new project category
// (or renaming one) in allProjects.ts automatically updates the pill row.
// Order preserved by first-occurrence to keep it stable across builds.
// Uses `categories` (multi-tag) when present, else falls back to `category`.
// "Selected work" = recent projects (Ryze Beyond era); older work sits in its
// own block below (2026-11-12 recruiter brief). Same filter bar drives both.
// One order for the home grid and the "Next project" links (data/caseLines.ts).
const EARLIER = WORK_EARLIER;
const RECENT = WORK_RECENT;
const recent = [
	...RECENT.map((slug) => allProjects.find((p) => p.slug === slug)!).filter(Boolean),
	...allProjects.filter((p) => !EARLIER.includes(p.slug) && !RECENT.includes(p.slug)),
];
const earlier = EARLIER.map((slug) => allProjects.find((p) => p.slug === slug)!).filter(Boolean);
const workCategories = Array.from(
	new Set(allProjects.flatMap((p) => p.categories ?? [p.category])),
);
---

<section id="work" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pt-10 pb-16 sm:pt-12 sm:pb-20 min-[1248px]:px-0" data-reveal>
	<div class="mb-7">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Work</p>
		<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Selected work</h2>
	</div>

	<HomeFilters
		id="work-filters"
		categories={workCategories}
		target="#work-grid > [data-categories], #earlier-grid > [data-categories]"
	/>

	<div id="work-grid" class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
		{recent.map((project) => <ProjectCard project={project} />)}
	</div>

	<div id="earlier-work" class="mt-16 sm:mt-20">
		<h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">Earlier work (2006 – 2018)</h3>
		<div id="earlier-grid" class="mt-6 grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
			{earlier.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</section>

<script>
	// Étape 9, B5: each filter has its own order, its most representative
	// projects first, so the first cards on a phone always change (David).
	// "All" keeps the home order (recent grid, then "Earlier work"). Any other
	// filter shows its projects in ONE list, in its own order, in the first
	// grid; the earlier block hides. The cards then fade in (0.28 s), at once
	// under reduced motion.
	const ORDER: Record<string, string[]> = {
		SaaS: ['sonary-website', 'sonary-mailer', 'sonary-dashboard', 'top5'],
		'UI/UX': ['ui-ux-vintage', 'branding-old', 'sonary-dashboard', 'sonary-website', 'top5', 'playright', 'ryze-brand', 'sonary-mailer'],
		B2B: ['top5'],
		Branding: ['ryze-brand', 'branding-old'],
		iGaming: ['gamingtech', 'playright', 'tradologic'],
	};
	const grid = document.getElementById('work-grid')!;
	const earlierGrid = document.getElementById('earlier-grid')!;
	const block = document.getElementById('earlier-work');
	const slugOf = (el: Element) => (el.getAttribute('href') || '').split('/').filter(Boolean).pop() || '';
	// the home order, to come back to it on "All"
	const home = [
		...Array.from(grid.children).map((el) => ({ el, parent: grid })),
		...Array.from(earlierGrid.children).map((el) => ({ el, parent: earlierGrid })),
	];
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.addEventListener('home-filter:change', (e) => {
		const filter = (e as CustomEvent).detail?.filter as string;
		if (!filter) return;
		if (filter === '__all__' || !ORDER[filter]) {
			home.forEach(({ el, parent }) => parent.appendChild(el));
			const visible = Array.from(earlierGrid.children).some((c) => !c.classList.contains('home-filter-hidden'));
			block?.classList.toggle('hidden', !visible);
		} else {
			const bySlug = new Map(home.map(({ el }) => [slugOf(el), el]));
			ORDER[filter].forEach((slug) => { const el = bySlug.get(slug); if (el) grid.appendChild(el); });
			// anything in the category but missing from the list keeps its place after it
			home.forEach(({ el }) => { if (!ORDER[filter].includes(slugOf(el)) && !el.classList.contains('home-filter-hidden')) grid.appendChild(el); });
			home.forEach(({ el }) => { if (el.classList.contains('home-filter-hidden')) earlierGrid.appendChild(el); });
			block?.classList.add('hidden');
		}
		if (reduce.matches) return;
		Array.from(grid.children)
			.filter((el) => !el.classList.contains('home-filter-hidden'))
			.forEach((el, i) =>
				(el as HTMLElement).animate(
					[{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
					{ duration: 280, delay: Math.min(i, 3) * 40, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
				),
			);
	});
</script>
