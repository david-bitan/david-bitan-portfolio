---
// Author line of a LinkedIn recommendation: round photo (or initials until
// David supplies one), name and role. Étape 11, 5: no per-card LinkedIn link
// and no "Worked with…" line; one link under the cards instead.
import type { Testimonial } from '../data/testimonials';

interface Props {
	t: Testimonial;
}
const { t } = Astro.props;
const initials = t.name
	.split(/\s+/)
	.map((w) => w[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
// Title and company on two lines for everyone (étape 8, D): the longest role,
// "Product Manager, Playright (Ryze Beyond)", does not fit one line in a card,
// so every byline has the same shape. Text unchanged.
const cut = t.role.indexOf(', ');
const [title, company] = cut > 0 ? [t.role.slice(0, cut + 1), t.role.slice(cut + 2)] : [t.role, ''];
---

{/* Étape 9, C2: on phones the face and the name share the first row, the
    rest uses the full card width below (fewer broken lines); sm+ unchanged.
    C1: company and "worked with" lines a touch smaller, in a darker blue-grey. */}
<figcaption class="mt-6 grid grid-cols-[48px_minmax(0,1fr)] items-center gap-x-3 gap-y-2 border-t border-ink/10 pt-5 sm:flex sm:items-center sm:gap-4">
	{
		t.photo ? (
			<img src={t.photo} alt="" width="60" height="60" loading="lazy" class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-ink/10 sm:h-[60px] sm:w-[60px]" />
		) : (
			<span
				class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink/10 text-base font-bold text-muted sm:h-[60px] sm:w-[60px]"
				aria-hidden="true">{initials}</span
			>
		)
	}
	<div class="contents min-w-0 sm:block">
		<div class="min-w-0">
			<p class="font-semibold">{t.name}</p>
			<p class="mt-0.5 text-sm text-muted">{title}{company && <><br class="max-sm:hidden" /><span class="max-sm:hidden"> </span></>}<span class="reco-sub max-sm:block">{company}</span></p>
		</div>
	</div>
</figcaption>
