---
/**
 * Top nav (étape 8, M, David 15/11): every entry scrolls the home page down to
 * its section, in the home's own order (Work · AI Lab · Testimonials · About ·
 * Craft · Contact). From an inner page it goes back to the home at that
 * section (/#…). Contact is a plain link on the right (étape 9, F1) that opens /contact. The underline
 * follows the section in view (scroll spy, home only). The full /about, /craft
 * and /contact pages stay reachable from the home blocks and the footer.
 */
const links = [
	{ href: '/#work', label: 'Work', spy: 'work' },
	{ href: '/#ai-lab', label: 'AI Lab Work', spy: 'ai-lab' }, // étape 13, 14
	{ href: '/#testimonials', label: 'Testimonials', spy: 'testimonials' },
	{ href: '/#about', label: 'About', spy: 'about' },
	{ href: '/#craft', label: 'Craft', spy: 'craft' },
];
// Étape 9, F1: Contact is a link like the others and opens the /contact page
// (its form); its underline shows only on that page.
const onContact = Astro.url.pathname.replace(/\/$/, '') === '/contact';
// Étape 13, 10: the page you are on is orange in the menu (top and phone)
// on every page: About, Craft, project pages (Work), AI Lab pages.
const path = Astro.url.pathname.replace(/\/$/, '');
const current =
	path === '/about' || path === '/colophon' ? 'about' :
	path === '/craft' ? 'craft' :
	path.startsWith('/work/') ? 'work' :
	path.startsWith('/lab/') ? 'ai-lab' : null;
import DownloadCV from './DownloadCV.astro';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-ink/5 bg-bg">
	{/* Étape 12, 11: 60 px high on phones and tablets (44 px burger + 2 x 7.5 px
	    + hairline); desktop unchanged (py-3.5). */}
	<nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-[7.5px] lg:py-3.5 min-[1248px]:px-0">
		<a href="/" data-menu-fade class="text-lg font-extrabold tracking-tight">David Bitan</a>

		<div class="hidden items-center gap-8 lg:flex">
			{
				links.map((link) => (
					<a href={link.href} class:list={['nav-link text-sm transition-colors', current === link.spy ? 'nav-link-active font-semibold' : 'font-medium text-muted hover:text-ink']} aria-current={current === link.spy ? 'page' : undefined} data-spy={link.spy}>
						{link.label}
					</a>
				))
			}
			<a href="/contact" class:list={['nav-link text-sm transition-colors', onContact ? 'nav-link-active font-semibold' : 'font-medium text-muted hover:text-ink']} aria-current={onContact ? 'page' : undefined}>Contact</a>
		</div>

		<div class="flex items-center gap-3">
			<button
				id="theme-toggle"
				type="button"
				data-menu-fade
				aria-label="Toggle dark mode"
				class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink hover:border-ink/40 transition-colors"
			>
				<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
				</svg>
				<svg id="theme-icon-sun" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
			</button>

			<button
				id="nav-toggle"
				type="button"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-nav"
				class="nav-burger relative flex h-11 w-11 items-center justify-center lg:hidden"
			>
				{/* One button that morphs (David, 15/11): the 3 bars meet in the
				    middle, then two of them turn into the X; closing is the exact
				    reverse. Ink box 24 x 18, like the old burger. */}
				<span class="nav-burger-box" aria-hidden="true">
					<span class="nav-bar nav-bar-1"></span>
					<span class="nav-bar nav-bar-2"></span>
					<span class="nav-bar nav-bar-3"></span>
				</span>
			</button>
		</div>
	</nav>
</header>

<div
	id="mobile-nav"
	inert
	class="mobile-nav-panel fixed inset-0 z-[60] flex flex-col items-center justify-center gap-8 bg-bg lg:hidden"
>
	{
		links.map((link) => (
			<a href={link.href} class:list={['mobile-nav-link text-3xl font-semibold', { 'nav-link-active': current === link.spy }]} aria-current={current === link.spy ? 'page' : undefined} data-spy-mobile={link.spy}>
				{link.label}
			</a>
		))
	}
	<a href="/contact" class:list={['mobile-nav-link text-3xl font-semibold', { 'nav-link-active': onContact }]} aria-current={onContact ? 'page' : undefined}>Contact</a>
	{/* Étape 13, 9: at the bottom, a light separator, then the common « Download CV » block. */}
	<div class="mobile-nav-cv mobile-nav-link flex flex-col items-center gap-4">
		<span class="block h-px w-16 bg-ink/15" aria-hidden="true"></span>
		<DownloadCV />
	</div>
</div>

<style>
	/* Mobile menu (David, 15/11): the panel FADES in and out, opacity only,
	   no slide. The links keep their own rise-in sequence (unchanged, David
	   likes it). Closing is a touch faster than opening. Visibility flips
	   after the fade so the closed panel never catches taps. */
	.mobile-nav-panel {
		opacity: 0;
		visibility: hidden;
		transition: opacity 320ms cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 320ms;
	}
	.mobile-nav-panel.is-open {
		opacity: 1;
		visibility: visible;
		transition: opacity 420ms cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0s;
	}
	.mobile-nav-panel .mobile-nav-link {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 440ms ease, transform 560ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.mobile-nav-panel.is-open .mobile-nav-link {
		opacity: 1;
		transform: none;
	}
	/* nth-child, not nth-of-type: the current page renders as <span aria-current>
	   among <a> siblings, and nth-of-type counts each tag in its own sequence. */
	.mobile-nav-panel.is-open > :nth-child(1) { transition-delay: 150ms; }
	.mobile-nav-panel.is-open > :nth-child(2) { transition-delay: 250ms; }
	.mobile-nav-panel.is-open > :nth-child(3) { transition-delay: 350ms; }
	.mobile-nav-panel.is-open > :nth-child(4) { transition-delay: 450ms; }
	.mobile-nav-panel.is-open > :nth-child(5) { transition-delay: 550ms; }
	.mobile-nav-panel.is-open > :nth-child(6) { transition-delay: 650ms; }
	.mobile-nav-panel.is-open > :nth-child(7) { transition-delay: 750ms; }

	/* While the menu is open the header sits above the panel so the burger
	   itself becomes the X. Logo, theme button and hairline fade with it. */
	#site-header.menu-open { z-index: 70; border-bottom-color: transparent; }
	#site-header [data-menu-fade] { transition: opacity 320ms ease, border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease; }
	@media (max-width: 1023.98px) {
		#site-header.menu-open [data-menu-fade] { opacity: 0; pointer-events: none; }
	}

	/* Burger -> X. Stage 1: the outer bars slide to the middle (translate).
	   Stage 2: they turn from their centre (rotate) while the middle bar goes.
	   Closing plays the same two stages backwards. */
	.nav-burger-box { position: relative; display: block; width: 24px; height: 18px; }
	.nav-bar {
		position: absolute;
		left: 0;
		top: 8px;
		width: 24px;
		height: 2px;
		border-radius: 1px;
		background: var(--color-ink);
		transition:
			translate 200ms cubic-bezier(0.65, 0, 0.35, 1) 200ms,
			rotate 200ms cubic-bezier(0.65, 0, 0.35, 1) 0ms,
			opacity 0ms linear 200ms,
			background-color 0.3s ease;
	}
	.nav-bar-1 { translate: 0 -8px; }
	.nav-bar-3 { translate: 0 8px; }
	.nav-burger[aria-expanded='true'] .nav-bar {
		translate: 0 0;
		transition:
			translate 200ms cubic-bezier(0.65, 0, 0.35, 1) 0ms,
			rotate 200ms cubic-bezier(0.65, 0, 0.35, 1) 200ms,
			opacity 0ms linear 200ms,
			background-color 0.3s ease;
	}
	.nav-burger[aria-expanded='true'] .nav-bar-1 { rotate: 45deg; }
	.nav-burger[aria-expanded='true'] .nav-bar-3 { rotate: -45deg; }
	.nav-burger[aria-expanded='true'] .nav-bar-2 { opacity: 0; }

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-panel, .mobile-nav-panel.is-open { transition: opacity 200ms ease, visibility 0s linear; }
		.mobile-nav-panel .mobile-nav-link { transition: opacity 160ms ease; transform: none; }
		.mobile-nav-panel.is-open .mobile-nav-link { transition-delay: 0s; }
		.nav-bar, .nav-burger[aria-expanded='true'] .nav-bar { transition: none; }
	}

	/* Active nav item: orange text + underline bar, set by the scroll spy on
	   the home page. Stays clickable (a click scrolls back to the section). */
	.nav-link-active {
		position: relative;
		color: var(--color-accent-text) !important;
	}
	.nav-link-active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
	}
	/* Étape 12, 12: in the phone menu the current section is orange text
	   only, never underlined. */
	.mobile-nav-panel .nav-link-active::after {
		content: none;
	}
</style>

<script>
	// --- Mobile menu open/close (one burger button that morphs into the X) ---
	const toggle = document.getElementById('nav-toggle');
	const overlay = document.getElementById('mobile-nav');
	const header = document.getElementById('site-header');
	const isOpen = () => !!overlay?.classList.contains('is-open');

	// Real header height for every sticky bar under it (73px on phones,
	// 65px on desktop since étape 11, 10). Hard-coded tops slid the bars under the hairline.
	if (header) {
		// exact height (a fraction of a pixel at some widths and zoom levels)
		const setH = () => document.documentElement.style.setProperty('--header-h', header.getBoundingClientRect().height + 'px');
		setH();
		new ResizeObserver(setH).observe(header);
	}

	function openMenu() {
		overlay?.classList.add('is-open');
		header?.classList.add('menu-open');
		toggle?.setAttribute('aria-expanded', 'true');
		toggle?.setAttribute('aria-label', 'Close menu');
		document.documentElement.style.overflowY = 'hidden';
		if (overlay) overlay.inert = false;
		document.querySelectorAll<HTMLElement>('#site-header [data-menu-fade], body > main, body > footer, #back-to-top, .skip-link').forEach((el) => (el.inert = true));
	}
	function closeMenu() {
		overlay?.classList.remove('is-open');
		header?.classList.remove('menu-open');
		toggle?.setAttribute('aria-expanded', 'false');
		toggle?.setAttribute('aria-label', 'Open menu');
		document.documentElement.style.overflowY = '';
		if (overlay) overlay.inert = true;
		document.querySelectorAll<HTMLElement>('#site-header [data-menu-fade], body > main, body > footer, #back-to-top, .skip-link').forEach((el) => (el.inert = false));
	}
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen()) { closeMenu(); toggle?.focus(); }
	});
	toggle?.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
	overlay?.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));

	// --- Theme toggle ---
	const themeToggle = document.getElementById('theme-toggle');
	const moonIcon = document.getElementById('theme-icon-moon');
	const sunIcon = document.getElementById('theme-icon-sun');

	function syncThemeIcon() {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		moonIcon?.classList.toggle('hidden', isDark);
		sunIcon?.classList.toggle('hidden', !isDark);
	}
	syncThemeIcon();

	const root = document.documentElement;
	function setTheme(dark: boolean) {
		if (dark) root.setAttribute('data-theme', 'dark');
		else root.removeAttribute('data-theme');
		syncThemeIcon();
	}
	// While the theme changes, the per-element colour fades are switched off
	// (.theme-switching in global.css): otherwise each element fades on its own
	// and the header changes before the rest of the page.
	function endSwitch() {
		requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
	}

	// Étape 11, 14: one soft fade (0.4 s) for the whole page at once, with a
	// view transition; instant under reduced motion or without support.
	themeToggle?.addEventListener('click', () => {
		const dark = root.getAttribute('data-theme') !== 'dark';
		try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
		root.classList.add('theme-switching');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!reduce && document.startViewTransition) {
			document.startViewTransition(() => setTheme(dark)).finished.finally(endSwitch);
		} else {
			setTheme(dark);
			endSwitch();
		}
	});

	// Étape 11, 2: a page shown again from the back/forward cache keeps the
	// theme it had; apply the saved one each time a page is shown.
	window.addEventListener('pageshow', () => {
		let dark = false;
		try { dark = localStorage.getItem('theme') === 'dark'; } catch {}
		if (dark === (root.getAttribute('data-theme') === 'dark')) return syncThemeIcon();
		root.classList.add('theme-switching');
		setTheme(dark);
		endSwitch();
	});

	// --- Scroll spy (home only) ---
	// The section whose top has passed a line ~140px under the header is the
	// current one; nothing is underlined above Work (hero, figures, logos);
	// at the very bottom of the page, the last section (Craft) stays on.
	(function initScrollSpy() {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		if (path !== '/') return;
		const ids = ['work', 'ai-lab', 'testimonials', 'about', 'craft'];
		const sections = ids.map((id) => ({ id, el: document.getElementById(id) })).filter((x) => x.el);
		if (!sections.length) return;
		const linksFor = (id: string) => document.querySelectorAll<HTMLElement>(`[data-spy="${id}"], [data-spy-mobile="${id}"], [data-spy-btn="${id}"]`);
		let currentId: string | null = null;

		function setActive(id: string | null) {
			if (id === currentId) return;
			currentId = id;
			ids.forEach((sid) =>
				linksFor(sid).forEach((el) => {
					const on = sid === id;
					if (on) el.setAttribute('aria-current', 'location');
					else el.removeAttribute('aria-current');
					// links get the orange underline; [data-spy-btn] (old orange Contact button) is unused since étape 9, F1
					if (el.hasAttribute('data-spy-btn')) return;
					el.classList.toggle('nav-link-active', on);
					if (el.classList.contains('nav-link')) {
						el.classList.toggle('text-muted', !on);
						el.classList.toggle('font-medium', !on);
						el.classList.toggle('font-semibold', on);
					}
				}),
			);
		}
		function pick() {
			const line = 140;
			const doc = document.documentElement;
			if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) return setActive('craft');
			let picked: string | null = null;
			for (const sec of sections) {
				if (sec.el!.getBoundingClientRect().top <= line) picked = sec.id;
				else break;
			}
			setActive(picked);
		}
		// A click flips the state at once; the smooth scroll that follows does
		// not flicker through the sections it passes.
		let lockUntil = 0, ticking = false;
		window.addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => { if (Date.now() >= lockUntil) pick(); ticking = false; });
		}, { passive: true });
		window.addEventListener('resize', pick);
		document.querySelectorAll<HTMLElement>('[data-spy], [data-spy-mobile], [data-spy-btn]').forEach((el) =>
			el.addEventListener('click', () => {
				setActive(el.dataset.spy || el.dataset.spyMobile || el.dataset.spyBtn || null);
				lockUntil = Date.now() + 1000;
			}),
		);
		pick();
	})();
</script>
