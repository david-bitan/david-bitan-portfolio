---
/**
 * Top nav.
 * Five items: Work, AI Lab, Craft (all anchor-linked to home sections),
 * plus About and Contact (separate pages).
 *
 * Active state:
 *  - /about and /contact — server-side, matched by pathname
 *  - Home hash links (#work, #ai-lab, #craft) — client-side scroll spy
 *    tracks which section is in view and toggles `.nav-link-active` on
 *    the matching nav item. Active item is text-accent + underline bar +
 *    `pointer-events: none` (non-clickable) — same look/behaviour as the
 *    server-rendered active state, just driven by scroll position.
 */
const links = [
	{ href: '/#work', label: 'Work', spy: 'work' },
	{ href: '/#ai-lab', label: 'AI Lab', spy: 'ai-lab' },
	{ href: '/#craft', label: 'Craft', spy: 'craft' },
	{ href: '/about', label: 'About', spy: null },
	{ href: '/contact', label: 'Contact', spy: null },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';

// Server-side active only for /about and /contact. Home hash links are
// resolved client-side by the scroll spy.
function isActive(href: string) {
	if (href === '/about') return pathname === '/about';
	if (href === '/contact') return pathname === '/contact';
	return false;
}
---

<header class="sticky top-0 z-50 border-b border-ink/5 bg-bg">
	<nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-5 lg:px-0">
		<a href="/" class="text-lg font-extrabold tracking-tight">David Bitan</a>

		<div class="hidden items-center gap-8 lg:flex">
			{
				links.map((link) => {
					const active = isActive(link.href);
					const cls = active
						? 'nav-link nav-link-active text-sm font-semibold text-accent'
						: 'nav-link text-sm font-medium text-muted hover:text-ink transition-colors';
					const dataSpy = link.spy ? { 'data-spy': link.spy } : {};
					return active ? (
						<span aria-current="page" class={cls} {...dataSpy}>
							{link.label}
						</span>
					) : (
						<a href={link.href} class={cls} {...dataSpy}>
							{link.label}
						</a>
					);
				})
			}
		</div>

		<div class="flex items-center gap-3">
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle dark mode"
				class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink hover:border-ink/40 transition-colors"
			>
				<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
				</svg>
				<svg id="theme-icon-sun" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
			</button>

			<button
				id="nav-toggle"
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="flex flex-col gap-1.5 p-2 lg:hidden"
		>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
		</button>
		</div>
	</nav>
</header>

<div
	id="mobile-nav"
	class="fixed inset-0 z-[60] flex translate-x-full flex-col items-center justify-center gap-8 bg-bg transition-transform duration-300 ease-out lg:hidden"
>
	<button id="nav-close" type="button" aria-label="Close menu" class="absolute right-6 top-5 p-2">
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>
	{
		links.map((link) => {
			const active = isActive(link.href);
			const cls = active
				? 'mobile-nav-link nav-link-active text-3xl font-semibold text-accent'
				: 'mobile-nav-link text-3xl font-semibold';
			const dataSpy = link.spy ? { 'data-spy-mobile': link.spy } : {};
			return active ? (
				<span aria-current="page" class={cls} {...dataSpy}>
					{link.label}
				</span>
			) : (
				<a href={link.href} class={cls} {...dataSpy}>
					{link.label}
				</a>
			);
		})
	}
</div>

<style>
	/* Active nav item: orange text (applied inline) + underline bar sized to
	   the word only. Non-clickable — applied to both `<span aria-current>`
	   (server-rendered for /about, /contact) and `<a>` promoted to active by
	   the scroll spy on the home page. */
	.nav-link-active {
		position: relative;
		color: var(--color-accent) !important;
		cursor: default;
		pointer-events: none;
	}
	.nav-link-active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
	}
</style>

<script is:inline define:vars={{ isHome }}>
	// --- Mobile menu open/close ---
	const toggle = document.getElementById('nav-toggle');
	const close = document.getElementById('nav-close');
	const overlay = document.getElementById('mobile-nav');

	function openMenu() {
		overlay?.classList.remove('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}
	function closeMenu() {
		overlay?.classList.add('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}
	toggle?.addEventListener('click', openMenu);
	close?.addEventListener('click', closeMenu);
	overlay?.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));

	// --- Theme toggle ---
	const themeToggle = document.getElementById('theme-toggle');
	const moonIcon = document.getElementById('theme-icon-moon');
	const sunIcon = document.getElementById('theme-icon-sun');

	function syncThemeIcon() {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		moonIcon?.classList.toggle('hidden', isDark);
		sunIcon?.classList.toggle('hidden', !isDark);
	}
	syncThemeIcon();

	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		if (isDark) {
			document.documentElement.removeAttribute('data-theme');
			localStorage.setItem('theme', 'light');
		} else {
			document.documentElement.setAttribute('data-theme', 'dark');
			localStorage.setItem('theme', 'dark');
		}
		syncThemeIcon();
	});

	// --- Scroll spy (home only) ---
	// Watches #work, #ai-lab, #craft. Whichever section is most in view
	// gets its nav item promoted to `.nav-link-active` (adds text-accent,
	// underline, and pointer-events:none). Runs on scroll via
	// IntersectionObserver with a rootMargin biased to the upper third of
	// the viewport so the active item flips cleanly as sections cross a
	// consistent line under the sticky nav.
	if (isHome) {
		const desktopLinks = new Map();
		const mobileLinks = new Map();
		document.querySelectorAll('[data-spy]').forEach((el) => {
			desktopLinks.set(el.getAttribute('data-spy'), el);
		});
		document.querySelectorAll('[data-spy-mobile]').forEach((el) => {
			mobileLinks.set(el.getAttribute('data-spy-mobile'), el);
		});

		const sectionIds = ['work', 'ai-lab', 'craft'];
		const sections = sectionIds
			.map((id) => document.getElementById(id))
			.filter(Boolean);

		let currentActive = null;

		function setActive(id) {
			if (id === currentActive) return;
			currentActive = id;
			// Clear
			for (const map of [desktopLinks, mobileLinks]) {
				map.forEach((el, key) => {
					const active = key === id;
					if (active) {
						el.classList.add('nav-link-active', 'text-accent');
						el.classList.remove('text-muted', 'hover:text-ink', 'transition-colors', 'font-medium');
						el.classList.add('font-semibold');
					} else {
						el.classList.remove('nav-link-active', 'text-accent');
						// Restore default look (desktop only — mobile keeps font-semibold always)
						if (map === desktopLinks) {
							el.classList.add('text-muted', 'hover:text-ink', 'transition-colors', 'font-medium');
							el.classList.remove('font-semibold');
						}
					}
				});
			}
		}

		if (sections.length) {
			// Track intersection ratios and pick the section with highest
			// visibility above the middle of the viewport.
			const io = new IntersectionObserver(
				(entries) => {
					// Aggregate: for each observed section, keep its latest
					// intersectionRatio. Pick the one with the largest ratio
					// that is currently intersecting; fallback to whichever
					// section top is nearest above the viewport middle.
					const ratios = new Map();
					entries.forEach((e) => {
						ratios.set(e.target.id, {
							ratio: e.intersectionRatio,
							top: e.boundingClientRect.top,
							isIntersecting: e.isIntersecting,
						});
					});
					// Merge with previous state (IO only reports changes)
					sections.forEach((s) => {
						if (!ratios.has(s.id)) {
							const rect = s.getBoundingClientRect();
							ratios.set(s.id, {
								ratio: 0,
								top: rect.top,
								isIntersecting: rect.top < window.innerHeight && rect.bottom > 0,
							});
						}
					});

					// Best pick: section that is intersecting with the largest
					// ratio. If none, pick the last one whose top is above the
					// viewport middle (user scrolled past it).
					let bestId = null;
					let bestRatio = -1;
					ratios.forEach((v, id) => {
						if (v.isIntersecting && v.ratio > bestRatio) {
							bestRatio = v.ratio;
							bestId = id;
						}
					});
					if (!bestId) {
						const mid = window.innerHeight / 2;
						let closest = null;
						let closestDist = Infinity;
						ratios.forEach((v, id) => {
							if (v.top <= mid) {
								const d = mid - v.top;
								if (d < closestDist) {
									closestDist = d;
									closest = id;
								}
							}
						});
						bestId = closest;
					}
					if (bestId) setActive(bestId);
				},
				{
					// Trigger when a section crosses the upper third of the
					// viewport — feels natural under the sticky nav.
					rootMargin: '-25% 0px -55% 0px',
					threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
				},
			);
			sections.forEach((s) => io.observe(s));

			// Initial pick — pre-select #work at page load so nothing is empty
			// before the first IO callback fires.
			setActive('work');
		}
	}
</script>
