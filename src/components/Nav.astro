---
const links = [
	{ href: '/work', label: 'Work' },
	{ href: '/craft', label: 'Craft' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-bg/80 backdrop-blur">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
		<a href="/" class="text-lg font-extrabold tracking-tight">David Bitan</a>

		<div class="hidden items-center gap-8 lg:flex">
			{
				links.map((link) => (
					<a href={link.href} class="text-sm font-medium text-muted hover:text-ink transition-colors">
						{link.label}
					</a>
				))
			}
			<a
				href="/contact"
				class="rounded-pill bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink hover:bg-ink transition-colors"
			>
				Get in touch
			</a>
		</div>

		<button
			id="nav-toggle"
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="flex flex-col gap-1.5 p-2 lg:hidden"
		>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
			<span class="block h-0.5 w-6 bg-ink"></span>
		</button>
	</nav>
</header>

<div
	id="mobile-nav"
	class="fixed inset-0 z-[60] flex translate-x-full flex-col items-center justify-center gap-8 bg-bg transition-transform duration-300 ease-out lg:hidden"
>
	<button id="nav-close" type="button" aria-label="Close menu" class="absolute right-6 top-5 p-2">
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>
	{
		links.map((link) => (
			<a href={link.href} class="mobile-nav-link text-3xl font-semibold">
				{link.label}
			</a>
		))
	}
	<a
		href="/contact"
		class="mobile-nav-link rounded-pill bg-accent px-8 py-3 text-lg font-semibold text-accent-ink"
	>
		Get in touch
	</a>
</div>

<script>
	const toggle = document.getElementById('nav-toggle');
	const close = document.getElementById('nav-close');
	const overlay = document.getElementById('mobile-nav');

	function openMenu() {
		overlay?.classList.remove('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		overlay?.classList.add('translate-x-full');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	toggle?.addEventListener('click', openMenu);
	close?.addEventListener('click', closeMenu);
	overlay?.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));
</script>
