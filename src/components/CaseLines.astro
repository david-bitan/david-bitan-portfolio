---
// Étape 8, L: the case in three lines (two on some older projects), visible
// at the top of every project page, under the introduction. Labels and texts
// validated by David; no figures.
import type { CaseLines } from '../data/caseLines';

interface Props {
	lines: CaseLines;
}
const { lines } = Astro.props;
const rows = [
	['Challenge', lines.challenge],
	['What I did', lines.did],
	...(lines.result ? [['Result', lines.result]] : []),
];
---

<dl class="mt-8 grid max-w-3xl grid-cols-1 gap-y-4 sm:grid-cols-[8.5rem_1fr] sm:gap-x-6">
	{
		rows.map(([label, text]) => (
			<>
				<dt class="text-sm font-semibold uppercase tracking-widest text-muted sm:pt-0.5">{label}</dt>
				<dd class="-mt-3 leading-relaxed text-ink sm:mt-0">{text}</dd>
			</>
		))
	}
</dl>
