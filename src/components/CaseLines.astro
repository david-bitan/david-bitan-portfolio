---
// Étape 14, ajout 1 (S33): the case in 4 columns under the header text and
// the product visual, across the whole container: Challenge · What I did ·
// Result · Role. No box, no background: a fine line on top of each column.
// Desktop 4 equal columns (32 px gap), tablet 2 x 2, phones one under the other.
import type { CaseLines } from '../data/caseLines';

interface Props {
	lines: CaseLines;
}
const { lines } = Astro.props;
const cols = [
	['Challenge', lines.challenge],
	['What I did', lines.did],
	...(lines.result ? [['Result', lines.result]] : []),
	['Role', lines.role],
];
---

<dl class="case-cols">
	{
		cols.map(([label, text]) => (
			<div class="case-col">
				<dt class="case-label">{label}</dt>
				<dd class="case-text">{text}</dd>
			</div>
		))
	}
</dl>

<style>
	.case-cols {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 32px;
	}
	@media (min-width: 768px) {
		.case-cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.case-cols {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.case-col {
		border-top: 1px solid rgb(13 16 26 / 0.14);
		padding-top: 16px;
	}
	:global(:root[data-theme='dark']) .case-col {
		border-top-color: rgb(255 255 255 / 0.14);
	}
	.case-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #5c6475;
	}
	:global(:root[data-theme='dark']) .case-label {
		color: #8a93a6; /* the dark equivalent, 5.6:1 on #0D101A */
	}
	.case-text {
		margin-top: 8px;
		font-size: 15px;
		line-height: 1.55;
		color: #0d101a;
		text-wrap: pretty;
	}
	:global(:root[data-theme='dark']) .case-text {
		color: var(--color-ink);
	}
</style>
