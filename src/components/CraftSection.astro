---
// Home Craft block (étape 8, P7; étape 9, B2): a real two-line title like the
// other home sections, and the strip of craft pieces running on its own, in a
// loop, exactly like the company-name marquee (same speed in px/s, same soft
// fades on both edges, pause on hover or focus; still under reduced motion).
// Étape 11, 4: all the craft pieces, 2 copies (seamless loop), light images
// loaded before they come into view, no pause stuck after a touch.
// A click opens the Craft page straight on that piece, in the viewer.
// Phones: "See craft →" under the strip, centred.
import { craftItems } from '../data/craftItems';
import { cld } from '../lib/cloudinary';

const items = craftItems;
const sq = (url: string, w: number) => cld(url, `c_fill,ar_1:1,g_center,w_${w},q_auto,f_auto`);
// Two copies back to back (one copy is wider than any screen): translating
// exactly half loops without a seam. Only the first copy is read out and
// reachable by keyboard.
const track = [...items, ...items];
---

<section id="craft" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pb-20 sm:pb-24 min-[1248px]:px-0" data-reveal>
	<div class="border-t border-ink/10 pt-14 sm:pt-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
				{/* Étape 11, 12: one line on desktop, two on phones and tablets */}
				<span class="block lg:inline">Outside product work</span><span class="mx-4 hidden size-2.5 rounded-full bg-accent align-middle lg:inline-block" aria-hidden="true"></span><span class="block lg:inline">3D and digital painting</span>
			</h2>
			<a
				href="/craft"
				class="btn-secondary hidden min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-pill px-6 text-sm font-semibold sm:inline-flex"
			>
				See craft&nbsp;<span class="arr" aria-hidden="true">→</span>
			</a>
		</div>

		{/* Full width like the names strip (its fades sit on the screen edges on phones). */}
		<div class="-mx-6 mt-8 min-[1248px]:mx-0">
		<div class="marquee-mask craft-marquee" tabindex="0" role="region" aria-label="A few craft pieces">
			<ul class="marquee-track craft-track">
				{
					track.map((item, i) => (
						<li class="craft-tile shrink-0" aria-hidden={i >= items.length ? 'true' : undefined}>
							<a href={`/craft#${item.slug}`} class="group block overflow-hidden rounded-md bg-card" tabindex={i >= items.length ? -1 : undefined}>
								<img
									src={sq(item.image, 400)}
									srcset={`${sq(item.image, 300)} 300w, ${sq(item.image, 400)} 400w, ${sq(item.image, 600)} 600w`}
									sizes="(min-width: 640px) 200px, 148px"
									alt={i >= items.length ? '' : item.title}
									width="400"
									height="400"
									loading="lazy"
									fetchpriority="low"
									decoding="async"
									class="thumb-hover-zoom aspect-square h-auto w-full object-cover"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</div>
		</div>

		<div class="mt-8 flex justify-center sm:hidden">
			<a href="/craft" class="btn-secondary inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-pill px-6 text-sm font-semibold">
				See craft&nbsp;<span class="arr" aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>

<style>
	/* Same speed as the names (one copy of names = 1,555 px in 28 s, about
	   55.5 px/s): 29 tiles of 148 + 16 px = 4,756 px in 85.7 s on phones,
	   29 x (200 + 16) = 6,264 px in 112.9 s from 640 px. */
	.craft-tile {
		width: 164px;
		padding-inline: 8px;
	}
	.craft-track {
		animation-name: craft-marquee;
		animation-duration: 85.7s;
		/* room for the focus ring, which the mask would cut */
		padding-block: 4px;
	}
	@media (min-width: 640px) {
		.craft-tile {
			width: 216px;
		}
		.craft-track {
			animation-duration: 112.9s;
		}
	}
	@keyframes craft-marquee {
		to {
			transform: translateX(-50%);
		}
	}
	/* 60 tiles inside one moving layer: no extra GPU layer per image. */
	.craft-tile img {
		will-change: auto;
	}
	/* A touch leaves :hover and :focus-within on, which used to freeze the
	   strip on phones: pause only under a real pointer or keyboard focus. */
	.craft-marquee:hover .craft-track,
	.craft-marquee:focus-within .craft-track {
		animation-play-state: running;
	}
	@media (hover: hover) and (pointer: fine) {
		.craft-marquee:hover .craft-track {
			animation-play-state: paused;
		}
	}
	.craft-marquee:focus-visible .craft-track,
	.craft-marquee:has(:focus-visible) .craft-track {
		animation-play-state: paused;
	}
	@media (prefers-reduced-motion: reduce) {
		.craft-track {
			animation: none;
		}
	}
</style>

<script>
	// Étape 11, 4: lazy images in a moving strip were only asked for once on
	// screen (an empty tile). Load them all when the block gets near.
	document.querySelectorAll<HTMLElement>('.craft-marquee').forEach((m) => {
		const io = new IntersectionObserver((entries) => {
			if (!entries.some((e) => e.isIntersecting)) return;
			m.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
			io.disconnect();
		}, { rootMargin: '800px 0px' });
		io.observe(m);
	});
	// Keyboard focus may scroll the strip sideways: put it back once the focus leaves.
	document.querySelectorAll<HTMLElement>('.craft-marquee').forEach((m) =>
		m.addEventListener('focusout', (e) => {
			if (!m.contains(e.relatedTarget as Node)) m.scrollLeft = 0;
		}),
	);
</script>
