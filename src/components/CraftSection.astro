---
// Home Craft block. Since 15/11 (David): a small swipeable strip of real
// craft pieces so the block says what it is at a glance, and "See craft →"
// as an orange-outline button. Phones: horizontal swipe with snap (no
// visible scrollbar, the next tile peeks in). Desktop (lg+): six equal
// tiles across the 1200 grid, nothing to scroll.
import { craftItems } from '../data/craftItems';
import { cld } from '../lib/cloudinary';

const picks = ['3d-03', 'paint-02', '3d-04', '3d-24', 'paint-05', '3d-05', '3d-17', '3d-12'];
const items = picks.map((s) => craftItems.find((c) => c.slug === s)!).filter(Boolean);
const sq = (url: string, w: number) => cld(url, `c_fill,ar_1:1,g_center,w_${w},q_auto:best,f_auto`);
---

<section id="craft" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pb-20 sm:pb-24 min-[1248px]:px-0" data-reveal>
	<div class="border-t border-ink/10 pt-14 sm:pt-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-muted">Outside product work: 3D and digital painting.</p>
			<a
				href="/craft"
				class="btn-secondary inline-flex min-h-11 shrink-0 items-center justify-center self-start whitespace-nowrap rounded-pill px-6 text-sm font-semibold sm:self-auto"
			>
				See craft →
			</a>
		</div>

		<ul class="craft-strip -mx-6 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-1 sm:gap-4 lg:mx-0 lg:grid lg:grid-cols-6 lg:overflow-visible lg:px-0" aria-label="A few craft pieces">
			{
				items.map((item, i) => (
					<li class:list={['w-[148px] shrink-0 snap-start sm:w-[200px] lg:w-auto', { 'lg:hidden': i > 5 }]}>
						<a href="/craft" class="group block overflow-hidden rounded-md bg-card" tabindex={i === 0 ? undefined : -1}>
							<img
								src={sq(item.image, 400)}
								srcset={`${sq(item.image, 300)} 300w, ${sq(item.image, 400)} 400w, ${sq(item.image, 600)} 600w`}
								sizes="(min-width: 1248px) 186px, (min-width: 1024px) calc((100vw - 128px) / 6), (min-width: 640px) 200px, 148px"
								alt={item.title}
								width="400"
								height="400"
								loading="lazy"
								decoding="async"
								class="thumb-hover-zoom aspect-square h-auto w-full object-cover"
							/>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.craft-strip {
		scrollbar-width: none;
		scroll-padding-inline: 24px;
	}
	.craft-strip::-webkit-scrollbar {
		display: none;
	}
	@media (min-width: 1024px) {
		.craft-strip {
			scroll-padding-inline: 0;
		}
	}
</style>
