---
import { craftItems } from '../data/craftItems';
import { cld, LANDSCAPE } from '../lib/cloudinary';

// Home shows a short, curated preview (one piece per series, 3D and painting
// mixed); the full set, filters included, lives on /craft (2026-11-12 brief:
// 4 to 6 previews + "See all personal work"). The racer series stays on /craft.
const PREVIEW = ['3d-03', '3d-24', '3d-16', '3d-06', 'paint-02', 'paint-05'];
const preview = PREVIEW.map((slug) => craftItems.find((c) => c.slug === slug)!).filter(Boolean);
---

<div class="mx-auto max-w-[1200px] px-6 lg:px-0">
	<hr class="border-t border-ink/10" />
</div>

<section id="craft" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 py-20 sm:py-28 lg:px-0" data-reveal>
	<div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="text-sm font-semibold uppercase tracking-widest text-muted">Craft</p>
			<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Personal work</h2>
			<p class="mt-4 max-w-2xl text-muted">3D renders and digital painting, outside the product work.</p>
		</div>
		<a href="/craft" class="shrink-0 whitespace-nowrap text-sm font-semibold text-accent-text hover:underline">See all personal work →</a>
	</div>

	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			preview.map((item) => (
				<a href={`/craft#${item.slug}`} class="group block overflow-hidden rounded-md bg-card">
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src={cld(item.image, LANDSCAPE)}
							alt={item.title}
							width="1200"
							height="900"
							loading="lazy"
							decoding="async"
							class="thumb-hover-zoom h-full w-full object-cover object-top"
						/>
					</div>
					<div class="p-4">
						<h3 class="text-base font-bold tracking-tight">{item.title}</h3>
						<p class="mt-1.5 line-clamp-2 text-sm text-muted">{item.description}</p>
					</div>
				</a>
			))
		}
	</div>
</section>
