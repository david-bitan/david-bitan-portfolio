---
// Full-size viewer for every gallery image on project and Lab pages
// (CL2, étape 5). Opens on click (or Enter / Space) on any [data-lb] image:
// the image at its real size on a dark veil, vertical scroll only; close with
// Esc, the cross or a click on the veil; previous / next as two round
// buttons side by side (beside a phone capture, bottom right otherwise) and
// with the arrow keys. A native <dialog>: the page behind is inert and keeps
// the keyboard focus inside.
---

<dialog class="lb" aria-label="Image viewer">
	<div class="lb-scroll" tabindex="-1">
		<div class="lb-stage"><img class="lb-img" alt="" decoding="async" /></div>
	</div>
	<button class="lb-btn lb-close" type="button" aria-label="Close">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
	<div class="lb-nav">
		<button class="lb-btn lb-prev" type="button" aria-label="Previous image">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
		</button>
		<button class="lb-btn lb-next" type="button" aria-label="Next image">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
		</button>
	</div>
</dialog>

<script>
	const dlg = document.querySelector<HTMLDialogElement>('dialog.lb');
	if (dlg) {
		const scroll = dlg.querySelector<HTMLElement>('.lb-scroll')!;
		const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
		const nav = dlg.querySelector<HTMLElement>('.lb-nav')!;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const items = () => Array.from(document.querySelectorAll<HTMLImageElement>('[data-lb]'));
		let index = 0;
		let opener: HTMLElement | null = null;

		// Real size: a phone capture at phone width (a 2x file shows at half
		// its pixels), anything else at 100 %; smaller only if the screen is.
		// On a phone the image takes the width of the screen.
		function size() {
			const nw = img.naturalWidth;
			if (!nw) return place();
			if (window.innerWidth < 640) {
				img.style.width = window.innerWidth + 'px';
			} else {
				const real = img.dataset.kind === 'mobile' && nw > 500 ? nw / 2 : nw;
				img.style.width = Math.min(real, document.documentElement.clientWidth - 48) + 'px';
			}
			place();
		}
		function place() {
			nav.hidden = items().length < 2;
			const phone = window.innerWidth < 640;
			const r = img.getBoundingClientRect();
			const side = !phone && img.dataset.kind === 'mobile' && r.right + 16 + 112 < window.innerWidth - 16;
			nav.dataset.pos = phone ? 'phone' : side ? 'side' : 'corner';
			nav.style.left = side ? r.right + 16 + 'px' : '';
		}
		function show(k: number) {
			const list = items();
			if (!list.length) return;
			index = (k + list.length) % list.length;
			const t = list[index];
			img.removeAttribute('style');
			img.dataset.kind = t.dataset.lbKind || 'desktop';
			img.alt = t.alt;
			img.src = t.dataset.lbSrc || t.currentSrc || t.src;
			scroll.scrollTop = 0;
			if (img.complete) size(); else place();
			if (!reduce.matches) img.animate([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 220, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
		}
		function open(t: HTMLImageElement) {
			opener = t;
			show(items().indexOf(t));
			document.documentElement.style.overflow = 'hidden';
			dlg!.showModal();
			scroll.focus({ preventScroll: true });
			if (!reduce.matches) dlg!.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: 'ease-out' });
		}
		img.addEventListener('load', size);
		window.addEventListener('resize', () => dlg.open && size());
		dlg.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
			opener?.focus({ preventScroll: true });
		});
		// A click anywhere but on the image or a button closes (the veil).
		dlg.addEventListener('click', (e) => {
			const el = e.target as HTMLElement;
			if (el === img || el.closest('.lb-btn')) return;
			dlg.close();
		});
		dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
		dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
		dlg.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
		dlg.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
			if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
		});
		document.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest<HTMLImageElement>('[data-lb]');
			if (t) { e.preventDefault(); open(t); }
		});
		document.addEventListener('keydown', (e) => {
			const t = (e.target as HTMLElement).closest?.<HTMLImageElement>('[data-lb]');
			if (t && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(t); }
		});
	}
</script>

<style>
	:global([data-lb]) {
		cursor: zoom-in;
	}
	.lb {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;
	}
	.lb::backdrop {
		background: rgb(0 0 0 / 0.8);
	}
	.lb-scroll {
		position: absolute;
		inset: 0;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		outline: none;
	}
	.lb-stage {
		min-height: 100%;
		display: flex;
		padding: 56px 24px;
		box-sizing: border-box;
	}
	.lb-img {
		display: block;
		margin: auto;
		height: auto;
		max-width: 100%;
		cursor: default;
	}
	.lb-btn {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.94);
		color: #0d101a;
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.35);
		transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 200ms ease;
	}
	@media (hover: hover) {
		.lb-btn:hover { background: #fff; }
	}
	.lb-btn:active { transform: scale(0.95); }
	.lb-close {
		position: fixed;
		top: 16px;
		right: 16px;
	}
	.lb-nav {
		position: fixed;
		display: flex;
		gap: 12px;
	}
	.lb-nav[hidden] { display: none; }
	.lb-nav[data-pos='side'] {
		top: 50%;
		transform: translateY(-50%);
	}
	.lb-nav[data-pos='corner'],
	.lb-nav[data-pos='phone'] {
		right: 24px;
		bottom: 24px;
	}
	@media (max-width: 639px) {
		.lb-stage { padding: 0; }
		.lb-nav[data-pos='phone'] { right: 16px; bottom: 16px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.lb-btn { transition: none; }
	}
</style>
