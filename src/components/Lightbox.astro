---
import { cld, FULL, FULL_TALL, SQUARE, isMobileShot, landscapeSrcset } from '../lib/cloudinary';

interface Props {
	images: string[];
	title: string;
}

const { images, title } = Astro.props;
---

<div id="lightbox" class="fixed inset-0 z-[100] hidden opacity-0 transition-opacity duration-200">
	<div id="lightbox-backdrop" class="absolute inset-0 bg-black/90"></div>

	<button
		id="lightbox-close"
		type="button"
		aria-label="Close"
		class="absolute right-4 top-4 z-20 flex h-11 w-11 items-center justify-center rounded-full bg-white text-ink shadow-lg transition-transform hover:scale-105"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>

	<button
		id="lightbox-zoom"
		type="button"
		aria-label="Toggle zoom (100% / fit)"
		class="absolute right-4 top-[68px] z-20 hidden h-11 w-11 items-center justify-center rounded-full bg-white text-ink shadow-lg transition-transform hover:scale-105"
	>
		<svg id="lightbox-zoom-in-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="M21 21l-4.35-4.35M11 8v6M8 11h6"></path>
		</svg>
		<svg id="lightbox-zoom-out-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="M21 21l-4.35-4.35M8 11h6"></path>
		</svg>
	</button>

	<div class="relative flex h-full w-full flex-col sm:flex-row">
		<div id="lightbox-stage" class="group relative flex flex-1 items-center justify-center overflow-hidden p-4 pt-16 sm:p-10">
			<button
				id="lightbox-prev"
				type="button"
				aria-label="Previous image"
				class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-2 opacity-0 transition-opacity duration-200 group-hover:opacity-100 sm:left-4"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 18l-6-6 6-6"></path>
				</svg>
			</button>

			<div id="lightbox-image-wrap" class="flex h-full w-full items-center justify-center"></div>

			<button
				id="lightbox-next"
				type="button"
				aria-label="Next image"
				class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-2 opacity-0 transition-opacity duration-200 group-hover:opacity-100 sm:right-4"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 18l6-6-6-6"></path>
				</svg>
			</button>
		</div>

		<div id="lightbox-thumbs" class="hidden w-28 shrink-0 flex-col gap-2 overflow-y-auto p-4 sm:flex">
			{
				images.map((url, i) => (
					<button type="button" data-index={i} class="lightbox-thumb shrink-0 overflow-hidden rounded-sm border-2 border-transparent">
						<img src={cld(url, SQUARE)} alt="" loading="lazy" class="h-20 w-full object-cover object-top" />
					</button>
				))
			}
		</div>
	</div>

	<p id="lightbox-counter" class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 text-sm font-medium text-white/80"></p>
</div>

<style>
	#lightbox.lightbox-open {
		opacity: 1;
	}
</style>

<script
	define:vars={{
		items: images.map((url) => ({
			full: cld(url, isMobileShot(url) ? FULL_TALL : FULL),
			srcset: isMobileShot(url) ? null : landscapeSrcset(url),
			tall: isMobileShot(url),
		})),
		title,
	}}
>
	const lightbox = document.getElementById('lightbox');
	const backdrop = document.getElementById('lightbox-backdrop');
	const closeBtn = document.getElementById('lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');
	const zoomBtn = document.getElementById('lightbox-zoom');
	const zoomInIcon = document.getElementById('lightbox-zoom-in-icon');
	const zoomOutIcon = document.getElementById('lightbox-zoom-out-icon');
	const imageWrap = document.getElementById('lightbox-image-wrap');
	const counter = document.getElementById('lightbox-counter');
	const thumbButtons = Array.from(document.querySelectorAll('.lightbox-thumb'));

	let currentIndex = 0;
	let zoomed = false;

	function render() {
		const item = items[currentIndex];
		imageWrap.innerHTML = '';
		// Reset zoom whenever we navigate to a new image.
		zoomed = false;
		syncZoomIcon();

		const img = document.createElement('img');
		img.src = item.full;
		if (item.srcset) {
			img.srcset = item.srcset;
			// Lightbox stage caps at ~1200px CSS wide on desktop (max-w-[1200px]
			// centered inside the padded stage). The browser picks a source from
			// srcset based on this hint * DPR — 2K@1x picks 1200w, 4K/retina
			// picks 2400w or 3200w, and a 1080p phone picks a smaller one.
			img.sizes = '(min-width: 1280px) 1200px, 100vw';
		}
		img.alt = title;

		if (item.tall) {
			// Long screenshot: scroll the image itself rather than shrinking it
			// to fit — object-contain would make a tall phone shot tiny and
			// unreadable. Zoom button (top-right) toggles between fit-width and
			// 2x actual size so a mobile design detail can be inspected close-up.
			const scrollWrap = document.createElement('div');
			scrollWrap.className = 'lightbox-scroll-wrap flex max-h-full w-full justify-center overflow-auto sm:w-auto';
			img.className = 'lightbox-tall-img w-full max-w-full sm:w-auto';
			scrollWrap.appendChild(img);
			imageWrap.appendChild(scrollWrap);
			zoomBtn.classList.remove('hidden');
			zoomBtn.classList.add('flex');
		} else {
			img.className = 'max-h-full max-w-full object-contain';
			imageWrap.appendChild(img);
			zoomBtn.classList.add('hidden');
			zoomBtn.classList.remove('flex');
		}

		counter.textContent = `${currentIndex + 1} / ${items.length}`;
		thumbButtons.forEach((btn, i) => {
			btn.classList.toggle('border-accent', i === currentIndex);
			btn.classList.toggle('border-transparent', i !== currentIndex);
		});
		thumbButtons[currentIndex]?.scrollIntoView({ block: 'nearest' });
	}

	function syncZoomIcon() {
		zoomInIcon?.classList.toggle('hidden', zoomed);
		zoomOutIcon?.classList.toggle('hidden', !zoomed);
	}

	function toggleZoom() {
		zoomed = !zoomed;
		const scrollWrap = imageWrap.querySelector('.lightbox-scroll-wrap');
		const img = imageWrap.querySelector('.lightbox-tall-img');
		if (!scrollWrap || !img) return;
		if (zoomed) {
			// Actual-size mode: 2x the fit-width so a mobile design is legible
			// on a 2K+ screen. Both-axis scroll enabled via overflow-auto on the
			// wrap. sm:w-auto is dropped to force w-full * 2 = double width.
			img.classList.remove('sm:w-auto');
			img.classList.add('scale-[2]', 'origin-top-left');
			scrollWrap.classList.remove('sm:w-auto');
			scrollWrap.classList.add('w-full');
		} else {
			img.classList.remove('scale-[2]', 'origin-top-left');
			img.classList.add('sm:w-auto');
			scrollWrap.classList.add('sm:w-auto');
		}
		syncZoomIcon();
	}

	function open(index) {
		currentIndex = index;
		render();
		lightbox.classList.remove('hidden');
		requestAnimationFrame(() => lightbox.classList.add('lightbox-open'));
		document.body.style.overflow = 'hidden';
	}

	function close() {
		lightbox.classList.remove('lightbox-open');
		document.body.style.overflow = '';
		setTimeout(() => lightbox.classList.add('hidden'), 200);
	}

	function next() {
		currentIndex = (currentIndex + 1) % items.length;
		render();
	}

	function prev() {
		currentIndex = (currentIndex - 1 + items.length) % items.length;
		render();
	}

	closeBtn.addEventListener('click', close);
	backdrop.addEventListener('click', close);
	nextBtn.addEventListener('click', next);
	prevBtn.addEventListener('click', prev);
	zoomBtn.addEventListener('click', toggleZoom);
	thumbButtons.forEach((btn, i) => btn.addEventListener('click', () => { currentIndex = i; render(); }));

	document.addEventListener('keydown', (event) => {
		if (lightbox.classList.contains('hidden')) return;
		if (event.key === 'Escape') close();
		if (event.key === 'ArrowRight') next();
		if (event.key === 'ArrowLeft') prev();
	});

	let touchStartX = 0;
	lightbox.addEventListener('touchstart', (event) => { touchStartX = event.touches[0].clientX; }, { passive: true });
	lightbox.addEventListener(
		'touchend',
		(event) => {
			const dx = event.changedTouches[0].clientX - touchStartX;
			if (Math.abs(dx) > 50) {
				dx > 0 ? prev() : next();
			}
		},
		{ passive: true }
	);

	document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
		trigger.addEventListener('click', () => open(Number(trigger.dataset.lightboxTrigger)));
	});
</script>
