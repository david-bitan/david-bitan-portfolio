---
import { testimonials } from '../data/testimonials';

// Home: the three strongest recommendations as verbatim excerpts; the full
// set (all of them, complete) lives on /about#recommendations.
const featured = testimonials.filter((t) => t.featured);
---

<section id="testimonials" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pb-20 sm:pb-28 lg:px-0" data-reveal>
	<div class="mb-10">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Recommendations</p>
		<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">What colleagues say</h2>
	</div>

	<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
		{
			featured.map((t) => (
				<figure class="flex flex-col rounded-md bg-card p-6 sm:p-7">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 text-accent" fill="currentColor">
						<path d="M9.5 6C6.5 6.6 4 9.3 4 13v5h6v-6H7c.2-2 1.4-3.4 3.2-3.9L9.5 6Zm10 0c-3 .6-5.5 3.3-5.5 7v5h6v-6h-3c.2-2 1.4-3.4 3.2-3.9L19.5 6Z" />
					</svg>
					<blockquote class="mt-4 flex-1 leading-relaxed text-ink">
						<p>“{t.excerpt}”</p>
					</blockquote>
					<figcaption class="mt-6 border-t border-ink/10 pt-4">
						<p class="font-semibold">{t.name}</p>
						<p class="mt-0.5 text-sm text-muted">{t.role}</p>
					</figcaption>
				</figure>
			))
		}
	</div>

	<a href="/about#recommendations" class="mt-8 inline-block text-sm font-semibold text-accent-text hover:underline">
		Read all {testimonials.length} recommendations →
	</a>
</section>
