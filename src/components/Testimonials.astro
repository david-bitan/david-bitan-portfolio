---
import { testimonials } from '../data/testimonials';
import RecByline from './RecByline.astro';

// Home: the three strongest recommendations as verbatim excerpts; the full
// set (all of them, complete) lives on /about#recommendations.
const featured = testimonials.filter((t) => t.featured);
---

<section id="testimonials" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 min-[1248px]:px-0" data-reveal>
	<div class="mb-title">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Recommendations</p>
		<h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">What colleagues say</h2>
	</div>

	<div class="gap-cards grid grid-cols-1 md:grid-cols-3">
		{
			featured.map((t) => (
				<figure class="row-span-2 grid grid-rows-subgrid gap-0 rounded-md bg-card p-card">
					{/* Two rows shared by the cards of a line (subgrid): quote, then author.
					    The author block and its separator sit at the same height in every card. */}
					<div>
						<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 text-accent" fill="currentColor">
							<path d="M9.5 6C6.5 6.6 4 9.3 4 13v5h6v-6H7c.2-2 1.4-3.4 3.2-3.9L9.5 6Zm10 0c-3 .6-5.5 3.3-5.5 7v5h6v-6h-3c.2-2 1.4-3.4 3.2-3.9L19.5 6Z" />
						</svg>
						<blockquote class="mt-4 flex-1 text-[14px] leading-relaxed text-ink sm:text-[15px]">
							<p>“{t.excerpt}”</p>
						</blockquote>
					</div>
					<RecByline t={t} />
				</figure>
			))
		}
	</div>

	{/* Phones: centred in the page (étape 9, B4). */}
	<div class="mt-btn text-center sm:text-left">
	{/* Étape 12, 2: leads to the full set on the About page (on the site). */}
	{/* Étape 15, S52: the same button as « More about me → ». */}
	<a href="/about#recommendations" class="btn-secondary inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-pill px-6 text-sm font-semibold">
		Read the full recommendations&nbsp;<span class="arr arr-x" aria-hidden="true">→</span>
	</a>
	</div>
</section>
