---
/**
 * AI Lab — home section rendered after Selected Work. Grid of
 * self-initiated AI products built end-to-end (brands are invented; each
 * demo says so in its own footer). Same card size + grid as
 * SelectedWork (4-col) so the section reads as a coherent continuation,
 * with a warm accent eyebrow kept as the distinguishing signal.
 */
import { aiLabProjects } from '../data/aiLabProjects';
---

<section
	id="ai-lab"
	class="mx-auto max-w-[1200px] scroll-mt-24 px-6 min-[1248px]:px-0"
	data-reveal
>
	<div class="mb-title">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Self-initiated</p>
		<h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">AI Lab Work</h2>
		<p class="mt-4 max-w-2xl text-base text-muted sm:text-lg">
			Products I started on my own, then designed and built end to end. Four are working demos with a live AI model (Llama 3.3): Facet, Margin, Otium and APEX Athletic Club, whose AI chatbot is APEX Coach. I built Trattoria Fiori and this portfolio with AI tools.
		</p>
	</div>

	<div class="gap-cards grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
		{
			aiLabProjects.map((project) => (
				<a
					href={project.cardHref ?? `/lab/${project.slug}`}
					class:list={['ai-lab-card group block overflow-hidden rounded-md bg-card', { 'is-portfolio': project.slug === 'portfolio-colophon' }]}
				>
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src={project.thumbnail}
							alt={project.title}
							loading="lazy"
							class="thumb-hover-zoom h-full w-full object-cover object-top"
						/>
					</div>
					<div class="p-4">
						<p class="text-[11px] font-semibold uppercase tracking-widest text-accent-text">
							{/* Étape 15, S62: no « · », a 16 px space instead */}
							{project.eyebrow.split(' · ').map((part, i) => <>{i > 0 && <span class="eb-gap"> </span>}{part}</>)}
						</p>
						<h3 class="mt-1.5 text-base font-bold tracking-tight">{project.title}</h3>
						<p class="mt-1.5 line-clamp-2 text-sm text-muted">{project.shortDesc}</p>
					</div>
				</a>
			))
		}
	</div>
</section>
