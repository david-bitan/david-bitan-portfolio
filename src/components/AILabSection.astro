---
/**
 * AI Lab — home section rendered after Selected Work. Grid of fictional
 * design experiments built end-to-end. Same card size + grid as
 * SelectedWork (4-col) so the section reads as a coherent continuation,
 * with a warm accent eyebrow kept as the distinguishing signal.
 */
import { aiLabProjects } from '../data/aiLabProjects';
---

<section
	id="ai-lab"
	class="mx-auto max-w-[1200px] scroll-mt-24 px-6 py-20 sm:py-28 lg:px-0"
	data-reveal
>
	<div class="mb-12">
		<p class="text-sm font-semibold uppercase tracking-widest text-muted">Experiments</p>
		<h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">AI Lab</h2>
		<p class="mt-4 max-w-2xl text-base text-muted sm:text-lg">
			Fictional mini-projects designed and built end-to-end, with AI as a sparring
			partner. Each one is a self-contained brief — a fake brand, a fake product, a
			real live demo. A way to keep the design muscle loose between client work.
		</p>
	</div>

	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			aiLabProjects.map((project) => (
				<a
					href={`/lab/${project.slug}`}
					class="ai-lab-card group block overflow-hidden rounded-md bg-card"
				>
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src={project.thumbnail}
							alt={project.title}
							loading="lazy"
							class="thumb-hover-zoom h-full w-full object-cover object-top"
						/>
					</div>
					<div class="p-4">
						<p class="text-[11px] font-semibold uppercase tracking-widest text-accent">
							{project.eyebrow}
						</p>
						<h3 class="mt-1.5 text-base font-bold tracking-tight">{project.title}</h3>
						<p class="mt-1.5 line-clamp-2 text-sm text-muted">{project.shortDesc}</p>
					</div>
				</a>
			))
		}
	</div>
</section>
