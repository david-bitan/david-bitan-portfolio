---
const email = 'advance26@gmail.com';
const phone = '+972 54-924-8520';
const linkedinUrl = 'https://www.linkedin.com/in/david-bitan-81a12552/';
const year = new Date().getFullYear();
---

<footer class="bg-footer-bg px-6 py-24 text-center sm:py-32">
	<h2 class="text-4xl font-extrabold tracking-tight text-footer-ink sm:text-6xl">Let's build something.</h2>

	{/* Mobile: stacks vertically (email / phone / location on their own
		lines) so the phone number doesn't clip off-screen on 375px width.
		sm+ : single-line inline with `·` separators (previous behaviour). */}
	<p class="mt-10 flex flex-col items-center gap-y-2 text-sm font-medium text-footer-muted sm:block">
		<a href={`mailto:${email}`} class="text-accent hover:underline">{email}</a>
		<span class="mx-3 hidden sm:inline">·</span>
		<a href={`tel:+${phone.replace(/\D/g, '')}`} class="text-accent hover:underline">{phone}</a>
		<span class="mx-3 hidden sm:inline">·</span>
		<a href={linkedinUrl} target="_blank" rel="noopener" class="text-accent hover:underline">LinkedIn</a>
		<span class="mx-3 hidden sm:inline">·</span>
		<span class="text-footer-ink">Israel · Open to remote / hybrid</span>
	</p>

	<p class="mt-10 text-xs text-footer-muted">© {year} David Bitan. All rights reserved.</p>

	{/* Micro-mention: subtle nod to the AI-native workflow this site is built with.
		Links to /colophon for the full breakdown. */}
	<p class="mt-3 text-xs text-footer-muted">
		Designed and built with Astro, Tailwind CSS, and Claude ·
		<a href="/colophon" class="text-accent hover:underline">Colophon</a>
	</p>
</footer>
