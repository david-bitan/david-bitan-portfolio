---
// hideCta: /contact already opens with its own headline, so the closing
// "Let’s talk product design." would repeat it there (2026-11-12 brief).
// id="contact": kept as an anchor for old links (/#contact); the menu’s Contact
// opens the /contact page since étape 9 (F1).
// Étape 11, 13: a real footer, same elements, better sorted.
// Étape 12, 13-15 (redone): a « Pages » block (Lucide icons) and an identity
// block (name, place on one line, e-mail, phone, LinkedIn, the common
// « Download CV » block), then the bottom line under a hairline.
//   Phones: Pages (2 columns) / hairline / identity / hairline / bottom line.
//   Desktop: Pages left, identity right, a vertical hairline between them,
//   both titles on the same line.
// Étape 13, 5-7: + Testimonials, no "Pages" title, contact icons in white.
//   Phones: pages (2 columns), contact + CV, place, bottom line.
//   Desktop (lg): identity + place / pages / contact + CV on one row, then
//   the bottom line. Links in white at 70 %, full white on hover; orange only
//   for the keyboard focus ring.
import { SITE_VERSION } from '../data/siteVersion';
import Icon from './Icon.astro';
import DownloadCV from './DownloadCV.astro';
const { hideCta = false } = Astro.props;
// on /contact itself the address leads to the form below
const emailHref = Astro.url.pathname.replace(/\/$/, '') === '/contact' ? '#contact-form' : '/contact';
const email = 'advance26@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/david-bitan';
const year = new Date().getFullYear();
const phone = '+972 54-924-8520';
const phoneHref = 'tel:+972549248520';
const pages = [
	['Work', '/#work', 'briefcase'],
	['AI Lab Work', '/#ai-lab', 'flask-conical'], // étape 13, 14
	['Testimonials', '/#testimonials', 'quote'], // étape 13, 5: same target as the top menu
	['About me', '/about', 'user'],
	['Craft', '/craft', 'palette'],
	['Contact', '/contact', 'send'],
];
---

<footer id="contact" class:list={['site-footer scroll-mt-20 bg-footer-bg px-6', hideCta ? 'pt-12 pb-8 sm:pt-14' : 'pt-16 pb-8 sm:pt-20']}>
	<div class="mx-auto max-w-[1200px]">
		{!hideCta && <h2 class="text-4xl font-extrabold tracking-tight text-footer-ink sm:text-6xl">Let’s talk product design.</h2>}

		<div class:list={['grid grid-cols-1 lg:grid-cols-[16rem_1px_minmax(0,1fr)] lg:gap-x-16', hideCta ? 'mt-0' : 'mt-10 sm:mt-12']}>
			{/* Étape 13, 6: no visible "Pages" title any more. */}
			<nav aria-label="Pages">
				<ul class="-mt-2.5 grid grid-cols-2 gap-x-6 text-sm font-medium lg:grid-cols-1">
					{pages.map(([label, href, icon]) => (
						<li>
							<a href={href} class="footer-link inline-flex min-h-11 items-center gap-2.5">
								<Icon name={icon} class="size-4 shrink-0" />
								{label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{/* the same very fine line as above the bottom line */}
			<div class="my-6 h-px bg-white/10 lg:my-0 lg:h-auto lg:w-px" aria-hidden="true"></div>

			<div>
				<p class="footer-title">David Bitan</p>
				<p class="mt-1 text-xs text-footer-muted">Ashkelon, Israel<span class="mx-1.5" aria-hidden="true">·</span>Hybrid or remote<span class="mx-1.5" aria-hidden="true">·</span>Tel Aviv area</p>
				<ul class="mt-2 flex flex-col items-start text-sm font-medium">
					<li>
						<a href={emailHref} class="footer-accent inline-flex min-h-11 items-center gap-2.5">
							<Icon name="mail" class="footer-icon size-4 shrink-0" />{email}
						</a>
					</li>
					<li>
						<a href={phoneHref} class="footer-accent inline-flex min-h-11 items-center gap-2.5">
							<Icon name="phone" class="footer-icon size-4 shrink-0" />{phone}
						</a>
					</li>
					<li>
						<a href={linkedinUrl} target="_blank" rel="noopener" class="footer-accent inline-flex min-h-11 items-center gap-2.5">
							<Icon name="linkedin" class="footer-icon size-4 shrink-0" /><span>LinkedIn<span class="ext-arr" aria-hidden="true">↗</span></span><span class="sr-only"> (opens in a new tab)</span>
						</a>
					</li>
					<li class="mt-1.5"><DownloadCV tone="footer" /></li>
				</ul>
			</div>
		</div>

		{/* bottom line: copyright · Colophon · release marker (+1 at every release) */}
		<div class="mt-6 flex flex-wrap items-center gap-x-2 border-t border-white/10 pt-4 text-xs text-footer-muted lg:mt-10">
			<span>© {year} David Bitan</span>
			<span aria-hidden="true">·</span>
			<a href="/colophon" class="footer-accent inline-flex min-h-11 items-center">Colophon</a>
			<span aria-hidden="true">·</span>
			<span title="Site version">{SITE_VERSION}</span>
		</div>
	</div>
</footer>

<style>
	.footer-title {
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--color-footer-ink);
	}
	/* page links: white at 70 %, orange on hover */
	.footer-link {
		color: rgb(255 255 255 / 0.7);
		border-radius: 4px;
		transition: color 150ms ease;
	}
	/* contact links: orange (5.2:1 on #151A28); hover like the CV links */
	.footer-accent {
		color: #f25c24;
		border-radius: 4px;
		transition: opacity 150ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.footer-link:hover {
			color: #f25c24;
		}
		.footer-accent:hover {
			opacity: 0.8;
		}
	}
	/* étape 13, 7: e-mail, phone and LinkedIn icons in white (70 %, like the page icons) */
	:global(.footer-icon) {
		color: rgb(255 255 255 / 0.7);
	}
	.footer-link:focus-visible,
	.footer-accent:focus-visible {
		outline: 2px solid #f25c24;
		outline-offset: 2px;
	}
</style>
