---
// hideCta: /contact already opens with its own headline, so the closing
// "Let's talk product design." would repeat it there (2026-11-12 brief).
// id="contact": kept as an anchor for old links (/#contact); the menu's Contact
// opens the /contact page since étape 9 (F1).
// Étape 11, 13: a real footer, same elements, better sorted.
//   Phones: pages (2 columns), contact + CV, place, bottom line.
//   Desktop (lg): identity + place / pages / contact + CV on one row, then
//   the bottom line. Links in white at 70 %, full white on hover; orange only
//   for the keyboard focus ring.
import { SITE_VERSION } from '../data/siteVersion';
const { hideCta = false } = Astro.props;
// on /contact itself the address leads to the form below
const emailHref = Astro.url.pathname.replace(/\/$/, '') === '/contact' ? '#contact-form' : '/contact';
const email = 'advance26@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/david-bitan';
const year = new Date().getFullYear();
const pages = [['Work', '/#work'], ['AI Lab', '/#ai-lab'], ['About me', '/about'], ['Craft', '/craft'], ['Contact', '/contact']];
---

<footer id="contact" class:list={['site-footer scroll-mt-20 bg-footer-bg px-6', hideCta ? 'pt-12 pb-8 sm:pt-14' : 'pt-16 pb-8 sm:pt-20']}>
	<div class="mx-auto max-w-[1200px]">
		{!hideCta && <h2 class="text-4xl font-extrabold tracking-tight text-footer-ink sm:text-6xl">Let's talk product design.</h2>}

		<div class:list={['grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-12', hideCta ? 'mt-0' : 'mt-10 sm:mt-12']}>
			<nav aria-label="Footer" class="lg:order-2">
				<ul class="grid grid-cols-2 gap-x-6 text-sm font-medium">
					{pages.map(([label, href]) => (
						<li><a href={href} class="footer-link inline-flex min-h-11 items-center">{label}</a></li>
					))}
				</ul>
			</nav>

			<div class="flex flex-col items-start text-sm font-medium lg:order-3">
				<a href={emailHref} class="footer-link inline-flex min-h-11 items-center">{email}</a>
				<a href={linkedinUrl} target="_blank" rel="noopener" class="footer-link inline-flex min-h-11 items-center">LinkedIn&nbsp;<span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
				<p class="text-footer-link">
					Download CV:
					<a href="/cv/CV-David-Bitan.pdf" download class="footer-link inline-flex min-h-11 min-w-11 items-center justify-center px-1 underline underline-offset-4">PDF</a>
					<span aria-hidden="true">·</span>
					<a href="/cv/CV-David-Bitan.docx" download class="footer-link inline-flex min-h-11 min-w-11 items-center justify-center px-1 underline underline-offset-4">DOCX</a>
				</p>
			</div>
			{/* identity + place (desktop: first column; phones: last, same order in the code) */}
			<div class="lg:order-1">
				<p class="hidden text-lg font-extrabold tracking-tight text-footer-ink lg:block">David Bitan</p>
				<p class="text-sm text-footer-link lg:mt-3">Ashkelon, Israel<span class="mx-2" aria-hidden="true">·</span>Hybrid or remote<span class="mx-2" aria-hidden="true">·</span><span class="whitespace-nowrap">Tel Aviv area</span></p>
			</div>
		</div>

		{/* bottom line: copyright · Colophon · release marker (+1 at every release) */}
		<div class="mt-8 flex flex-wrap items-center gap-x-2 border-t border-white/10 pt-4 text-xs text-footer-muted">
			<span>© {year} David Bitan</span>
			<span aria-hidden="true">·</span>
			<a href="/colophon" class="footer-link inline-flex min-h-11 items-center">Colophon</a>
			<span aria-hidden="true">·</span>
			<span title="Site version">{SITE_VERSION}</span>
		</div>
	</div>
</footer>

<style>
	.text-footer-link {
		color: rgb(255 255 255 / 0.7); /* 8.9:1 on #151A28 */
	}
	.footer-link {
		color: rgb(255 255 255 / 0.7);
		border-radius: 4px;
		transition: color 150ms ease;
	}
	.footer-link:hover {
		color: #ffffff;
	}
	.footer-link:focus-visible {
		outline: 2px solid #f25c24;
		outline-offset: 2px;
	}
</style>
