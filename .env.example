# Cloudinary credentials — required by scripts/upload-pngs.js.
# Get them at https://console.cloudinary.com → Settings → API Keys
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

CLOUDINARY_CLOUD_NAME=akael
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Formspree — POST endpoint for the /contact form. Create a new form at
# https://formspree.io (free tier = 50 submissions/month) and paste its ID
# below (the last segment of its endpoint URL, e.g. "xnqeyzpk").
# PUBLIC_ prefix is REQUIRED — Astro only exposes vars with this prefix to
# the client-side script that does the POST. Leave empty to fall back to a
# mailto: link (opens the visitor's email client with the message pre-filled).
PUBLIC_FORMSPREE_ID=

# Umami cloud — privacy-friendly analytics, no cookie banner, ~2 KB script.
# Create a website at https://cloud.umami.is (free tier: 100k events/month),
# then paste the "Website ID" (UUID shown in Settings → Websites → your site).
# Leave empty to disable analytics entirely — the script tag is only rendered
# when this variable has a value, so no third-party call is made without it.
PUBLIC_UMAMI_WEBSITE_ID=
